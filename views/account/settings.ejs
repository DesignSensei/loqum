<!-- views/account/settings.ejs -->

<input type="hidden" id="accountSettingsCsrfToken" value="<%= csrfToken %>" />

<!-- Profile -->
<div class="card mb-5 mb-xl-10">
  <div class="card-header border-0">
    <div class="card-title m-0">
      <h3 class="fw-bold m-0">Profile</h3>
    </div>

    <div class="card-toolbar">
      <button
        type="button"
        class="btn btn-light-primary fw-bold"
        data-bs-toggle="modal"
        data-bs-target="#editProfileModal"
      >
        Edit Profile
      </button>
    </div>
  </div>

  <div class="card-body border-top p-9">
    <div class="d-flex flex-column flex-md-row align-items-start gap-7">
      <div class="flex-shrink-0 align-self-start">
        <button
          type="button"
          class="border-0 bg-transparent p-0 position-relative d-inline-block cursor-pointer"
          data-bs-toggle="modal"
          data-bs-target="#updateProfilePhotoModal"
          title="Change profile photo"
        >
          <div class="symbol symbol-100px">
            <% if (accountSettingsView.profileView.photo) { %>
            <img
              src="<%= accountSettingsView.profileView.photo %>"
              alt="<%= accountSettingsView.profileView.displayName %>"
              referrerpolicy="no-referrer"
            />
            <% } else { %>
            <div class="symbol-label bg-light-primary text-primary fw-bold fs-1">
              <%= userInitials || "U" %>
            </div>
            <% } %>
          </div>

          <span
            class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center w-30px h-30px border border-3 border-white"
          >
            <i class="ki-outline ki-pencil fs-5 text-white"></i>
          </span>
        </button>
      </div>

      <div class="flex-grow-1">
        <h4 class="fw-bold text-gray-900 mb-1">
          <%= accountSettingsView.profileView.displayName %>
        </h4>

        <div class="text-muted fs-6 mb-6">
          Your personal account summary and contact information.
        </div>

        <div class="row g-5">
          <div class="col-md-6">
            <div class="text-muted fs-7 fw-semibold mb-1">Email Address</div>
            <div class="fw-bold text-gray-900">
              <%= accountSettingsView.profileView.email || "-" %>
            </div>
          </div>

          <div class="col-md-6">
            <div class="text-muted fs-7 fw-semibold mb-1">Phone Number</div>
            <div class="fw-bold text-gray-900">
              <% if (accountSettingsView.profileView.phoneNumber) { %> <%=
              accountSettingsView.profileView.phoneCode %> <%=
              accountSettingsView.profileView.phoneNumber %> <% } else { %> - <% } %>
            </div>
          </div>

          <div class="col-md-4">
            <div class="text-muted fs-7 fw-semibold mb-1">Member Since</div>
            <div class="fw-bold text-gray-900">
              <%= accountSettingsView.profileView.memberSinceLabel %>
            </div>
          </div>

          <div class="col-md-4">
            <div class="text-muted fs-7 fw-semibold mb-1">Role</div>
            <span class="badge badge-light-primary fw-bold">
              <%= accountSettingsView.profileView.roleLabel %>
            </span>
          </div>

          <div class="col-md-4">
            <div class="text-muted fs-7 fw-semibold mb-1">2FA Status</div>

            <% if (accountSettingsView.profileView.twoFactorEnabled) { %>
            <span class="badge badge-light-success fw-bold">Enabled</span>
            <% } else { %>
            <span class="badge badge-light-secondary fw-bold">Disabled</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Security -->
<div class="card mb-5 mb-xl-10">
  <div class="card-header border-0">
    <div class="card-title m-0">
      <h3 class="fw-bold m-0">Security</h3>
    </div>
  </div>

  <div class="card-body border-top p-9">
    <div
      class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6 mb-9"
    >
      <i class="ki-duotone ki-shield-tick fs-2tx text-primary me-4">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      <div class="d-flex flex-stack flex-grow-1">
        <div class="fw-semibold">
          <h4 class="text-gray-900 fw-bold mb-2">Protect your Loqum account</h4>
          <div class="fs-6 text-gray-700">
            Manage login security for
            <strong><%= accountSettingsView.securityView.email %></strong>.
          </div>
        </div>
      </div>
    </div>

    <!-- Email Address -->
    <div
      class="d-flex flex-column flex-md-row align-items-md-center justify-content-between border rounded p-6 mb-6"
    >
      <div class="mb-5 mb-md-0">
        <div class="d-flex align-items-center mb-2">
          <h4 class="fw-bold text-gray-900 mb-0 me-3">Email Address</h4>
          <span class="badge badge-light-success fw-bold">Verified</span>
        </div>

        <div class="text-muted fs-6">
          Your current account email is
          <strong><%= accountSettingsView.securityView.email %></strong>.
        </div>
      </div>

      <div>
        <button
          type="button"
          class="btn btn-light-primary fw-bold"
          data-bs-toggle="modal"
          data-bs-target="#changeEmailModal"
        >
          Change Email
        </button>
      </div>
    </div>

    <!-- Two-Factor Authentication -->
    <div
      class="d-flex flex-column flex-md-row align-items-md-center justify-content-between border rounded p-6 mb-6"
    >
      <div class="mb-5 mb-md-0">
        <div class="d-flex align-items-center mb-2">
          <h4 class="fw-bold text-gray-900 mb-0 me-3">Two-Factor Authentication</h4>

          <% if (accountSettingsView.securityView.twoFactorEnabled) { %>
          <span class="badge badge-light-success fw-bold">Enabled</span>
          <% } else { %>
          <span class="badge badge-light-secondary fw-bold">Disabled</span>
          <% } %>
        </div>

        <div class="text-muted fs-6">
          When enabled, Loqum asks for an OTP during sensitive login flows.
        </div>
      </div>

      <div>
        <% if (accountSettingsView.securityView.twoFactorEnabled) { %>
        <button
          type="button"
          class="btn btn-light-danger fw-bold"
          id="kt_disable_2fa_button"
          data-send-url="<%= accountSettingsView.securityView.sendDisableTwoFactorOtpUrl %>"
          data-disable-url="<%= accountSettingsView.securityView.disableTwoFactorUrl %>"
        >
          Turn off 2FA
        </button>
        <% } else { %>
        <button
          type="button"
          class="btn btn-light-primary fw-bold"
          id="kt_enable_2fa_button"
          data-send-url="<%= accountSettingsView.securityView.sendEnableTwoFactorOtpUrl %>"
          data-enable-url="<%= accountSettingsView.securityView.enableTwoFactorUrl %>"
        >
          Turn on 2FA
        </button>
        <% } %>
      </div>
    </div>

    <!-- Password Management -->
    <div
      class="d-flex flex-column flex-md-row align-items-md-center justify-content-between border rounded p-6 mb-6"
    >
      <div class="mb-5 mb-md-0">
        <div class="d-flex align-items-center mb-2">
          <h4 class="fw-bold text-gray-900 mb-0 me-3">
            <%= accountSettingsView.securityView.passwordTitle %>
          </h4>

          <% if (accountSettingsView.securityView.hasPasswordLogin) { %>
          <span class="badge badge-light-success fw-bold">Enabled</span>
          <% } else { %>
          <span class="badge badge-light-info fw-bold">Managed by Google</span>
          <% } %>
        </div>

        <div class="text-muted fs-6">
          <%= accountSettingsView.securityView.passwordDescription %>
        </div>
      </div>

      <% if (accountSettingsView.securityView.hasPasswordLogin) { %>
      <div>
        <button type="button" class="btn btn-light fw-bold" disabled>Change Password Soon</button>
      </div>
      <% } %>
    </div>

    <!-- Google Login -->
    <div
      class="d-flex flex-column flex-md-row align-items-md-center justify-content-between border rounded p-6 mb-6"
    >
      <div>
        <div class="d-flex align-items-center mb-2">
          <h4 class="fw-bold text-gray-900 mb-0 me-3">Google Login</h4>

          <% if (accountSettingsView.securityView.hasGoogleLogin) { %>
          <span class="badge badge-light-success fw-bold">Connected</span>
          <% } else { %>
          <span class="badge badge-light-secondary fw-bold">Not connected</span>
          <% } %>
        </div>

        <div class="text-muted fs-6">
          Google login status:
          <strong><%= accountSettingsView.securityView.googleLoginStatus %></strong>.
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Preferences -->
<div class="card mb-5 mb-xl-10">
  <div class="card-header border-0">
    <div class="card-title m-0">
      <h3 class="fw-bold m-0">Preferences</h3>
    </div>
  </div>

  <div class="card-body border-top p-9">
    <div class="row g-6">
      <div class="col-md-4">
        <div class="border rounded p-6 h-100">
          <div class="d-flex align-items-center mb-4">
            <i class="ki-duotone ki-notification-bing fs-2 text-primary me-3">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>
            <h4 class="fw-bold text-gray-900 mb-0">Notifications</h4>
          </div>

          <div class="text-muted fs-6 mb-4">
            <%= accountSettingsView.preferencesView.notificationsStatusText %>
          </div>

          <span class="badge badge-light-secondary fw-bold">Coming soon</span>
        </div>
      </div>

      <div class="col-md-4">
        <div class="border rounded p-6 h-100">
          <div class="d-flex align-items-center mb-4">
            <i class="ki-duotone ki-night-day fs-2 text-primary me-3">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
              <span class="path5"></span>
              <span class="path6"></span>
              <span class="path7"></span>
              <span class="path8"></span>
              <span class="path9"></span>
              <span class="path10"></span>
            </i>
            <h4 class="fw-bold text-gray-900 mb-0">Theme</h4>
          </div>

          <div class="text-muted fs-6 mb-4">
            <%= accountSettingsView.preferencesView.themeStatusText %>
          </div>

          <span class="badge badge-light-info fw-bold">
            <%= accountSettingsView.preferencesView.themeLabel || "System default" %>
          </span>
        </div>
      </div>

      <div class="col-md-4">
        <div class="border rounded p-6 h-100">
          <div class="d-flex align-items-center mb-4">
            <i class="ki-duotone ki-abstract-26 fs-2 text-primary me-3">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>
            <h4 class="fw-bold text-gray-900 mb-0">Language</h4>
          </div>

          <div class="text-muted fs-6 mb-4">
            <%= accountSettingsView.preferencesView.languageStatusText %>
          </div>

          <span class="badge badge-light-primary fw-bold">
            <%= accountSettingsView.preferencesView.languageLabel || "English" %>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sessions -->
<div class="card mb-5 mb-xl-10">
  <div class="card-header border-0">
    <div class="card-title m-0">
      <h3 class="fw-bold m-0">Sessions</h3>
    </div>
  </div>

  <div class="card-body border-top p-9">
    <div
      class="d-flex flex-column flex-md-row align-items-md-center justify-content-between border rounded p-6"
    >
      <div class="mb-5 mb-md-0">
        <div class="d-flex align-items-center mb-2">
          <h4 class="fw-bold text-gray-900 mb-0 me-3">
            <%= accountSettingsView.sessionsView.currentSessionLabel %>
          </h4>

          <span class="badge badge-light-success fw-bold">Active</span>
        </div>

        <div class="text-muted fs-6">
          <%= accountSettingsView.sessionsView.activeDevicesStatusText %>
        </div>
      </div>

      <div>
        <button type="button" class="btn btn-light fw-bold" disabled>Manage Devices Soon</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Contact Information Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered mw-650px">
    <div class="modal-content">
      <form
        id="kt_account_profile_form"
        action="<%= accountSettingsView.profileView.updateProfileUrl %>"
        method="POST"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="modal-header">
          <h2 class="fw-bold">Contact Information</h2>

          <button
            type="button"
            class="btn btn-icon btn-sm btn-active-icon-primary"
            data-bs-dismiss="modal"
            aria-label="Close"
          >
            <i class="ki-duotone ki-cross fs-1">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>
          </button>
        </div>

        <div class="modal-body py-10 px-lg-17">
          <div class="row g-6">
            <div class="col-md-6">
              <label class="form-label required">First Name</label>
              <input
                type="text"
                name="firstName"
                class="form-control"
                value="<%= accountSettingsView.profileView.firstName %>"
                autocomplete="given-name"
              />
            </div>

            <div class="col-md-6">
              <label class="form-label required">Last Name</label>
              <input
                type="text"
                name="lastName"
                class="form-control"
                value="<%= accountSettingsView.profileView.lastName %>"
                autocomplete="family-name"
              />
            </div>

            <div class="col-md-4">
              <label class="form-label required">Phone Code</label>
              <select
                id="accountPhoneCodeSelect"
                name="phoneCode"
                class="form-select"
                data-control="select2"
                data-placeholder="Code"
                data-allow-clear="false"
                data-hide-search="false"
              >
                <option></option>
                <option value="+234" selected>🇳🇬 +234 Nigeria</option>
              </select>
            </div>

            <div class="col-md-8">
              <label class="form-label required">Phone Number</label>
              <input
                type="tel"
                name="phoneNumber"
                class="form-control"
                value="<%= accountSettingsView.profileView.phoneNumber %>"
                placeholder="08012345678"
                autocomplete="tel"
              />
            </div>
          </div>
        </div>

        <div class="modal-footer flex-center">
          <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

          <button type="submit" class="btn btn-primary" id="kt_account_profile_submit">
            <span class="indicator-label">Save Contact Information</span>
            <span class="indicator-progress">
              Please wait...
              <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Update Profile Photo Modal -->
<div class="modal fade" id="updateProfilePhotoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered mw-500px">
    <div class="modal-content">
      <form
        id="kt_account_photo_form"
        action="<%= accountSettingsView.profileView.updatePhotoUrl %>"
        method="POST"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="modal-header">
          <h2 class="fw-bold">Change Profile Photo</h2>

          <button
            type="button"
            class="btn btn-icon btn-sm btn-active-icon-primary"
            data-bs-dismiss="modal"
            aria-label="Close"
          >
            <i class="ki-duotone ki-cross fs-1">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>
          </button>
        </div>

        <div class="modal-body py-10 px-lg-17">
          <div class="text-center mb-8">
            <div class="symbol symbol-100px mx-auto mb-4">
              <% if (accountSettingsView.profileView.photo) { %>
              <img
                src="<%= accountSettingsView.profileView.photo %>"
                alt="<%= accountSettingsView.profileView.displayName %>"
                referrerpolicy="no-referrer"
              />
              <% } else { %>
              <div class="symbol-label bg-light-primary text-primary fw-bold fs-1">
                <%= userInitials || "U" %>
              </div>
              <% } %>
            </div>

            <div class="text-muted fs-7">
              Upload a clear JPG, PNG, or WEBP image. Maximum size: 2MB.
            </div>
          </div>

          <div class="fv-row">
            <label class="form-label required">Profile Photo</label>
            <input
              type="file"
              name="photo"
              id="accountPhotoInput"
              class="form-control"
              accept="image/jpeg,image/png,image/webp"
            />
          </div>
        </div>

        <div class="modal-footer flex-center">
          <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

          <button type="submit" class="btn btn-primary" id="kt_account_photo_submit">
            <span class="indicator-label">Upload Photo</span>
            <span class="indicator-progress">
              Please wait...
              <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Change Email Modal -->
<div class="modal fade" id="changeEmailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered mw-550px">
    <div class="modal-content">
      <form
        id="kt_change_email_form"
        method="POST"
        data-send-url="<%= accountSettingsView.securityView.sendChangeEmailOtpUrl %>"
        data-confirm-url="<%= accountSettingsView.securityView.confirmEmailChangeUrl %>"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="modal-header">
          <h2 class="fw-bold">Change Email</h2>

          <button
            type="button"
            class="btn btn-icon btn-sm btn-active-icon-primary"
            data-bs-dismiss="modal"
            aria-label="Close"
          >
            <i class="ki-duotone ki-cross fs-1">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>
          </button>
        </div>

        <div class="modal-body py-10 px-lg-17">
          <div
            class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-6 mb-8"
          >
            <i class="ki-duotone ki-information-5 fs-2tx text-warning me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <div class="fw-semibold text-gray-700">
              Email changes require OTP verification. We will send the OTP to your new email
              address.
            </div>
          </div>

          <div class="fv-row mb-7">
            <label class="form-label">Current Email</label>
            <input
              type="email"
              class="form-control bg-light"
              value="<%= accountSettingsView.securityView.email %>"
              readonly
            />
          </div>

          <div class="fv-row">
            <label class="form-label required">New Email Address</label>
            <input
              type="email"
              name="newEmail"
              class="form-control"
              placeholder="Enter new email address"
              autocomplete="email"
            />
          </div>
        </div>

        <div class="modal-footer flex-center">
          <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

          <button type="submit" class="btn btn-primary" id="kt_change_email_submit">
            <span class="indicator-label">Send OTP</span>
            <span class="indicator-progress">
              Please wait...
              <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
