<div class="card card-flush mb-8">
    <div class="card-header">
      <div class="card-title"><h3 class="fw-bold">Search and Filters</h3></div>
    </div>

    <div class="card-body">
      <form method="GET" action="/admin/financial-obligations">

        <div class="row g-5">

          <div class="col-12 col-xl-6">
            <label class="form-label fw-semibold" for="filterSearch">Search</label>
            <input id="filterSearch" name="q" type="search" class="form-control"
              maxlength="200" value="<%= filters.q %>"
              placeholder="Exact payment reference, obligation ID or owner ID" />
          </div>

          <% filterOptions.forEach(function(filter) { %>
            <div class="col-12 col-sm-6 col-xl-3">
              <label class="form-label fw-semibold" for="filter-<%= filter.name %>">
                <%= filter.label %>
              </label>

              <select id="filter-<%= filter.name %>"
                      name="<%= filter.name %>" class="form-select">

                <% filter.options.forEach(function(option) { %>
                  <option value="<%= option.value %>"
                    <% if (option.selected) { %>selected<% } %>>
                    <%= option.label %>
                  </option>
                <% }); %>

              </select>
            </div>
          <% }); %>

          <div class="col-12 col-sm-6 col-xl-3">
            <label for="filterFrom" class="form-label">From (UTC)</label>
            <input id="filterFrom" type="date" name="from"
              value="<%= filters.from %>" class="form-control" />
          </div>

          <div class="col-12 col-sm-6 col-xl-3">
            <label for="filterTo" class="form-label">To (UTC)</label>
            <input id="filterTo" type="date" name="to"
              value="<%= filters.to %>" class="form-control" />
          </div>

        </div>

        <div class="d-flex gap-3 mt-6">
          <button type="submit" class="btn btn-primary">Apply Filters</button>
          <a href="/admin/financial-obligations" class="btn btn-light">Reset</a>
        </div>

      </form>
    </div>
  </div>