<div class="text-muted fs-7 mb-5">
    Summary totals cover the selected provider environment and currency,
    independently of other table filters.
  </div>

  <% summary.forEach(function(group) { %>
    <h4 class="fw-bold mb-4"><%= group.currency %> Financial Summary</h4>

    <div class="row g-5 mb-8">
      <% group.cards.forEach(function(card) { %>
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card card-flush h-100">
            <div class="card-body">
              <div class="text-muted fw-semibold mb-3"><%= card.title %></div>
              <div class="fw-bold fs-3 mb-2 text-break"><%= card.amount %></div>
              <div class="text-muted"><%= card.count %> obligations</div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% }); %>

  <% if (!summary.length) { %>
    <div class="alert alert-light mb-8">No obligations recorded for this environment.</div>
  <% } %>