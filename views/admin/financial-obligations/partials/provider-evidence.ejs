<div id="evidence" class="tab-pane fade">
      <div class="card card-flush mb-6">
        <div class="card-body">
          <h3 class="fw-bold mb-5">Original Financial Records</h3>
          <dl class="row g-3">
            <% originalRecords.forEach(function(field) { %>
            <dt class="col-md-4 text-muted"><%= field.title %></dt>
            <dd class="col-md-8 text-break"><%= field.value %></dd>
            <% }); %>
          </dl>
        </div>
      </div>

      <%- include("./settlement-evidence") %>
    </div>