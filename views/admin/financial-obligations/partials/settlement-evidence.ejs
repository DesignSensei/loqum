<div class="card card-flush">
        <div class="card-body">
          <h3 class="fw-bold mb-5">Verified Settlement Evidence</h3>

          <% if (!settlement.length) { %>
          <div class="text-muted">No confirmed settlement.</div>
          <% } %>

          <dl class="row g-3">
            <% settlement.forEach(function(field) { %>
            <dt class="col-md-4 text-muted"><%= field.title %></dt>
            <dd class="col-md-8 text-break"><%= field.value %></dd>
            <% }); %>
          </dl>
        </div>
      </div>