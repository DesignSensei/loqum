<div class="d-flex justify-content-between align-items-center mt-5">
  <span class="text-muted">
    Page <%= subscriptionView.pagination.page %>
    of <%= subscriptionView.pagination.totalPages || 1 %>
  </span>

  <div class="d-flex gap-2">
    <% if (subscriptionView.pagination.previousUrl) { %>
    <a class="btn btn-sm btn-light" href="<%= subscriptionView.pagination.previousUrl %>">Previous</a>
    <% } %>
    <% if (subscriptionView.pagination.nextUrl) { %>
    <a class="btn btn-sm btn-light-primary" href="<%= subscriptionView.pagination.nextUrl %>">Next</a>
    <% } %>
  </div>
</div>
