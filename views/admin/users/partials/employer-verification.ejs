<%# views/admin/users/partials/employer-verifications.ejs %>

<div
  id="adminEmployerVerifications"
  class="container-fluid py-5"
  data-queue-url="/admin/employer-verifications/data"
  data-employer-base-url="/admin/employers"
  data-csrf-token="<%= csrfToken %>"
>
  <!-- PAGE HEADING -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-6">
    <div>
      <h1 class="fs-2 fw-bold text-gray-900 mb-1">Employer Verification</h1>
      <p class="text-gray-600 mb-0">
        Review business registrations, CAC checks, and facility compliance.
      </p>
    </div>

    <button type="button" class="btn btn-light-primary" id="refreshVerificationQueue">
      <i class="ki-outline ki-arrows-circle fs-3 me-1"></i>
      Refresh
    </button>
  </div>

  <!-- FEEDBACK -->
  <div id="verificationFeedback" class="alert d-none mb-5" role="alert" aria-live="polite"></div>

  <div class="row g-5">
    <!-- EMPLOYER QUEUE -->
    <div class="col-12 col-xl-5">
      <div class="card h-100">
        <div class="card-header border-0 pt-5">
          <div class="card-title d-flex flex-column align-items-start">
            <h2 class="fw-bold fs-4 mb-1">Verification Queue</h2>
            <span id="verificationQueueCount" class="text-muted fs-7"> Loading employers... </span>
          </div>
        </div>

        <div class="card-body pt-2">
          <div class="mb-4">
            <label class="form-label fw-semibold" for="verificationStatusFilter">
              Filter employers
            </label>

            <select id="verificationStatusFilter" class="form-select form-select-solid">
              <option value="review">Needs attention</option>
              <option value="all">All employers</option>
              <option value="pending">Pending verification</option>
              <option value="needs_review">Needs review</option>
              <option value="verified">Verified registration</option>
              <option value="rejected">Rejected verification</option>
              <option value="approved">Approved employers</option>
              <option value="restricted">Restricted accounts</option>
              <option value="suspended">Suspended accounts</option>
            </select>
          </div>

          <div id="verificationQueueLoading" class="text-center py-10" role="status">
            <span class="spinner-border text-primary"></span>
            <p class="text-muted mt-3">Loading verification queue...</p>
          </div>

          <div id="verificationQueueEmpty" class="text-center py-10 d-none">
            <i class="ki-outline ki-check-circle fs-3x text-gray-400"></i>
            <h3 class="fs-5 mt-4">No employers found</h3>
            <p class="text-muted mb-0">There are no employers matching the selected filter.</p>
          </div>

          <div
            id="verificationQueueItems"
            class="d-flex flex-column gap-3"
            aria-label="Employers awaiting verification"
          ></div>

          <!-- PAGINATION -->
          <div class="d-flex align-items-center justify-content-between gap-3 mt-5 pt-4 border-top">
            <span id="verificationPageLabel" class="text-muted fs-7"> Page 1 </span>

            <div class="d-flex gap-2">
              <button
                type="button"
                id="verificationPreviousPage"
                class="btn btn-sm btn-light"
                disabled
              >
                Previous
              </button>

              <button type="button" id="verificationNextPage" class="btn btn-sm btn-light" disabled>
                Next
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- EMPLOYER DETAILS -->
    <div class="col-12 col-xl-7">
      <div class="card h-100">
        <div class="card-header border-0 pt-5">
          <div class="card-title d-flex flex-column align-items-start">
            <h2 class="fw-bold fs-4 mb-1">Verification Details</h2>
            <span class="text-muted fs-7"> Select an employer to inspect their registration. </span>
          </div>
        </div>

        <div class="card-body pt-3">
          <!-- NO EMPLOYER SELECTED -->
          <div id="verificationNoSelection" class="text-center py-15">
            <i class="ki-outline ki-shield-search fs-3x text-gray-400"></i>
            <h3 class="fs-5 mt-4">Select an employer</h3>
            <p class="text-muted mb-0">
              CAC verification, PCN compliance, and review history will appear here.
            </p>
          </div>

          <!-- LOADING -->
          <div id="verificationDetailsLoading" class="text-center py-10 d-none" role="status">
            <span class="spinner-border text-primary"></span>
            <p class="text-muted mt-3">Loading employer details...</p>
          </div>

          <!-- SELECTED EMPLOYER -->
          <div id="verificationDetailsContent" class="d-none">
            <input type="hidden" id="selectedVerificationEmployerId" />

            <!-- BUSINESS IDENTITY -->
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-5">
              <div>
                <h3 id="verificationBusinessName" class="fw-bold fs-3 text-gray-900 mb-1"></h3>

                <div id="verificationBusinessType" class="text-muted fs-7"></div>
              </div>

              <span id="verificationAccountStatus" class="badge badge-light-warning"></span>
            </div>

            <div class="row g-4 mb-6">
              <div class="col-sm-6">
                <div class="border rounded p-4 h-100">
                  <div class="text-muted fs-7 mb-1">CAC Registration Number</div>

                  <div
                    id="verificationCACNumber"
                    class="fw-semibold text-gray-900 text-break"
                  ></div>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="border rounded p-4 h-100">
                  <div class="text-muted fs-7 mb-1">Regulatory Registration</div>

                  <div
                    id="verificationRegulatoryNumber"
                    class="fw-semibold text-gray-900 text-break"
                  ></div>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="border rounded p-4 h-100">
                  <div class="text-muted fs-7 mb-1">Registered Business Email</div>

                  <div
                    id="verificationBusinessEmail"
                    class="fw-semibold text-gray-900 text-break"
                  ></div>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="border rounded p-4 h-100">
                  <div class="text-muted fs-7 mb-1">Business Location</div>

                  <div
                    id="verificationBusinessLocation"
                    class="fw-semibold text-gray-900 text-break"
                  ></div>
                </div>
              </div>
            </div>

            <!-- CAC VERIFICATION -->
            <div class="border rounded p-5 mb-5">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                  <h4 class="fw-bold fs-5 mb-1">CAC Verification</h4>
                  <div class="text-muted fs-7">Corporate Affairs Commission</div>
                </div>

                <span id="verificationCACStatus" class="badge badge-light-warning"></span>
              </div>

              <div class="mb-3">
                <div class="text-muted fs-7 mb-1">Name on CAC Record</div>

                <div id="verificationCACName" class="fw-semibold"></div>
              </div>

              <div class="mb-3">
                <div class="text-muted fs-7 mb-1">Last Checked</div>

                <div id="verificationCACCheckedAt" class="fw-semibold"></div>
              </div>

              <div id="verificationCACNote" class="text-gray-600 fs-7 mb-4"></div>

              <button type="button" class="btn btn-light-primary" id="verificationCACRecheck">
                <i class="ki-outline ki-arrows-circle fs-4 me-1"></i>
                Recheck CAC
              </button>

              <p class="text-muted fs-8 mt-3 mb-0">
                CAC lookups use the configured VAS environment. Staging results do not approve
                employers.
              </p>
            </div>

            <!-- PCN VERIFICATION -->
            <div id="verificationPCNSection" class="border rounded p-5 mb-5">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                  <h4 class="fw-bold fs-5 mb-1">PCN Premises Verification</h4>

                  <div class="text-muted fs-7">Manual review of pharmacy premises registration</div>
                </div>

                <span id="verificationPCNStatus" class="badge badge-light-warning"></span>
              </div>

              <div class="mb-4">
                <div class="text-muted fs-7 mb-1">Previously Recorded Premises Name</div>

                <div id="verificationPCNName" class="fw-semibold"></div>
              </div>

              <div class="mb-4">
                <a
                  href="https://pcncore.azurewebsites.net/PublicSearch/SearchForPremises"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-sm btn-light-info"
                >
                  <i class="ki-outline ki-exit-right-corner fs-4 me-1"></i>
                  Open PCN Premises Search
                </a>
              </div>

              <form id="verificationPCNForm">
                <div class="mb-4">
                  <label class="form-label required" for="verificationPCNDecision">
                    Review Decision
                  </label>

                  <select
                    id="verificationPCNDecision"
                    class="form-select form-select-solid"
                    required
                  >
                    <option value="">Select a decision</option>

                    <option value="verified">Verified</option>

                    <option value="needs_review">Needs Review</option>

                    <option value="rejected">Rejected</option>
                  </select>
                </div>

                <div class="mb-4">
                  <label class="form-label" for="verificationPCNRegisteredName">
                    Registered Premises Name
                  </label>

                  <input
                    type="text"
                    id="verificationPCNRegisteredName"
                    class="form-control form-control-solid"
                    maxlength="150"
                    placeholder="Name returned by PCN premises search"
                  />

                  <div class="form-text">Required when recording a verified decision.</div>
                </div>

                <div class="mb-4">
                  <label class="form-label required" for="verificationPCNReviewNote">
                    Review Note
                  </label>

                  <textarea
                    id="verificationPCNReviewNote"
                    class="form-control form-control-solid"
                    rows="4"
                    maxlength="500"
                    minlength="10"
                    required
                    placeholder="Record what you checked and the reason for your decision."
                  ></textarea>
                </div>

                <button type="submit" class="btn btn-primary" id="verificationPCNSubmit">
                  Save PCN Review
                </button>
              </form>
            </div>

            <!-- EMPLOYER APPROVAL -->
            <div class="border rounded p-5 mb-5">
              <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h4 class="fw-bold fs-5 mb-0">Employer Approval</h4>

                <span
                  id="verificationEmployerApprovalStatus"
                  class="badge badge-light-warning"
                ></span>
              </div>

              <div id="verificationEmployerApprovalNote" class="text-gray-600 fs-7"></div>

              <p class="text-muted fs-8 mt-3 mb-0">
                Final approval requires CAC verification, regulatory verification, and
                administrative sanctions screening. Verification checks alone do not grant
                marketplace access.
              </p>
            </div>

            <!-- VERIFICATION HISTORY -->
            <div class="border rounded p-5">
              <h4 class="fw-bold fs-5 mb-4">Verification History</h4>

              <div class="table-responsive">
                <table class="table table-row-dashed align-middle">
                  <thead>
                    <tr class="text-muted fw-semibold fs-7">
                      <th>Type</th>
                      <th>Provider</th>
                      <th>Status</th>
                      <th>Checked</th>
                    </tr>
                  </thead>

                  <tbody id="verificationHistoryBody">
                    <tr>
                      <td colspan="4" class="text-muted text-center py-5">
                        No verification history loaded.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <p class="text-muted fs-8 mb-0">
                Previous checks remain available for audit. Staging checks and provider failures are
                not treated as authoritative production verification.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
