<%# views/admin/users/show.ejs %>

<div
  id="adminUserDetails"
  class="container-fluid py-5"
  data-user-id="<%= userView.id %>"
  data-role="<%= userView.role %>"
  data-profile-id="<%= userView.profileId || '' %>"
  data-details-url="<%= userView.detailsDataUrl %>"
  data-employer-verification-url="<%= userView.employerVerificationDataUrl || '' %>"
  data-csrf-token="<%= csrfToken %>"
>
  <!-- Page Header -->
  <div class="d-flex flex-wrap align-items-start justify-content-between gap-4 mb-8">
    <div>
      <a
        href="<%= userView.backUrl %>"
        class="text-gray-600 text-hover-primary fw-semibold fs-7 d-inline-flex align-items-center mb-4"
      >
        <i class="ki-duotone ki-arrow-left fs-4 me-2">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>

        <%= userView.backLabel %>
      </a>

      <h1 class="fs-2x fw-bold text-gray-900 mb-2"><%= userView.heading %></h1>

      <div class="text-gray-600 fs-6 mb-4 text-break"><%= userView.subtitle %></div>

      <div class="d-flex flex-wrap align-items-center gap-2">
        <% userView.headerBadges.forEach(function (badge) { %>

        <span class="<%= badge.className %>"> <%= badge.label %> </span>

        <% }); %>
      </div>
    </div>

    <a href="<%= userView.refreshUrl %>" class="btn btn-light-primary" id="adminUserDetailsRefresh">
      <i class="ki-duotone ki-arrows-circle fs-2 me-1">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      Refresh
    </a>
  </div>

  <!-- Feedback -->
  <div
    id="adminUserDetailsFeedback"
    class="alert d-none mb-6"
    role="alert"
    aria-live="polite"
  ></div>

  <!-- Summary Cards -->
  <div class="row g-5 mb-8">
    <% userView.summaryCards.forEach(function (card) { %>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-flush h-100">
        <div class="card-body">
          <div class="text-gray-600 fw-semibold fs-7 mb-3"><%= card.label %></div>

          <span class="<%= card.badge.className %>" data-summary-key="<%= card.key %>">
            <%= card.badge.label %>
          </span>
        </div>
      </div>
    </div>

    <% }); %>
  </div>

  <!-- User Details Card -->
  <div class="card card-flush">
    <!-- Tabs -->
    <div class="card-header border-0 pt-5">
      <ul
        class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold"
        role="tablist"
      >
        <% userView.tabs.forEach(function (tab) { %>

        <li class="nav-item" role="presentation">
          <button
            type="button"
            class="nav-link text-active-primary me-8 <%= tab.active ? 'active' : '' %>"
            id="adminUserTab-<%= tab.key %>"
            data-bs-toggle="tab"
            data-bs-target="#adminUserPanel-<%= tab.key %>"
            role="tab"
            aria-controls="adminUserPanel-<%= tab.key %>"
            aria-selected="<%= tab.active ? 'true' : 'false' %>"
          >
            <%= tab.label %> <% if (tab.requiresAttention) { %>

            <span
              class="badge badge-circle badge-warning ms-2"
              title="Verification requires attention"
            >
              !
            </span>

            <% } %>
          </button>
        </li>

        <% }); %>
      </ul>
    </div>

    <!-- Card Body -->
    <div class="card-body pt-6">
      <div class="tab-content">
        <!-- Overview Tab -->
        <div
          class="tab-pane fade show active"
          id="adminUserPanel-overview"
          role="tabpanel"
          aria-labelledby="adminUserTab-overview"
          tabindex="0"
        >
          <% if (userView.emptyProfileNotice) { %>

          <div class="alert alert-light-<%= userView.emptyProfileNotice.color %> mb-8">
            <%= userView.emptyProfileNotice.text %>
          </div>

          <% } %>

          <!-- Overview Sections -->
          <% userView.overviewSections.forEach(function (section) { %>

          <section class="mb-10" data-section="<%= section.key || '' %>">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-6">
              <div>
                <h3 class="fw-bold text-gray-900 mb-1"><%= section.title %></h3>

                <% if (section.description) { %>

                <p class="text-gray-500 fs-7 mb-0"><%= section.description %></p>

                <% } %>
              </div>

              <% if (section.badge) { %>

              <span class="<%= section.badge.className %>"> <%= section.badge.label %> </span>

              <% } %>
            </div>

            <div class="row g-6">
              <% section.fields.forEach(function (field) { %>

              <div class="col-12 col-md-6">
                <div class="text-gray-500 fs-7 mb-1"><%= field.label %></div>

                <% if (field.badge) { %>

                <span class="<%= field.badge.className %>"> <%= field.badge.label %> </span>

                <% } else { %>

                <div class="text-gray-900 fw-semibold text-break"><%= field.value %></div>

                <% } %>
              </div>

              <% }); %>
            </div>

            <% if (section.notes && section.notes.length) { %>

            <div class="mt-7">
              <% section.notes.forEach(function (note) { %>

              <div class="bg-light rounded p-4 mb-3">
                <div class="fw-semibold text-gray-800 mb-2"><%= note.label %></div>

                <div class="text-gray-600 fs-7 text-break"><%= note.text %></div>
              </div>

              <% }); %>
            </div>

            <% } %> <% if (section.notice) { %>

            <div class="alert alert-light-<%= section.notice.color %> mt-6 mb-0">
              <%= section.notice.text %>
            </div>

            <% } %>
          </section>

          <div class="separator separator-dashed mb-10"></div>

          <% }); %>

          <!-- Profile Account Notes -->
          <% if (userView.overviewNotes && userView.overviewNotes.length) { %>

          <div class="mb-8">
            <% userView.overviewNotes.forEach(function (note) { %>

            <div class="alert alert-light-warning mb-4">
              <div class="fw-bold mb-2"><%= note.label %></div>

              <div class="text-gray-700"><%= note.text %></div>
            </div>

            <% }); %>
          </div>

          <% } %>
        </div>

        <!-- Verification Tab -->
        <div
          class="tab-pane fade"
          id="adminUserPanel-verification"
          role="tabpanel"
          aria-labelledby="adminUserTab-verification"
          tabindex="0"
        >
          <div class="mb-8">
            <h3 class="fw-bold text-gray-900 mb-2">
              <%= userView.role === "professional" ? "Verification & Approval" : "Business
              Verification" %>
            </h3>

            <p class="text-gray-600 fs-6 mb-0"><%= userView.verificationGuidance %></p>
          </div>

          <div
            id="adminUserVerificationFeedback"
            class="alert d-none mb-6"
            role="alert"
            aria-live="polite"
          ></div>

          <% if (userView.emptyProfileNotice) { %>

          <div class="alert alert-light-<%= userView.emptyProfileNotice.color %> mb-8">
            <%= userView.emptyProfileNotice.text %>
          </div>

          <% } %>

          <!-- Verification Sections -->
          <% userView.verificationSections.forEach(function (section) { %>

          <div class="card card-bordered mb-8" data-verification-section="<%= section.key || '' %>">
            <!-- Section Header -->
            <div class="card-header align-items-center">
              <div class="card-title">
                <h4 class="fw-bold text-gray-900 mb-0"><%= section.title %></h4>
              </div>

              <% if (section.badge) { %>

              <div class="card-toolbar">
                <span
                  class="<%= section.badge.className %>"
                  data-verification-badge="<%= section.key || '' %>"
                >
                  <%= section.badge.label %>
                </span>
              </div>

              <% } %>
            </div>

            <!-- Section Body -->
            <div class="card-body">
              <% if (section.description) { %>

              <p class="text-gray-600 fs-7 mb-6"><%= section.description %></p>

              <% } %>

              <!-- Verification Fields -->
              <div class="row g-6">
                <% section.fields.forEach(function (field) { %>

                <div class="col-12 col-md-6">
                  <div class="text-gray-500 fs-7 mb-1"><%= field.label %></div>

                  <% if (field.badge) { %>

                  <span class="<%= field.badge.className %>"> <%= field.badge.label %> </span>

                  <% } else { %>

                  <div class="text-gray-900 fw-semibold text-break"><%= field.value %></div>

                  <% } %>
                </div>

                <% }); %>
              </div>

              <!-- Verification Notes -->
              <% if (section.notes && section.notes.length) { %>

              <div class="mt-7">
                <% section.notes.forEach(function (note) { %>

                <div class="bg-light rounded p-4 mb-3">
                  <div class="fw-semibold text-gray-800 mb-2"><%= note.label %></div>

                  <div class="text-gray-600 fs-7 text-break"><%= note.text %></div>
                </div>

                <% }); %>
              </div>

              <% } %>

              <!-- External Verification Link -->
              <% if (section.externalLink) { %>

              <div class="mt-7">
                <a
                  href="<%= section.externalLink.url %>"
                  target="<%= section.externalLink.target %>"
                  rel="<%= section.externalLink.rel %>"
                  class="btn btn-light-primary btn-sm"
                >
                  <%= section.externalLink.label %>

                  <i class="ki-duotone ki-arrow-up-right fs-4 ms-1">
                    <span class="path1"></span>
                    <span class="path2"></span>
                  </i>
                </a>
              </div>

              <% } %>

              <!-- Verification Notice -->
              <% if (section.notice) { %>

              <div class="alert alert-light-<%= section.notice.color %> mt-7 mb-0">
                <%= section.notice.text %>
              </div>

              <% } %>

              <!-- CAC Action -->
              <% if (section.action) { %>

              <div class="separator separator-dashed my-7"></div>

              <button
                type="button"
                id="<%= section.action.id %>"
                class="btn btn-light-primary"
                data-action-url="<%= section.action.url %>"
                data-action-method="<%= section.action.method %>"
                data-confirm-title="<%= section.action.confirmationTitle %>"
                data-confirm-text="<%= section.action.confirmationText %>"
                disabled
              >
                <span class="indicator-label">
                  <i class="ki-duotone ki-arrows-circle fs-2 me-1">
                    <span class="path1"></span>
                    <span class="path2"></span>
                  </i>

                  <%= section.action.label %>
                </span>

                <span class="indicator-progress">
                  Checking...
                  <span class="spinner-border spinner-border-sm ms-2"></span>
                </span>
              </button>

              <% } %>
            </div>
          </div>

          <% }); %> <% if (userView.professionalReadOnlyNotice) { %>

          <div class="alert alert-light-<%= userView.professionalReadOnlyNotice.color %>">
            <%= userView.professionalReadOnlyNotice.text %>
          </div>

          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
