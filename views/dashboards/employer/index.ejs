<!-- views/dashboards/employer/index.ejs -->

<!--begin::Account Status Alert-->
<div class="row mb-4">
  <div class="col-12">
    <% if (employerProfile.accountStatus === "active") { %>
    <div
      class="alert alert-dismissible bg-light-success border border-success d-flex align-items-center p-4 mb-0"
    >
      <i class="ki-duotone ki-check-circle fs-2x text-success me-4">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
      <div class="d-flex flex-column">
        <span class="fw-bold text-gray-900 fs-6"
          >Your business account is verified and active.</span
        >
        <span class="text-gray-600 fs-7"
          >You can post shifts, review applicants, and manage bookings without restriction.</span
        >
      </div>
    </div>
    <% } else if (employerProfile.accountStatus === "restricted") { %>
    <div
      class="alert alert-dismissible bg-light-warning border border-warning d-flex align-items-center p-4 mb-0"
    >
      <i class="ki-duotone ki-information-5 fs-2x text-warning me-4">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
      </i>
      <div class="d-flex flex-column">
        <span class="fw-bold text-gray-900 fs-6"
          >Your business account is currently restricted.</span
        >
        <span class="text-gray-600 fs-7"
          >Some actions may be limited until your account review is completed.</span
        >
      </div>
    </div>
    <% } else { %>
    <div
      class="alert alert-dismissible bg-light-danger border border-danger d-flex align-items-center p-4 mb-0"
    >
      <i class="ki-duotone ki-cross-circle fs-2x text-danger me-4">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
      <div class="d-flex flex-column">
        <span class="fw-bold text-gray-900 fs-6">Your business account is suspended.</span>
        <span class="text-gray-600 fs-7"
          >Please contact support to resolve this before posting or managing shifts.</span
        >
      </div>
    </div>
    <% } %>
  </div>
</div>
<!--end::Account Status Alert-->

<!--begin::Row - Stats-->
<div class="row gx-3 gx-xl-4 mb-5">
  <!--begin::Col - Open Shifts-->
  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
            <%= stats.openShifts %>
          </span>
          <span class="text-gray-500 pt-1 fw-semibold fs-6">Open Shifts</span>
        </div>
      </div>
      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <div class="d-flex align-items-center gap-2">
          <i class="ki-duotone ki-calendar fs-2 text-primary">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
          <span class="text-gray-500 fw-semibold fs-7">Still waiting for cover</span>
        </div>
      </div>
    </div>
  </div>
  <!--end::Col-->

  <!--begin::Col - Applications to Review-->
  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
            <%= stats.applicationsToReview %>
          </span>
          <span class="text-gray-500 pt-1 fw-semibold fs-6">Applications to Review</span>
        </div>
      </div>
      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <div class="d-flex align-items-center gap-2">
          <i class="ki-duotone ki-profile-user fs-2 text-warning">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
          </i>
          <span class="text-gray-500 fw-semibold fs-7">Awaiting your decision</span>
        </div>
      </div>
    </div>
  </div>
  <!--end::Col-->

  <!--begin::Col - Confirmed Upcoming Shifts-->
  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
            <%= stats.confirmedUpcomingShifts %>
          </span>
          <span class="text-gray-500 pt-1 fw-semibold fs-6">Confirmed Upcoming Shifts</span>
        </div>
      </div>
      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <div class="d-flex align-items-center gap-2">
          <i class="ki-duotone ki-calendar-tick fs-2 text-success">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
            <span class="path5"></span>
            <span class="path6"></span>
          </i>
          <span class="text-gray-500 fw-semibold fs-7">Professionals already assigned</span>
        </div>
      </div>
    </div>
  </div>
  <!--end::Col-->

  <!--begin::Col - Wallet Balance-->
  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <div class="d-flex align-items-center">
            <span class="fs-4 fw-semibold text-gray-500 me-1 align-self-start">₦</span>
            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
              <%= (stats.walletBalance || 0).toLocaleString() %>
            </span>
          </div>
          <span class="text-gray-500 pt-1 fw-semibold fs-6">Wallet Balance</span>
        </div>
      </div>
      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <% if (stats.walletBalance > 0) { %>
        <a
          href="/employer/wallet"
          class="badge badge-light-success fs-7 fw-bold text-decoration-none"
          >Fund or Withdraw</a
        >
        <% } else { %>
        <a
          href="/employer/wallet"
          class="badge badge-light-warning fs-7 fw-bold text-decoration-none"
          >Fund Wallet</a
        >
        <% } %>
      </div>
    </div>
  </div>
  <!--end::Col-->
</div>
<!--end::Row - Stats-->

<!--begin::Row - Shifts & Quick Actions-->
<div class="row gy-4 g-xl-5">
  <!--begin::Col - Recent Shifts-->
  <div class="col-xl-8 mb-4">
    <div class="card card-flush h-xl-100">
      <div class="card-header pt-5">
        <h3 class="card-title align-items-start flex-column">
          <span class="card-label fw-bold text-gray-900">Recent Shifts</span>
          <span class="text-gray-500 mt-1 fw-semibold fs-6">Your latest posted shifts</span>
        </h3>
        <div class="card-toolbar">
          <a href="/employer/shifts" class="btn btn-sm btn-light">View All</a>
        </div>
      </div>

      <div class="card-body pt-4">
        <% if (recentShifts && recentShifts.length > 0) { %>
        <div class="table-responsive">
          <table class="table align-middle table-row-dashed fs-6 gy-2">
            <thead>
              <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                <th class="min-w-100px">Reference</th>
                <th class="min-w-125px">Role</th>
                <th class="min-w-100px">Branch</th>
                <th class="min-w-100px">Date</th>
                <th class="min-w-75px">Rate</th>
                <th class="min-w-75px">Applications</th>
                <th class="min-w-75px">Status</th>
              </tr>
            </thead>
            <tbody class="fw-bold text-gray-600">
              <% recentShifts.forEach(shift => { %>
              <tr>
                <td>
                  <a
                    href="/employer/shifts/<%= shift._id %>"
                    class="text-gray-800 text-hover-primary fw-bold"
                  >
                    <%= shift.referenceCode %>
                  </a>
                </td>
                <td><%= shift.roleTitle %></td>
                <td><%= shift.branch ? shift.branch.name : "—" %></td>
                <td>
                  <%= new Date(shift.startTime).toLocaleDateString("en-NG", { day: "numeric", month:
                  "short", year: "numeric" }) %>
                </td>
                <td>₦<%= (shift.hourlyRate || 0).toLocaleString() %>/hr</td>
                <td>
                  <span class="badge badge-light"><%= shift.totalApplications || 0 %></span>
                </td>
                <td>
                  <% if (shift.status === "open") { %>
                  <span class="badge badge-light-primary">Open</span>
                  <% } else if (shift.status === "assigned") { %>
                  <span class="badge badge-light-warning">Assigned</span>
                  <% } else if (shift.status === "confirmed") { %>
                  <span class="badge badge-light-info">Confirmed</span>
                  <% } else if (shift.status === "in_progress") { %>
                  <span class="badge badge-light-warning">In Progress</span>
                  <% } else if (shift.status === "pending_settlement") { %>
                  <span class="badge badge-light-info">Settling</span>
                  <% } else if (shift.status === "completed") { %>
                  <span class="badge badge-light-success">Completed</span>
                  <% } else if (shift.status === "cancelled") { %>
                  <span class="badge badge-light-danger">Cancelled</span>
                  <% } else if (shift.status === "disputed") { %>
                  <span class="badge badge-light-danger">Disputed</span>
                  <% } else if (shift.status === "no_show") { %>
                  <span class="badge badge-light-danger">No Show</span>
                  <% } else { %>
                  <span class="badge badge-light">Unknown</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="d-flex flex-column flex-center py-10">
          <i class="ki-duotone ki-calendar fs-4x text-gray-300 mb-4">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
          <span class="text-gray-500 fw-semibold fs-6 mb-4">No shifts posted yet</span>
          <a href="/employer/shifts/post" class="btn btn-sm btn-primary">Post Your First Shift</a>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <!--end::Col-->

  <!--begin::Col - Quick Actions-->
  <div class="col-xl-4 mb-4">
    <div class="card card-flush h-xl-100">
      <div class="card-header pt-5">
        <h3 class="card-title align-items-start flex-column">
          <span class="card-label fw-bold text-gray-900">Quick Actions</span>
          <span class="text-gray-500 mt-1 fw-semibold fs-6">Common tasks at a glance</span>
        </h3>
      </div>
      <div class="card-body pt-4">
        <div class="d-flex flex-column gap-3">
          <a
            href="/employer/shifts/post"
            class="d-flex align-items-center bg-light-primary rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-plus-square fs-2x text-primary me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>
            <div>
              <div class="fw-bold text-gray-900 fs-6">Post a Shift</div>
              <div class="text-gray-500 fs-7">Find a professional fast</div>
            </div>
          </a>

          <a
            href="/employer/shifts"
            class="d-flex align-items-center bg-light-warning rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-calendar-tick fs-2x text-warning me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
              <span class="path5"></span>
              <span class="path6"></span>
            </i>
            <div>
              <div class="fw-bold text-gray-900 fs-6">Manage Shifts</div>
              <div class="text-gray-500 fs-7">View and manage all shifts</div>
            </div>
          </a>

          <a
            href="/employer/profile"
            class="d-flex align-items-center bg-light-info rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-shop fs-2x text-info me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
              <span class="path5"></span>
            </i>
            <div>
              <div class="fw-bold text-gray-900 fs-6">Business Profile</div>
              <div class="text-gray-500 fs-7">Manage branches and team</div>
            </div>
          </a>

          <a
            href="/employer/wallet"
            class="d-flex align-items-center bg-light-success rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-wallet fs-2x text-success me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
            </i>
            <div>
              <div class="fw-bold text-gray-900 fs-6">Wallet</div>
              <div class="text-gray-500 fs-7">Fund wallet and view transactions</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
  <!--end::Col-->
</div>
<!--end::Row-->
