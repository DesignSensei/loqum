<!-- views/employer/billing/index.ejs -->

<div class="content flex-column-fluid" id="kt_content">
  <div class="row g-5 g-xl-8 mb-8 align-items-stretch">
    <!-- Wallet Balance -->
    <div class="col-xl-8">
      <div class="card h-100">
        <div class="card-body p-8 d-flex flex-column h-100">
          <div class="d-flex align-items-start justify-content-between mb-7">
            <div>
              <div class="text-muted fw-semibold fs-7 mb-2">Wallet Balance</div>

              <div class="fs-2hx fw-bold text-gray-900">
                <%= billingView.wallet.availableBalanceDisplay %>
              </div>

              <div class="text-muted fs-7 mt-2">Available to pay for shifts</div>
            </div>

            <div class="symbol symbol-45px">
              <div class="symbol-label bg-light-primary">
                <i class="ki-duotone ki-wallet fs-2 text-primary">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                  <span class="path4"></span>
                </i>
              </div>
            </div>
          </div>

          <div class="d-flex align-items-center justify-content-between mb-7">
            <span class="badge <%= billingView.wallet.statusBadgeClass %>">
              <%= billingView.wallet.statusLabel %>
            </span>
          </div>

          <div class="bg-light rounded p-5 flex-grow-1 d-flex">
            <div class="row g-4 flex-grow-1 w-100">
              <div class="col-md-6 d-flex">
                <div
                  class="bg-light-success rounded border border-success border-dashed p-5 h-100 w-100 d-flex flex-column"
                >
                  <div class="text-success fs-8 fw-semibold mb-3">Money Added</div>

                  <div class="flex-grow-1 d-flex align-items-center">
                    <div class="fw-bold text-gray-900 fs-1 lh-1">
                      <%= billingView.wallet.moneyAddedDisplay %>
                    </div>
                  </div>

                  <div class="text-muted fs-8 mt-3">Total money added to this wallet</div>
                </div>
              </div>

              <div class="col-md-6 d-flex">
                <div
                  class="bg-light-danger rounded border border-danger border-dashed p-5 h-100 w-100 d-flex flex-column"
                >
                  <div class="text-danger fs-8 fw-semibold mb-3">Money Used</div>

                  <div class="flex-grow-1 d-flex align-items-center">
                    <div class="fw-bold text-gray-900 fs-1 lh-1">
                      <%= billingView.wallet.moneyUsedDisplay %>
                    </div>
                  </div>

                  <div class="text-muted fs-8 mt-3">Shift payments and wallet debits</div>
                </div>
              </div>
            </div>
          </div>

          <% if (billingView.wallet.frozenReason) { %>
          <div
            class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mt-6"
          >
            <div class="fw-semibold">
              <div class="fs-6 text-gray-800 fw-bold mb-1">Wallet Frozen</div>

              <div class="fs-7 text-muted"><%= billingView.wallet.frozenReason %></div>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Add Money -->
    <div class="col-xl-4">
      <div class="card h-100">
        <div class="card-body p-8 d-flex flex-column h-100">
          <div class="d-flex align-items-center justify-content-between mb-7">
            <div>
              <div class="text-muted fw-semibold fs-7 mb-2">Add Money</div>

              <div class="fs-3 fw-bold text-gray-900">Wallet Bank Account</div>
            </div>
          </div>

          <% if (billingView.dva.canDisplayBankDetails) { %>
          <div class="text-muted fs-7 mb-6">
            Transfer to this account to add money to your wallet.
          </div>

          <div class="d-flex flex-column gap-4">
            <div>
              <div class="text-muted fs-7 fw-semibold mb-1">Bank</div>

              <div class="fw-bold text-gray-900"><%= billingView.dva.bankName %></div>
            </div>

            <div>
              <div class="text-muted fs-7 fw-semibold mb-1">Account Number</div>

              <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="fs-2 fw-bold text-gray-900"><%= billingView.dva.accountNumber %></div>

                <button
                  type="button"
                  class="btn btn-sm btn-light js-copy-text"
                  data-copy-text="<%= billingView.dva.accountNumber %>"
                >
                  Copy
                </button>
              </div>
            </div>

            <div>
              <div class="text-muted fs-7 fw-semibold mb-1">Account Name</div>

              <div class="fw-semibold text-gray-800"><%= billingView.dva.accountName %></div>
            </div>
          </div>
          <% } else { %>
          <div
            class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-5"
          >
            <div class="fw-semibold">
              <div class="fs-6 text-gray-800 fw-bold mb-1"><%= billingView.dva.message %></div>

              <div class="fs-7 text-muted"><%= billingView.dva.supportMessage %></div>
            </div>
          </div>
          <% } %>

          <div class="mt-auto pt-6">
            <div class="separator mb-5"></div>

            <div class="d-flex flex-column gap-4">
              <div class="d-flex justify-content-between align-items-center gap-4">
                <span class="text-muted fs-7"> Bank account status </span>

                <span class="badge <%= billingView.dva.statusBadgeClass %>">
                  <%= billingView.dva.statusLabel %>
                </span>
              </div>

              <% if (billingView.dva.requestedAtDisplay !== "-") { %>
              <div class="d-flex justify-content-between align-items-center gap-4">
                <span class="text-muted fs-7"> Setup requested </span>

                <span class="fw-semibold text-gray-800 text-end fs-7">
                  <%= billingView.dva.requestedAtDisplay %>
                </span>
              </div>
              <% } %> <% if (!billingView.dva.canDisplayBankDetails &&
              billingView.dva.retryAvailableAtDisplay !== "-") { %>
              <div class="d-flex justify-content-between align-items-center gap-4">
                <span class="text-muted fs-7"> Try again from </span>

                <span class="fw-semibold text-gray-800 text-end fs-7">
                  <%= billingView.dva.retryAvailableAtDisplay %>
                </span>
              </div>
              <% } %>
            </div>

            <% if (!billingView.dva.canDisplayBankDetails && billingView.dva.canRetrySetup) { %>
            <form
              id="kt_dva_setup_form"
              method="POST"
              action="/employer/billing/setup-dva"
              class="mt-7"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

              <button id="kt_dva_setup_submit" type="submit" class="btn btn-primary w-100">
                <span class="indicator-label"> <%= billingView.dva.setupButtonLabel %> </span>

                <span class="indicator-progress">
                  Please wait...
                  <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                </span>
              </button>
            </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Payments Needing Attention -->
  <% if (billingView.paymentsDue?.hasPaymentsDue) { %>
  <div class="card mb-8">
    <div class="card-body p-6">
      <div
        class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-5"
      >
        <div class="d-flex align-items-start gap-4">
          <div class="symbol symbol-45px">
            <div class="symbol-label bg-light-danger">
              <i class="ki-duotone ki-information-5 fs-2 text-danger">
                <span class="path1"></span>
                <span class="path2"></span>
                <span class="path3"></span>
              </i>
            </div>
          </div>

          <div>
            <div class="fs-6 fw-bold text-gray-900 mb-1">Payments Needing Attention</div>

            <div class="fs-7 text-muted"><%= billingView.paymentsDue.message %></div>
          </div>
        </div>

        <div class="text-md-end">
          <div class="text-muted fs-8 fw-semibold mb-1">Total Due</div>

          <div class="fs-4 fw-bold text-danger">
            <%= billingView.paymentsDue.totalAmountDisplay %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Withdrawal Bank Account -->
  <div class="card mb-8" id="withdrawal-account">
    <div class="card-header border-0 pt-6">
      <div class="card-title flex-column flex-grow-1 pe-4 me-auto">
        <h3 class="fw-bold mb-1 fs-2">Withdrawal Bank Account</h3>

        <div class="text-muted fs-6">
          Add the bank account where eligible wallet withdrawals should be sent.
        </div>
      </div>

      <div
        class="card-toolbar ms-auto d-flex align-items-center gap-2 flex-nowrap justify-content-end"
      >
        <% if (billingView.withdrawalAccount.hasAccount) { %>
        <button
          type="button"
          class="btn btn-sm btn-light-primary h-30px px-3 fs-8 fw-semibold"
          data-bs-toggle="modal"
          data-bs-target="#kt_withdrawal_account_modal"
        >
          <i class="ki-duotone ki-pencil fs-8 me-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
          Edit
        </button>

        <form
          id="kt_withdrawal_account_remove_form"
          method="POST"
          action="/employer/billing/withdrawal-account/remove"
          class="d-inline-flex mb-0"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <button
            type="submit"
            id="kt_withdrawal_account_remove_submit"
            class="btn btn-sm btn-light-danger h-30px px-3 fs-8 fw-semibold"
          >
            <i class="ki-duotone ki-trash fs-8 me-1">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
              <span class="path5"></span>
            </i>
            Remove
          </button>
        </form>
        <% } else { %>
        <button
          type="button"
          class="btn btn-sm btn-light-primary h-30px px-3 fs-8 fw-semibold"
          data-bs-toggle="modal"
          data-bs-target="#kt_withdrawal_account_modal"
        >
          <i class="ki-duotone ki-plus fs-8 me-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
          Add
        </button>
        <% } %>
      </div>
    </div>

    <div class="card-body pt-0">
      <div class="row g-5 align-items-center">
        <div class="col-xl-7">
          <% if (billingView.withdrawalAccount.hasAccount) { %>
          <div class="bg-light rounded p-6">
            <div class="row g-5">
              <div class="col-md-4">
                <div class="text-muted fs-7 fw-semibold mb-1">Bank</div>

                <div class="fw-bold text-gray-900">
                  <%= billingView.withdrawalAccount.bankName %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="text-muted fs-7 fw-semibold mb-1">Account Number</div>

                <div class="fw-bold text-gray-900">
                  <%= billingView.withdrawalAccount.accountNumber %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="text-muted fs-7 fw-semibold mb-1">Account Name</div>

                <div class="fw-bold text-gray-900">
                  <%= billingView.withdrawalAccount.accountName %>
                </div>
              </div>
            </div>
          </div>
          <% } else { %>
          <div
            class="notice d-flex align-items-start bg-light-warning rounded border-warning border border-dashed p-5"
          >
            <div class="symbol symbol-40px me-4">
              <div class="symbol-label bg-warning bg-opacity-10">
                <i class="ki-duotone ki-information fs-2 text-warning">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>
              </div>
            </div>

            <div class="fw-semibold">
              <div class="fs-6 text-gray-800 fw-bold mb-1">No withdrawal bank account added</div>

              <div class="fs-7 text-muted"><%= billingView.withdrawalAccount.message %></div>
            </div>
          </div>
          <% } %>
        </div>

        <div class="col-xl-5">
          <div class="border border-dashed rounded p-5">
            <div class="d-flex align-items-start gap-4 mb-7">
              <div class="symbol symbol-45px flex-shrink-0">
                <div class="symbol-label bg-light-info">
                  <i class="ki-duotone ki-bank fs-2 text-info">
                    <span class="path1"></span>
                    <span class="path2"></span>
                  </i>
                </div>
              </div>

              <div>
                <div class="fw-bold text-gray-900 mb-1">Withdrawal Status</div>

                <div class="text-muted fs-8">
                  <%= billingView.withdrawalAccount.supportMessage %>
                </div>
              </div>
            </div>

            <% if (billingView.withdrawalAccount.canWithdraw) { %>
            <button
              type="button"
              class="btn btn-primary w-100"
              data-bs-toggle="modal"
              data-bs-target="#kt_wallet_withdrawal_modal"
            >
              Withdraw to bank account
            </button>
            <% } else if (billingView.withdrawalAccount.hasAccount) { %>
            <button type="button" class="btn btn-light w-100" disabled>
              Withdrawals not available yet
            </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Withdrawal Bank Account Modal -->
  <div class="modal fade" id="kt_withdrawal_account_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
      <div class="modal-content">
        <form
          id="kt_withdrawal_account_form"
          method="POST"
          action="/employer/billing/withdrawal-account"
          data-withdrawal-bank-mode="<%= billingView.withdrawalBankSetup.mode %>"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <% if (billingView.withdrawalAccount.hasAccount) { %>
          <input type="hidden" name="replaceExisting" value="true" />
          <% } %>

          <div class="modal-header">
            <h2 class="fw-bold">
              <% if (billingView.withdrawalAccount.hasAccount) { %> Change Withdrawal Bank Account
              <% } else { %> Add Withdrawal Bank Account <% } %>
            </h2>

            <button
              type="button"
              class="btn btn-icon btn-sm btn-active-light-primary"
              data-bs-dismiss="modal"
              aria-label="Close"
            >
              <i class="ki-duotone ki-cross fs-1">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </button>
          </div>

          <div class="modal-body py-10 px-lg-17">
            <div
              class="notice d-flex bg-light-info rounded border-info border border-dashed p-5 mb-7"
            >
              <div class="fw-semibold">
                <div class="fs-7 text-muted">
                  <% if (billingView.withdrawalAccount.hasAccount) { %> This will replace your
                  current withdrawal bank account. The old account will be removed from active use.
                  <% } else { %> This account will be used for eligible wallet withdrawals when
                  withdrawals become available. <% } %>
                </div>
              </div>
            </div>

            <div class="row g-5">
              <div class="col-md-6">
                <label class="form-label required">Bank</label>

                <select
                  id="withdrawal_bank_select"
                  name="<%= billingView.withdrawalBankSetup.bankSelectName %>"
                  class="form-select"
                  data-control="select2"
                  data-placeholder="Select bank"
                  data-dropdown-parent="#kt_withdrawal_account_modal"
                  required
                >
                  <option value="">Select bank</option>

                  <% billingView.withdrawalBanks.forEach((bank) => { %>
                  <option
                    value="<%= bank.value || bank.name %>"
                    data-bank-name="<%= bank.name %>"
                    data-paystack-bank-code="<%= bank.paystackBankCode || '' %>"
                  >
                    <%= bank.name %>
                  </option>
                  <% }); %>
                </select>

                <% if (billingView.withdrawalBankSetup.bankSelectName !== "bankName") { %>
                <input type="hidden" id="withdrawal_bank_name" name="bankName" />
                <% } %> <% if (billingView.withdrawalBankSetup.mode === "test") { %>
                <div class="text-muted fs-8 mt-2">Paystack test mode is active.</div>
                <% } %>
              </div>

              <div class="col-md-6">
                <label class="form-label required">Account Number</label>

                <input
                  id="withdrawal_account_number"
                  type="text"
                  name="accountNumber"
                  class="form-control"
                  placeholder="Enter account number"
                  inputmode="numeric"
                  autocomplete="off"
                  required
                />
              </div>

              <div class="col-md-12">
                <label class="form-label required">Account Name</label>

                <% if (billingView.withdrawalBankSetup.accountNameReadonly) { %>
                <input
                  id="withdrawal_account_name"
                  type="text"
                  name="accountName"
                  class="form-control"
                  placeholder="<%= billingView.withdrawalBankSetup.accountNamePlaceholder %>"
                  autocomplete="off"
                  readonly
                  required
                />
                <% } else { %>
                <input
                  id="withdrawal_account_name"
                  type="text"
                  name="accountName"
                  class="form-control"
                  placeholder="<%= billingView.withdrawalBankSetup.accountNamePlaceholder %>"
                  autocomplete="off"
                  required
                />
                <% } %> <% if (billingView.withdrawalBankSetup.canResolveAccountName) { %>
                <div id="withdrawal_account_resolve_hint" class="text-muted fs-8 mt-2">
                  Account name will be resolved automatically after you select a bank and enter a
                  valid account number.
                </div>
                <% } else { %>
                <div class="text-muted fs-8 mt-2">
                  Account name verification will become automatic after payment provider setup is
                  complete.
                </div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="modal-footer flex-center">
            <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

            <button id="kt_withdrawal_account_submit" type="submit" class="btn btn-primary">
              <span class="indicator-label">
                <% if (billingView.withdrawalAccount.hasAccount) { %> Save changes <% } else { %>
                Save bank account <% } %>
              </span>

              <span class="indicator-progress">
                Please wait...
                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Wallet Withdrawal Modal -->
  <div class="modal fade" id="kt_wallet_withdrawal_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
      <div class="modal-content">
        <form id="kt_wallet_withdrawal_form" method="POST" action="/employer/billing/withdraw">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="modal-header">
            <h2 class="fw-bold">Withdraw to Bank Account</h2>

            <button
              type="button"
              class="btn btn-icon btn-sm btn-active-light-primary"
              data-bs-dismiss="modal"
              aria-label="Close"
            >
              <i class="ki-duotone ki-cross fs-1">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </button>
          </div>

          <div class="modal-body py-10 px-lg-17">
            <div
              class="notice d-flex bg-light-info rounded border-info border border-dashed p-5 mb-7"
            >
              <div class="fw-semibold">
                <div class="fs-7 text-muted">
                  Withdrawals will be sent to your saved withdrawal bank account.
                </div>
              </div>
            </div>

            <div class="mb-7">
              <label class="form-label required">Amount</label>

              <input
                id="wallet_withdrawal_amount"
                type="text"
                name="amount"
                class="form-control"
                placeholder="Enter amount"
                inputmode="decimal"
                autocomplete="off"
                required
              />

              <div class="text-muted fs-8 mt-2">
                Available balance:
                <span class="fw-semibold text-gray-800">
                  <%= billingView.wallet.availableBalanceDisplay %>
                </span>
              </div>
            </div>

            <% if (billingView.withdrawalAccount.hasAccount) { %>
            <div class="bg-light rounded p-5">
              <div class="text-muted fs-8 fw-semibold mb-2">Withdrawal destination</div>

              <div class="fw-bold text-gray-900"><%= billingView.withdrawalAccount.bankName %></div>

              <div class="text-gray-800 fs-7">
                <%= billingView.withdrawalAccount.accountNumber %> — <%=
                billingView.withdrawalAccount.accountName %>
              </div>
            </div>
            <% } %>
          </div>

          <div class="modal-footer flex-center">
            <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

            <button id="kt_wallet_withdrawal_submit" type="submit" class="btn btn-primary">
              <span class="indicator-label">Submit withdrawal</span>

              <span class="indicator-progress">
                Please wait...
                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Recent Transactions -->
  <div class="card" id="recent-transactions">
    <div class="card-header border-0 pt-6">
      <div class="card-title flex-column">
        <h3 class="fw-bold mb-1">Recent Transactions</h3>

        <div class="text-muted fs-7">Latest wallet activity for your employer account.</div>
      </div>
    </div>

    <div class="card-body pt-0">
      <% if (billingView.hasTransactions) { %>
      <div class="table-responsive">
        <table class="table align-middle table-row-dashed fs-6 gy-5">
          <thead>
            <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
              <th>Description</th>
              <th>Method</th>
              <th>Status</th>
              <th>Date</th>
              <th class="text-end">Amount</th>
            </tr>
          </thead>

          <tbody class="text-gray-700 fw-semibold">
            <% billingView.transactions.forEach((transaction) => { %>
            <tr>
              <td>
                <div class="d-flex flex-column">
                  <span class="text-gray-900 fw-bold"> <%= transaction.typeLabel %> </span>

                  <span class="text-muted fs-7"> Ref: <%= transaction.reference %> </span>

                  <% if (transaction.description) { %>
                  <span class="text-muted fs-7"> <%= transaction.description %> </span>
                  <% } %>
                </div>
              </td>

              <td>
                <span class="text-gray-800"> <%= transaction.paymentRailLabel %> </span>
              </td>

              <td>
                <span class="badge <%= transaction.statusBadgeClass %>">
                  <%= transaction.statusLabel %>
                </span>
              </td>

              <td>
                <span class="text-gray-800"> <%= transaction.createdAtDisplay %> </span>
              </td>

              <td class="text-end">
                <span class="fw-bold <%= transaction.amountClass %>">
                  <%= transaction.signedAmountDisplay %>
                </span>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div
        class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 mt-6"
      >
        <div class="text-muted fs-7">
          Showing
          <span class="fw-semibold text-gray-800">
            <%= billingView.transactionsPagination.startItem %>
          </span>
          -
          <span class="fw-semibold text-gray-800">
            <%= billingView.transactionsPagination.endItem %>
          </span>
          of
          <span class="fw-semibold text-gray-800">
            <%= billingView.transactionsPagination.totalTransactions %>
          </span>
          transactions
        </div>

        <% if (billingView.transactionsPagination.hasPagination) { %>
        <ul class="pagination mb-0">
          <li
            class="page-item previous <%= billingView.transactionsPagination.hasPreviousPage ? '' : 'disabled' %>"
          >
            <% if (billingView.transactionsPagination.hasPreviousPage) { %>
            <a
              class="page-link"
              href="/employer/billing?transactionsPage=<%= billingView.transactionsPagination.previousPage %>#recent-transactions"
              aria-label="Previous page"
            >
              <i class="previous"></i>
            </a>
            <% } else { %>
            <span class="page-link" aria-label="Previous page">
              <i class="previous"></i>
            </span>
            <% } %>
          </li>

          <% billingView.transactionsPagination.pages.forEach((pageItem) => { %>
          <li class="page-item <%= pageItem.isActive ? 'active' : '' %>">
            <a
              class="page-link"
              href="/employer/billing?transactionsPage=<%= pageItem.page %>#recent-transactions"
            >
              <%= pageItem.page %>
            </a>
          </li>
          <% }); %>

          <li
            class="page-item next <%= billingView.transactionsPagination.hasNextPage ? '' : 'disabled' %>"
          >
            <% if (billingView.transactionsPagination.hasNextPage) { %>
            <a
              class="page-link"
              href="/employer/billing?transactionsPage=<%= billingView.transactionsPagination.nextPage %>#recent-transactions"
              aria-label="Next page"
            >
              <i class="next"></i>
            </a>
            <% } else { %>
            <span class="page-link" aria-label="Next page">
              <i class="next"></i>
            </span>
            <% } %>
          </li>
        </ul>
        <% } %>
      </div>
      <% } else { %>
      <div class="text-center py-15">
        <div class="symbol symbol-70px mb-5">
          <div class="symbol-label bg-light-primary">
            <i class="ki-duotone ki-wallet fs-2x text-primary">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
            </i>
          </div>
        </div>

        <div class="fs-4 fw-bold text-gray-900 mb-2">
          <%= billingView.emptyState.transactions %>
        </div>

        <div class="text-muted fs-6">Wallet top-ups and shift payments will appear here.</div>
      </div>
      <% } %>
    </div>
  </div>
</div>
