<!-- views/employer/billing/partials/subscription.ejs -->

  <!-- Subscription -->
  <div
    class="card mb-8"
    id="subscription"
    data-subscription-id="<%= billingView.subscription.id || '' %>"
    data-occupied-job-slots="<%= billingView.subscription.occupiedJobSlots || 0 %>"
  >
    <div class="card-header border-0 pt-6">
      <div class="card-title flex-column">
        <h3 class="fw-bold mb-1 fs-2">Employer Subscription</h3>

        <div class="text-muted fs-7">
          Manage your paid employer plan, billing period, and renewal status.
        </div>
      </div>

      <% if (billingView.subscription.hasSubscription) { %>
      <div class="card-toolbar">
        <span class="badge <%= billingView.subscription.statusBadgeClass %>">
          <%= billingView.subscription.statusLabel %>
        </span>
      </div>
      <% } %>
    </div>

    <div class="card-body pt-0">
      <% if (!canManageSubscription) { %>
      <div class="notice d-flex bg-light rounded border border-dashed p-5 mb-6">
        <div class="text-muted fs-7">
          You have read-only access to this subscription.
          Contact the primary employer or a business administrator
          to purchase, renew, change or cancel a plan.
        </div>
      </div>
      <% } %>

      <% if (!billingView.subscription.hasSubscription) { %>
      <div class="notice d-flex bg-light rounded border border-dashed p-6 mb-7">
        <div>
          <div class="fs-5 fw-bold text-gray-900 mb-2">No paid subscription yet</div>

          <div class="text-muted fs-7">
            Choose a plan below. Subscription Job slots are concurrent active publication slots and
            remain available only while the paid subscription period is active.
          </div>
        </div>
      </div>
      <% } else { %>

      <div class="row g-5">
        <div class="col-xl-7">
          <div class="bg-light rounded p-6 h-100">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-5 mb-6">
              <div>
                <div class="text-muted fs-8 fw-semibold mb-1">Current plan</div>

                <div class="fs-2 fw-bold text-gray-900">
                  <%= billingView.subscription.planName || "Subscription" %>
                </div>

                <div class="text-muted fs-7 mt-1">
                  <%= billingView.subscription.priceDisplay %> <% if
                  (billingView.subscription.billingCycle) { %> / <%=
                  billingView.subscription.billingCycle %> <% } %>
                </div>
              </div>

              <div class="text-md-end">
                <div class="text-muted fs-8 fw-semibold mb-1">Reference</div>

                <div class="fw-semibold text-gray-800">
                  <%= billingView.subscription.referenceCode || "-" %>
                </div>
              </div>
            </div>

            <div class="row g-4">
              <div class="col-md-6">
                <div class="border border-dashed rounded p-5 h-100">
                  <div class="text-muted fs-8 fw-semibold mb-2">Active Job slots</div>

                  <div class="fs-2 fw-bold text-gray-900">
                    <%= billingView.subscription.activeJobSlots %>
                  </div>

                  <div class="text-muted fs-8 mt-2">
                    Concurrent subscription-funded Job publications.
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="border border-dashed rounded p-5 h-100">
                  <div class="text-muted fs-8 fw-semibold mb-2">Slots in use</div>

                  <div class="fs-2 fw-bold text-gray-900">
                    <%= billingView.subscription.occupiedJobSlots %> / <%=
                    billingView.subscription.activeJobSlots %>
                  </div>

                  <div class="text-muted fs-8 mt-2">
                    <%= billingView.subscription.remainingJobSlotsLabel %>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="border border-dashed rounded p-5 h-100">
                  <div class="text-muted fs-8 fw-semibold mb-2">Current period ends</div>

                  <div class="fw-bold text-gray-900">
                    <%= billingView.subscription.currentPeriodEndDisplay %>
                  </div>

                  <div class="text-muted fs-8 mt-2">
                    Benefits remain available only through this paid period.
                  </div>
                </div>
              </div>

              <% if (billingView.subscription.basePlatformFeeRate !== null &&
              billingView.subscription.basePlatformFeeRate !== undefined) { %>
              <div class="col-md-6">
                <div class="border border-dashed rounded p-5 h-100">
                  <div class="text-muted fs-8 fw-semibold mb-2">Base platform fee</div>

                  <div class="fs-4 fw-bold text-gray-900">
                    <%= billingView.subscription.basePlatformFeePercentDisplay %>
                  </div>
                </div>
              </div>
              <% } %>

              <div class="col-md-6">
                <div class="border border-dashed rounded p-5 h-100">
                  <div class="text-muted fs-8 fw-semibold mb-2">Billing cycle</div>

                  <div class="fs-4 fw-bold text-gray-900">
                    <%= billingView.subscription.billingCycleDisplay %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-5">
          <div class="border border-dashed rounded p-6 h-100 d-flex flex-column">
            <div class="fw-bold text-gray-900 mb-4">Subscription status</div>

            <div class="d-flex flex-column gap-4">
              <div class="d-flex justify-content-between gap-4">
                <span class="text-muted fs-7">Status</span>

                <span class="badge <%= billingView.subscription.statusBadgeClass %>">
                  <%= billingView.subscription.statusLabel %>
                </span>
              </div>

              <% if (billingView.subscription.currentPeriodStartDisplay !== "-") { %>
              <div class="d-flex justify-content-between gap-4">
                <span class="text-muted fs-7">Period started</span>

                <span class="fw-semibold text-gray-800 text-end fs-7">
                  <%= billingView.subscription.currentPeriodStartDisplay %>
                </span>
              </div>
              <% } %> <% if (billingView.subscription.currentPeriodEndDisplay !== "-") { %>
              <div class="d-flex justify-content-between gap-4">
                <span class="text-muted fs-7">Period ends</span>

                <span class="fw-semibold text-gray-800 text-end fs-7">
                  <%= billingView.subscription.currentPeriodEndDisplay %>
                </span>
              </div>
              <% } %>

              <div class="d-flex justify-content-between gap-4">
                <span class="text-muted fs-7">Renewals completed</span>

                <span class="fw-semibold text-gray-800 fs-7">
                  <%= billingView.subscription.renewalCount %>
                </span>
              </div>
            </div>

            <% if (billingView.subscription.automaticRenewalVisible) { %>
            <div class="mt-6">
              <div class="separator mb-5"></div>

              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-bold text-gray-900">
                  Automatic renewal
                </span>

                <span class="badge <%= billingView.subscription.automaticRenewalEnabled ? 'badge-light-success' : 'badge-light-secondary' %>">
                  <%= billingView.subscription.automaticRenewalEnabled ? 'Enabled' : 'Disabled' %>
                </span>
              </div>

              <div class="text-muted fs-8 mb-3">
                Automatically renew your subscription using your LOQUM
                wallet balance.
              </div>

              <div class="text-muted fs-8 mb-4">
                Disabling automatic renewal does not affect your existing
                paid benefits. You can still renew manually.
              </div>

              <% if (canManageSubscription && (billingView.subscription.automaticRenewalEnabled || billingView.subscription.automaticRenewalCanEnable)) { %>

              <form
                id="kt_subscription_automatic_renewal_form"
                method="POST"
                action="/employer/billing/subscriptions/<%= billingView.subscription.id %>/automatic-renewal"
                data-renewal-price="<%= billingView.subscription.priceDisplay %>"
                data-billing-cycle="<%= billingView.subscription.billingCycleDisplay %>"
              >
                <input
                  type="hidden"
                  name="_csrf"
                  value="<%= csrfToken %>"
                />

                <input
                  type="hidden"
                  name="enabled"
                  value="<%= billingView.subscription.automaticRenewalEnabled ? 'false' : 'true' %>"
                />

                <input
                  type="hidden"
                  name="expectedPriceMinor"
                  value="<%= billingView.subscription.priceMinor %>"
                />

                <input
                  type="hidden"
                  name="expectedCurrency"
                  value="<%= billingView.subscription.currency %>"
                />

                <input
                  type="hidden"
                  name="expectedPlanId"
                  value="<%= billingView.subscription.planId %>"
                />

                <button
                  type="submit"
                  class="btn <%= billingView.subscription.automaticRenewalEnabled ? 'btn-light-danger' : 'btn-light-primary' %> w-100"
                >
                  <span class="indicator-label">
                    <%= billingView.subscription.automaticRenewalEnabled ? 'Disable automatic renewal' : 'Enable automatic renewal' %>
                  </span>

                  <span class="indicator-progress">
                    Please wait...
                    <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                  </span>
                </button>
              </form>

              <% } %>
            </div>
            <% } %>

            <% if (canManageSubscription && billingView.subscription.canRenew) { %>
            <div class="mt-6">
              <div class="separator mb-5"></div>

              <div class="fw-bold text-gray-900 mb-2">Renew current plan</div>

              <div class="text-muted fs-8 mb-4">
                A renewal paid before the current period ends is held for the next billing period
                and does not change current benefits early.
              </div>

              <div class="d-flex flex-column gap-3">
                <form
                  class="js-subscription-renewal-form"
                  data-confirm-price="<%= billingView.subscription.priceDisplay %>"
                  method="POST"
                  action="/employer/billing/subscriptions/<%= billingView.subscription.id %>/renew/wallet"
                  data-payment-flow="wallet"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="idempotencyKey" value="" />
                  <input type="hidden" name="expectedPriceMinor" value="<%= billingView.subscription.priceMinor %>" />
                  <input type="hidden" name="expectedCurrency" value="<%= billingView.subscription.currency %>" />
                  <input type="hidden" name="expectedPlanId" value="<%= billingView.subscription.planId %>" />

                  <button type="submit" class="btn btn-light-primary w-100">
                    <span class="indicator-label">Pay from wallet</span>

                    <span class="indicator-progress">
                      Please wait...
                      <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                  </button>
                </form>

                <form
                  class="js-subscription-renewal-form"
                  data-confirm-price="<%= billingView.subscription.priceDisplay %>"
                  method="POST"
                  action="/employer/billing/subscriptions/<%= billingView.subscription.id %>/renew/initialize-checkout"
                  data-payment-flow="checkout"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="idempotencyKey" value="" />
                  <input type="hidden" name="expectedPriceMinor" value="<%= billingView.subscription.priceMinor %>" />
                  <input type="hidden" name="expectedCurrency" value="<%= billingView.subscription.currency %>" />
                  <input type="hidden" name="expectedPlanId" value="<%= billingView.subscription.planId %>" />

                  <button type="submit" class="btn btn-primary w-100">
                    <span class="indicator-label">Pay with Paystack</span>

                    <span class="indicator-progress">
                      Please wait...
                      <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                  </button>
                </form>
              </div>
            </div>
            <% } %> <% if (canManageSubscription && billingView.subscription.cancellationBlockedByRenewal) { %>
            <div class="mt-6">
              <div class="separator mb-5"></div>

              <div class="notice d-flex bg-light-warning border border-warning border-dashed rounded p-4">
                <div>
                  <div class="fw-bold text-gray-900 fs-7 mb-2">
                    Cancellation temporarily unavailable
                  </div>

                  <div class="text-muted fs-8">
                    <%= billingView.subscription.cancellationRestrictionMessage %>
                  </div>

                  <a
                    href="#subscription-payments"
                    class="fw-semibold fs-8 d-inline-block mt-3"
                  >
                    View subscription payments
                  </a>
                </div>
              </div>
            </div>
            <% } %>

            <% if (canManageSubscription && billingView.subscription.canCancel) { %>
            <div class="mt-auto pt-6">
              <div class="separator mb-5"></div>

              <form
                id="kt_subscription_cancel_form"
                method="POST"
                action="/employer/billing/subscriptions/<%= billingView.subscription.id %>/cancel"
                class="mb-0"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                <button
                  id="kt_subscription_cancel_submit"
                  type="submit"
                  class="btn btn-light-danger w-100"
                >
                  <span class="indicator-label">Cancel at period end</span>

                  <span class="indicator-progress">
                    Please wait...
                    <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                  </span>
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <% if (billingView.subscription.cancellationScheduled) { %>
      <div
        class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-5 mt-6"
      >
        <div>
          <div class="fw-bold text-gray-900 mb-1">Cancellation scheduled</div>

          <div class="text-muted fs-7">
            Your subscription remains active through <%=
            billingView.subscription.currentPeriodEndDisplay %> and will then end.
          </div>
        </div>
      </div>
      <% } %> <% if (billingView.subscription.lifecycleBoundaryPassed) { %>
      <div
        class="notice d-flex bg-light-danger rounded border-danger border border-dashed p-5 mt-6"
      >
        <div>
          <div class="fw-bold text-gray-900 mb-1">Paid period ended</div>

          <div class="text-muted fs-7">
            Subscription benefits are no longer active. Final lifecycle processing may still be
            completing.
          </div>
        </div>
      </div>
      <% } %> <% if (billingView.subscription.pendingPlanChange) { %>
      <div class="notice d-flex bg-light-info rounded border-info border border-dashed p-5 mt-6">
        <div class="w-100">
          <div class="fw-bold text-gray-900 mb-1">Plan change in progress</div>

          <div class="text-muted fs-7">
            Change to
            <span class="fw-semibold text-gray-800">
              <%= billingView.subscription.pendingPlanChange.targetPlanName ||
              billingView.subscription.pendingPlanChange.targetPlanCode || "the selected plan" %>
            </span>
            is awaiting completion.
          </div>

          <% if (billingView.subscription.pendingPlanChange.payment) { %>
          <div class="text-muted fs-8 mt-2">
            Payment:
            <span class="fw-semibold text-gray-800">
              <%= billingView.subscription.pendingPlanChange.payment.paymentStatusLabel %>
            </span>
          </div>
          <% } %>
        </div>
      </div>
      <% } %> <% if (billingView.subscription.outstandingRenewal) { %>
      <div
        class="notice d-flex <%= billingView.subscription.outstandingRenewal.scheduled || billingView.subscription.outstandingRenewal.isPaidUnapplied ? 'bg-light-success border-success' : 'bg-light-warning border-warning' %> rounded border border-dashed p-5 mt-6"
      >
        <div class="w-100">
          <div class="fw-bold text-gray-900 mb-1">
            <% if (billingView.subscription.outstandingRenewal.scheduled) { %> Renewal paid <% }
            else if (billingView.subscription.outstandingRenewal.isPaidUnapplied) { %> Renewal paid,
            applying <% } else { %> Renewal payment in progress <% } %>
          </div>

          <div class="text-muted fs-7">
            <% if (billingView.subscription.outstandingRenewal.scheduled) { %> The next billing
            period has been paid for and will begin at <%=
            billingView.subscription.outstandingRenewal.periodStartDisplay %>. <% } else if
            (billingView.subscription.outstandingRenewal.isPaidUnapplied) { %> Payment is complete
            and is waiting for the billing boundary application step. <% } else { %> The renewal
            payment has not reached a completed paid state yet. <% } %>
          </div>
        </div>
      </div>
      <% } %> <% if (billingView.subscription.storedStatus === "pending" &&
      billingView.subscription.latestPayment) { %>
      <div class="notice d-flex bg-light-info rounded border-info border-dashed p-5 mt-6">
        <div>
          <div class="fw-bold text-gray-900 mb-1">Subscription payment in progress</div>

          <div class="text-muted fs-7">
            Latest payment status:
            <span class="fw-semibold text-gray-800">
              <%= billingView.subscription.latestPayment.paymentStatusLabel %>
            </span>
          </div>
        </div>
      </div>
      <% } %> <% if (!billingView.subscription.active && billingView.subscription.endedAtDisplay !==
      "-") { %>
      <div class="text-muted fs-7 mt-5">
        Subscription ended: <%= billingView.subscription.endedAtDisplay %>
      </div>
      <% } %> <% } %> <% if (canManageSubscription && (!billingView.subscription.hasSubscription ||
      billingView.subscription.canSubscribe)) { %>
      <div class="<%= billingView.subscription.hasSubscription ? 'mt-8' : '' %>">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-4 mb-5">
          <div>
            <div class="fs-4 fw-bold text-gray-900 mb-1">
              <% if (billingView.subscription.hasSubscription) { %> Start a new subscription <% }
              else { %> Choose a plan <% } %>
            </div>

            <div class="text-muted fs-7">
              Each plan provides concurrent active Job slots for the paid billing period.
            </div>
          </div>
        </div>

        <% if (billingView.subscriptionPlans.length === 0) { %>
        <div class="notice d-flex bg-light-warning rounded border-warning border-dashed p-5">
          <div class="text-muted fs-7">No subscription plans are currently available.</div>
        </div>
        <% } else { %>
        <div class="row g-5">
          <% billingView.subscriptionPlans.forEach((plan) => { %>
          <div class="col-xl-4 col-md-6">
            <div class="border border-dashed rounded p-6 h-100 d-flex flex-column">
              <div class="mb-5">
                <div class="fs-4 fw-bold text-gray-900 mb-1"><%= plan.name %></div>

                <% if (plan.description) { %>
                <div class="text-muted fs-8"><%= plan.description %></div>
                <% } %>
              </div>

              <div class="fs-2 fw-bold text-gray-900 mb-1"><%= plan.priceDisplay %></div>

              <div class="text-muted fs-8 mb-5"><%= plan.billingCycleDisplay %></div>

              <div class="d-flex justify-content-between gap-4 mb-3">
                <span class="text-muted fs-8">Active Job slots</span>
                <span class="fw-semibold text-gray-800 fs-8"><%= plan.activeJobSlots %></span>
              </div>

              <% if (plan.basePlatformFeeRate !== null && plan.basePlatformFeeRate !== undefined) {
              %>
              <div class="d-flex justify-content-between gap-4 mb-5">
                <span class="text-muted fs-8">Base platform fee</span>

                <span class="fw-semibold text-gray-800 fs-8">
                  <%= plan.basePlatformFeePercentDisplay %>
                </span>
              </div>
              <% } %>

              <div class="mt-auto d-flex flex-column gap-3">
                <form
                  class="js-subscription-purchase-form"
                  data-confirm-price="<%= plan.priceDisplay %>"
                  method="POST"
                  action="/employer/billing/subscriptions/purchase/wallet"
                  data-payment-flow="wallet"
                  data-plan-id="<%= plan.id %>"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="planId" value="<%= plan.id %>" />
                  <input type="hidden" name="idempotencyKey" value="" />
                  <input type="hidden" name="expectedPriceMinor" value="<%= plan.priceMinor %>" />
                  <input type="hidden" name="expectedCurrency" value="<%= plan.currency %>" />
                  <input type="hidden" name="expectedPlanId" value="<%= plan.id %>" />

                  <button type="submit" class="btn btn-light-primary w-100">
                    <span class="indicator-label">Pay from wallet</span>

                    <span class="indicator-progress">
                      Please wait...
                      <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                  </button>
                </form>

                <form
                  class="js-subscription-purchase-form"
                  data-confirm-price="<%= plan.priceDisplay %>"
                  method="POST"
                  action="/employer/billing/subscriptions/initialize-checkout"
                  data-payment-flow="checkout"
                  data-plan-id="<%= plan.id %>"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="planId" value="<%= plan.id %>" />
                  <input type="hidden" name="idempotencyKey" value="" />
                  <input type="hidden" name="expectedPriceMinor" value="<%= plan.priceMinor %>" />
                  <input type="hidden" name="expectedCurrency" value="<%= plan.currency %>" />
                  <input type="hidden" name="expectedPlanId" value="<%= plan.id %>" />

                  <button type="submit" class="btn btn-primary w-100">
                    <span class="indicator-label">Pay with Paystack</span>

                    <span class="indicator-progress">
                      Please wait...
                      <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                  </button>
                </form>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
      <% } %> <% if (canManageSubscription && billingView.subscription.canChangePlan &&
      billingView.changeableSubscriptionPlans.length > 0) { %>
      <div class="mt-8">
        <div class="fs-4 fw-bold text-gray-900 mb-1">Change plan</div>

        <div class="text-muted fs-7 mb-5">
          A successful plan change replaces the current plan immediately and starts a fresh billing
          period. Unused time or value on the current plan is forfeited.
        </div>

        <div class="row g-5">
          <% billingView.changeableSubscriptionPlans.forEach((plan) => { %>
          <div class="col-xl-4 col-md-6">
            <div class="border border-dashed rounded p-6 h-100 d-flex flex-column">
              <div class="mb-4">
                <div class="fs-5 fw-bold text-gray-900"><%= plan.name %></div>

                <div class="text-muted fs-8 mt-1">
                  <%= plan.priceDisplay %> <% if (plan.billingCycle) { %> / <%= plan.billingCycle %>
                  <% } %>
                </div>
              </div>

              <div class="d-flex justify-content-between gap-4 mb-3">
                <span class="text-muted fs-8">Active Job slots</span>
                <span class="fw-semibold text-gray-800 fs-8"><%= plan.activeJobSlots %></span>
              </div>

              <div class="mt-auto pt-4">
                <button
                  type="button"
                  class="btn btn-light-primary w-100 js-subscription-plan-change"
                  data-bs-toggle="modal"
                  data-bs-target="#kt_subscription_plan_change_modal"
                  data-plan-id="<%= plan.id %>"
                  data-plan-name="<%= plan.name %>"
                  data-plan-price="<%= plan.priceDisplay %>"
                  data-plan-price-minor="<%= plan.priceMinor %>"
                  data-plan-currency="<%= plan.currency %>"
                  data-active-job-slots="<%= plan.activeJobSlots %>"
                >
                  Change to this plan
                </button>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
