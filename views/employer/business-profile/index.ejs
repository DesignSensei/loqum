<!-- views/employer/business-profile/index.ejs -->

<input
  type="hidden"
  id="businessProfileCountryCode"
  value="<%= businessProfilePage.countryCode %>"
/>

<div class="d-flex flex-column flex-xl-row align-items-stretch gap-5 gap-xl-8">
  <!-- Sidebar -->
  <div class="flex-column flex-lg-row-auto w-100 w-xl-325px flex-shrink-0">
    <%- include("./partials/side-menu") %>
  </div>

  <!-- Main content -->
  <div class="flex-grow-1 w-100 min-w-0">
    <% if (businessProfilePage.showOverview) { %> <%- include("./partials/overview") %> <% } %> <%
    if (businessProfilePage.showBusinessDetails) { %> <%- include("./partials/business-details") %>
    <% } %> <% if (businessProfilePage.showVerification) { %> <%- include("./partials/verification")
    %> <% } %> <% if (businessProfilePage.showBranches) { %> <%- include("./partials/branches") %>
    <% } %> <% if (businessProfilePage.showTeamMembers) { %> <%- include("./partials/team-members")
    %> <% } %> <% if (businessProfilePage.showInvites) { %> <%- include("./partials/invites") %> <%
    } %>
    <% if (businessProfilePage.showClosure) { %>
    <section id="businessClosure" class="card mb-5 mb-xl-10"
      data-closure-panel
      data-closure-url="/employer/business-profile/closure"
      data-confirmation="CLOSE MY BUSINESS"
      data-redirect="/account/settings"
      data-execution-enabled="true">
      <input type="hidden" data-closure-csrf value="<%= csrfToken %>" />

      <div class="card-header border-0">
        <div class="card-title m-0">
          <h3 class="fw-bold m-0">Business Closure</h3>
        </div>
      </div>

      <div class="card-body border-top p-9">
        <p class="text-gray-700">Closing your business ends its Loqum operations without closing your personal account.</p>

        <p class="text-muted mb-6">
          Outstanding commitments and payments must be resolved.
          Required historical records will be retained.
          Closure is permanent.
        </p>

        <div class="border rounded p-6 mb-6" aria-live="polite">
          <div class="fw-semibold mb-2" data-closure-status>
            Check your eligibility before requesting closure.
          </div>

          <ul class="mb-0 text-gray-700"
            data-closure-blockers hidden></ul>
        </div>

        <p class="text-muted" data-closure-unavailable>
          Eligibility checks are available. Closure execution is not yet available.
        </p>

        <div class="d-flex flex-wrap gap-3">
          <button type="button"
            class="btn btn-light-primary fw-bold"
            data-closure-check>Check Eligibility</button>

          <button type="button"
            class="btn btn-light-danger fw-bold"
            data-closure-submit disabled>Close Business</button>
        </div>
      </div>
    </section>
    <% } %>
  </div>
</div>

<!-- Branch modals -->

<% if (businessProfilePage.showAddBranchModal) { %> <%- include("./partials/add-branch-modal") %> <%
} %> <% if (businessProfilePage.showViewBranchModal) { %> <%-
include("./partials/view-branch-modal") %> <% } %> <% if (businessProfilePage.showEditBranchModal) {
%> <%- include("./partials/edit-branch-modal") %> <% } %>

<!-- Team member modals -->

<% if (businessProfilePage.showTeamMemberModals) { %> <%- include("./partials/team-member-modals")
%> <% } %>

<!-- Invitation modals -->

<% if (businessProfilePage.showInviteModals) { %> <%- include("./partials/invite-member-modal") %>
<%- include("./partials/edit-invite-modal") %> <% } %>

<!-- Backend-prepared, safely serialized location configuration -->

<script>
  window.locations = <%- locations %>;
</script>
