<!-- views/employer/business-profile/index.ejs -->

<input
  type="hidden"
  id="businessProfileCountryCode"
  value="<%= businessProfilePage.countryCode %>"
/>

<div class="d-flex flex-column flex-xl-row align-items-stretch gap-5 gap-xl-8">
  <!-- Sidebar -->
  <div class="flex-column flex-lg-row-auto w-100 w-xl-325px flex-shrink-0">
    <%- include("./partials/side-menu") %>
  </div>

  <!-- Main content -->
  <div class="flex-grow-1 w-100 min-w-0">
    <% if (businessProfilePage.showOverview) { %> <%- include("./partials/overview") %> <% } %> <%
    if (businessProfilePage.showBusinessDetails) { %> <%- include("./partials/business-details") %>
    <% } %> <% if (businessProfilePage.showVerification) { %> <%- include("./partials/verification")
    %> <% } %> <% if (businessProfilePage.showBranches) { %> <%- include("./partials/branches") %>
    <% } %> <% if (businessProfilePage.showTeamMembers) { %> <%- include("./partials/team-members")
    %> <% } %> <% if (businessProfilePage.showInvites) { %> <%- include("./partials/invites") %> <%
    } %>
  </div>
</div>

<!-- Branch modals -->

<% if (businessProfilePage.showAddBranchModal) { %> <%- include("./partials/add-branch-modal") %> <%
} %> <% if (businessProfilePage.showViewBranchModal) { %> <%-
include("./partials/view-branch-modal") %> <% } %> <% if (businessProfilePage.showEditBranchModal) {
%> <%- include("./partials/edit-branch-modal") %> <% } %>

<!-- Team member modals -->

<% if (businessProfilePage.showTeamMemberModals) { %> <%- include("./partials/team-member-modals")
%> <% } %>

<!-- Invitation modals -->

<% if (businessProfilePage.showInviteModals) { %> <%- include("./partials/invite-member-modal") %>
<%- include("./partials/edit-invite-modal") %> <% } %>

<!-- Backend-prepared, safely serialized location configuration -->

<script>
  window.locations = <%- locations %>;
</script>
