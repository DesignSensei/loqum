<!-- views/employer/business-profile/partials/add-branch-modal.ejs -->

<div
  class="modal fade"
  id="addBranchModal"
  tabindex="-1"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-650px">
    <div class="modal-content rounded">
      <div class="modal-header pb-0 border-0 justify-content-end">
        <button
          type="button"
          class="btn btn-icon btn-sm btn-active-secondary"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="ki-duotone ki-cross fs-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
        </button>
      </div>

      <form method="POST" action="/employer/branches" id="kt_add_branch_form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-5">
          <div class="mb-10 text-center">
            <h1 class="mb-3">Add Branch</h1>

            <div class="text-muted fw-semibold fs-5">
              Add another location under your business account.
            </div>
          </div>

          <div class="fv-row mb-7">
            <label for="addBranchNameInput" class="form-label required"> Branch Name </label>

            <input
              type="text"
              id="addBranchNameInput"
              name="name"
              class="form-control"
              placeholder="Example: Ikeja Branch"
              autocomplete="off"
              maxlength="120"
              required
            />
          </div>

          <div class="row">
            <div class="col-lg-6 fv-row mb-7">
              <label for="addBranchStateSelect" class="form-label required"> State </label>

              <select
                id="addBranchStateSelect"
                name="state"
                class="form-select"
                data-control="select2"
                data-placeholder="Select State"
                data-dropdown-parent="#addBranchModal"
                required
              >
                <option></option>
                <option value="">Select State</option>
              </select>
            </div>

            <div class="col-lg-6 fv-row mb-7">
              <label for="addBranchLgaSelect" class="form-label required"> LGA </label>

              <select
                id="addBranchLgaSelect"
                name="lga"
                class="form-select"
                data-control="select2"
                data-placeholder="Select LGA"
                data-dropdown-parent="#addBranchModal"
                disabled
                required
              >
                <option value="">Select LGA</option>
              </select>
            </div>
          </div>

          <div class="fv-row mb-7">
            <label for="addBranchAddressInput" class="form-label required"> Branch Address </label>

            <input
              type="text"
              id="addBranchAddressInput"
              name="address"
              class="form-control"
              placeholder="Start typing and select a Google address suggestion"
              autocomplete="off"
              maxlength="250"
              required
            />

            <input type="hidden" id="addBranchLatitudeInput" name="latitude" />

            <input type="hidden" id="addBranchLongitudeInput" name="longitude" />

            <input type="hidden" id="addBranchGooglePlaceIdInput" name="googlePlaceId" />

            <div class="form-text">
              Select the correct address from Google's suggestions. Your branch location and
              coordinates will be used for location-based shift clocking.
            </div>
          </div>

          <div class="fv-row mb-7">
            <label for="addBranchPhoneInput" class="form-label"> Branch Contact Phone </label>

            <div class="row g-3">
              <div class="col-4">
                <input
                  type="text"
                  id="addBranchPhoneCodeInput"
                  name="contactPhoneCode"
                  class="form-control"
                  value="<%= employerProfile.businessPhoneCode || '' %>"
                  readonly
                  aria-label="Contact phone country code"
                />
              </div>

              <div class="col-8">
                <input
                  type="tel"
                  id="addBranchPhoneInput"
                  name="contactPhone"
                  class="form-control"
                  placeholder="08012345678"
                  autocomplete="off"
                  maxlength="30"
                />
              </div>
            </div>

            <div class="form-text mt-2">
              Optional. Enter a number only if the branch has a separate contact line.
            </div>
          </div>

          <div
            class="notice d-flex bg-light-info border border-info border-dashed rounded p-5 mb-5"
          >
            <i class="ki-duotone ki-information-5 fs-2x text-info me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <div class="fw-semibold text-gray-700 fs-7">
              Your branch's geofence radius will be set automatically using the platform's
              configured settings. It can be managed separately through the branch editing workflow.
            </div>
          </div>

          <div
            class="notice d-flex bg-light-warning border border-warning border-dashed rounded p-5"
          >
            <i class="ki-duotone ki-shield-tick fs-2x text-warning me-4">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>

            <div class="flex-grow-1">
              <div class="fw-bold text-gray-900 fs-6 mb-2">Facility Permit Verification</div>

              <div class="fw-semibold text-gray-700 fs-7">
                After creating this branch, you can submit the applicable facility operating permits
                for review. Requirements depend on your registered business type and the branch's
                location.

                <div class="mt-2">
                  Creating a branch does not automatically authorise regulated shift posting.
                  Applicable permits must be approved and valid before the branch can be eligible
                  for those activities.
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer d-flex justify-content-center">
          <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

          <button type="submit" id="kt_add_branch_submit" class="btn btn-primary">
            <span class="indicator-label"> Save Branch </span>

            <span class="indicator-progress">
              Please wait...

              <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
