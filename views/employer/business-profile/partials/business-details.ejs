<!-- views/employer/business-profile/partials/business-details.ejs -->

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <h3 class="fw-bold m-0">Business Details</h3>
    </div>
  </div>

  <form id="kt_business_details_form" method="post" action="<%= businessDetailsView.updateUrl %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <input
      type="hidden"
      id="businessDetailsCurrentType"
      value="<%= businessDetailsView.values.type %>"
    />

    <input
      type="hidden"
      id="businessDetailsCurrentContactRole"
      value="<%= businessDetailsView.values.contactRole %>"
    />

    <input
      type="hidden"
      id="businessDetailsCurrentState"
      value="<%= businessDetailsView.values.state %>"
    />

    <input
      type="hidden"
      id="businessDetailsCurrentLga"
      value="<%= businessDetailsView.values.lga %>"
    />

    <input
      type="hidden"
      id="businessDetailsLatitude"
      name="latitude"
      value="<%= businessDetailsView.values.latitude %>"
    />

    <input
      type="hidden"
      id="businessDetailsLongitude"
      name="longitude"
      value="<%= businessDetailsView.values.longitude %>"
    />

    <input
      type="hidden"
      id="businessDetailsGooglePlaceId"
      name="googlePlaceId"
      value="<%= businessDetailsView.values.googlePlaceId %>"
    />

    <div class="card-body">
      <div class="mb-10">
        <h4 class="fw-bold text-gray-900 mb-1">Business Information</h4>
        <div class="text-muted fw-semibold">
          Update your business identity and registration details.
        </div>
      </div>

      <div class="row g-6 mb-8">
        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Business Type</label>
          <select
            class="form-select"
            name="type"
            id="businessTypeSelect"
            data-control="select2"
            data-placeholder="Select business type"
            data-hide-search="true"
          >
            <option value="">Select business type</option>
            <% businessDetailsView.typeOptions.forEach((option) => { %>
            <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Business Name</label>
          <input
            type="text"
            class="form-control"
            name="businessName"
            value="<%= businessDetailsView.values.businessName %>"
            placeholder="Enter business name"
          />
        </div>
      </div>

      <div class="row g-6 mb-8">
        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Business Email</label>
          <input
            type="email"
            class="form-control"
            name="businessEmail"
            value="<%= businessDetailsView.values.businessEmail %>"
            placeholder="business@example.com"
          />
        </div>

        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Business Phone</label>
          <div class="input-group">
            <input
              type="text"
              class="form-control w-90px flex-grow-0"
              name="businessPhoneCode"
              value="<%= businessDetailsView.values.businessPhoneCode %>"
              placeholder="+234"
            />

            <input
              type="text"
              class="form-control"
              name="businessPhone"
              value="<%= businessDetailsView.values.businessPhone %>"
              placeholder="Business phone number"
            />
          </div>
        </div>
      </div>

      <div class="separator separator-dashed my-10"></div>

      <div class="mb-10">
        <h4 class="fw-bold text-gray-900 mb-1">Registration Details</h4>
        <div class="text-muted fw-semibold">
          Changing registration details may return verification status to pending.
        </div>
      </div>

      <div class="row g-6 mb-8">
        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">CAC Registration Number</label>
          <input
            type="text"
            class="form-control"
            name="cacRegistrationNumber"
            value="<%= businessDetailsView.values.cacRegistrationNumber %>"
            placeholder="Example: RC1234567"
          />
        </div>

        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Regulatory Registration Number</label>
          <input
            type="text"
            class="form-control"
            name="regulatoryRegistrationNumber"
            value="<%= businessDetailsView.values.regulatoryRegistrationNumber %>"
            placeholder="Enter facility/regulatory number"
          />
        </div>
      </div>

      <div class="row g-6 mb-8">
        <div class="col-md-6">
          <label class="form-label fw-bold">Derived Regulatory Body</label>
          <input
            type="text"
            class="form-control bg-light"
            id="businessDetailsRegulatoryBodyDisplay"
            value="<%= businessDetailsView.values.regulatoryBodyLabel %>"
            readonly
          />

          <div class="form-text">
            This is derived automatically from the selected business type.
          </div>
        </div>
      </div>

      <div class="separator separator-dashed my-10"></div>

      <div class="mb-10">
        <h4 class="fw-bold text-gray-900 mb-1">Business Location</h4>
        <div class="text-muted fw-semibold">
          Select a valid address from Google suggestions so coordinates can be saved.
        </div>
      </div>

      <div class="row g-6 mb-8">
        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">State</label>
          <select
            class="form-select"
            name="state"
            id="businessDetailsStateSelect"
            data-control="select2"
            data-placeholder="Select state"
          >
            <option value="">Select state</option>
          </select>
        </div>

        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">LGA</label>
          <select
            class="form-select"
            name="lga"
            id="businessDetailsLgaSelect"
            data-control="select2"
            data-placeholder="Select LGA"
          >
            <option value="">Select LGA</option>
          </select>
        </div>
      </div>

      <div class="mb-8 fv-row">
        <label class="form-label fw-bold required">Business Address</label>
        <input
          type="text"
          class="form-control"
          id="businessDetailsAddressInput"
          name="address"
          value="<%= businessDetailsView.values.address %>"
          placeholder="Start typing business address"
          autocomplete="off"
        />
      </div>

      <div class="separator separator-dashed my-10"></div>

      <div class="mb-10">
        <h4 class="fw-bold text-gray-900 mb-1">Contact Person</h4>
        <div class="text-muted fw-semibold">
          This is the main contact person for employer communication.
        </div>
      </div>

      <div class="row g-6 mb-8">
        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">First Name</label>
          <input
            type="text"
            class="form-control"
            name="contactFirstName"
            value="<%= businessDetailsView.values.contactFirstName %>"
            placeholder="Contact first name"
          />
        </div>

        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Last Name</label>
          <input
            type="text"
            class="form-control"
            name="contactLastName"
            value="<%= businessDetailsView.values.contactLastName %>"
            placeholder="Contact last name"
          />
        </div>
      </div>

      <div class="row g-6 mb-8">
        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Contact Role</label>
          <select
            class="form-select"
            name="contactRole"
            id="contactRoleSelect"
            data-control="select2"
            data-placeholder="Select contact role"
            data-hide-search="true"
          >
            <option value="">Select contact role</option>
            <% businessDetailsView.contactRoleOptions.forEach((option) => { %>
            <option value="<%= option.value %>"><%= option.label %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-6 fv-row">
          <label class="form-label fw-bold required">Contact Phone</label>
          <div class="input-group">
            <input
              type="text"
              class="form-control w-90px flex-grow-0"
              name="contactPhoneCode"
              value="<%= businessDetailsView.values.contactPhoneCode %>"
              placeholder="+234"
            />

            <input
              type="text"
              class="form-control"
              name="contactPhone"
              value="<%= businessDetailsView.values.contactPhone %>"
              placeholder="Contact phone number"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="card-footer d-flex justify-content-end">
      <button type="submit" id="kt_business_details_submit" class="btn btn-primary">
        <span class="indicator-label">Save Changes</span>
        <span class="indicator-progress">
          Please wait...
          <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
        </span>
      </button>
    </div>
  </form>
</div>
