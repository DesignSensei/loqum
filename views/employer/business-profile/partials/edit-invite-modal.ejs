<!-- views/employer/business-profile/partials/edit-invite-modal.ejs -->

<div
  class="modal fade"
  id="editInviteModal"
  tabindex="-1"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-650px">
    <div class="modal-content rounded">
      <div class="modal-header pb-0 border-0 justify-content-end">
        <button
          type="button"
          class="btn btn-icon btn-sm btn-active-secondary"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="ki-duotone ki-cross fs-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
        </button>
      </div>

      <form method="POST" action="" id="kt_edit_invite_form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="inviteId" id="editInviteIdInput" />

        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-5">
          <div class="mb-13 text-center">
            <h1 class="mb-3">Edit Invite</h1>
            <div class="text-muted fw-semibold fs-5">
              Update invite details and resend a fresh invite link.
            </div>
          </div>

          <div class="fv-row mb-7">
            <label class="form-label required">Email Address</label>

            <input
              type="email"
              name="email"
              id="editInviteEmailInput"
              class="form-control"
              placeholder="name@example.com"
              autocomplete="off"
            />

            <div class="form-text">
              If you correct the email, the old invite link will be invalidated.
            </div>
          </div>

          <div class="fv-row mb-7">
            <label class="form-label required">Access Role</label>

            <select
              name="role"
              id="editInviteRoleSelect"
              class="form-select"
              data-control="select2"
              data-placeholder="Select role"
              data-dropdown-parent="#editInviteModal"
            >
              <option></option>
              <option value="admin">Admin</option>
              <option value="branch_manager">Branch Manager</option>
              <option value="branch_staff">Branch Staff</option>
            </select>
          </div>

          <div class="fv-row mb-7 d-none" id="editInviteBranchField">
            <label class="form-label required">Branch</label>

            <select
              name="branchId"
              id="editInviteBranchSelect"
              class="form-select"
              data-control="select2"
              data-placeholder="Select branch"
              data-dropdown-parent="#editInviteModal"
              disabled
            >
              <option></option>

              <% if (typeof branches !== "undefined" && branches && branches.length > 0) { %> <%
              branches.forEach((branch) => { %>
              <option value="<%= branch._id %>"><%= branch.name %></option>
              <% }) %> <% } %>
            </select>

            <div class="form-text">Required for branch managers and branch staff.</div>
          </div>

          <div
            class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-6"
          >
            <i class="ki-duotone ki-information-5 fs-2tx text-warning me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <div class="d-flex flex-stack flex-grow-1">
              <div class="fw-semibold">
                <div class="fs-6 text-gray-700">
                  Saving this form will resend the invite. If the email changed, a new invite token
                  will be generated for security.
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer d-flex justify-content-center">
          <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

          <button type="submit" id="kt_edit_invite_submit" class="btn btn-primary">
            <span class="indicator-label">Save & Resend</span>

            <span class="indicator-progress">
              Please wait...
              <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
