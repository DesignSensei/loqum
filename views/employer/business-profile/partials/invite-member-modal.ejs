<!-- views/employer/business-profile/partials/invite-member-modal.ejs -->

<div
  class="modal fade"
  id="inviteMemberModal"
  tabindex="-1"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable mw-650px">
    <div class="modal-content rounded">
      <div class="modal-header pb-0 border-0 justify-content-end">
        <button
          type="button"
          class="btn btn-icon btn-sm btn-active-secondary"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="ki-duotone ki-cross fs-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
        </button>
      </div>

      <form
        method="POST"
        action="/employer/business-profile/invites"
        id="kt_invite_member_form"
        novalidate
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-5">
          <div class="mb-13 text-center">
            <h1 class="mb-3">Send Team Invite</h1>
            <div class="text-muted fw-semibold fs-5">
              Invite a team member to access this business account.
            </div>
          </div>

          <div class="fv-row mb-7">
            <label class="form-label required">Email Address</label>

            <input
              type="email"
              name="email"
              class="form-control"
              placeholder="name@example.com"
              autocomplete="off"
            />

            <div class="form-text">The invite link will be sent to this email address.</div>
          </div>

          <div class="fv-row mb-7">
            <label class="form-label required">Access Role</label>

            <select
              name="role"
              id="inviteRoleSelect"
              class="form-select"
              data-control="select2"
              data-placeholder="Select role"
              data-dropdown-parent="#inviteMemberModal"
            >
              <option></option>
              <option value="admin">Admin</option>
              <option value="branch_manager">Branch Manager</option>
              <option value="branch_staff">Branch Staff</option>
            </select>

            <div class="form-text">
              Admins get business-wide access. Branch roles are tied to a specific branch.
            </div>
          </div>

          <div class="fv-row mb-7 d-none" id="inviteBranchField">
            <label class="form-label required">Branch</label>

            <select
              name="branchId"
              id="inviteBranchSelect"
              class="form-select"
              data-control="select2"
              data-placeholder="Select branch"
              data-dropdown-parent="#inviteMemberModal"
              disabled
            >
              <option></option>

              <% if (typeof branches !== "undefined" && branches && branches.length > 0) { %> <%
              branches.forEach((branch) => { %>
              <option value="<%= branch._id %>"><%= branch.name %></option>
              <% }) %> <% } %>
            </select>

            <div class="form-text">Required for branch managers and branch staff.</div>
          </div>

          <div
            class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6"
          >
            <i class="ki-duotone ki-information-5 fs-2tx text-primary me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <div class="d-flex flex-stack flex-grow-1">
              <div class="fw-semibold">
                <div class="fs-6 text-gray-700">
                  If this email already has a pending invite for this business, the existing invite
                  will be updated and resent instead of creating a duplicate.
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer d-flex justify-content-center">
          <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>

          <button type="submit" id="kt_invite_member_submit" class="btn btn-primary">
            <span class="indicator-label">Send Invite</span>

            <span class="indicator-progress">
              Please wait...
              <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
