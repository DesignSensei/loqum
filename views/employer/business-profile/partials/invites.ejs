<!-- views/employer/business-profile/partials/invites.ejs -->

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <h3 class="fw-bold m-0">Invites</h3>
    </div>

    <div class="card-toolbar d-flex align-items-center gap-3">
      <button
        type="button"
        class="btn btn-sm btn-light btn-active-light-primary"
        data-kt-menu-trigger="click"
        data-kt-menu-placement="bottom-end"
      >
        <i class="ki-duotone ki-filter fs-3">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>
        <%= inviteView.activeFilterLabel || "Active" %>
        <i class="ki-duotone ki-down fs-5 ms-1"></i>
      </button>

      <div
        class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-175px py-3"
        data-kt-menu="true"
      >
        <% inviteView.filters.forEach((filter) => { %>
        <div class="menu-item px-3">
          <a href="<%= filter.url %>" class="menu-link px-3 <%= filter.isActive ? 'active' : '' %>">
            <span class="menu-title"><%= filter.label %></span>

            <% if (filter.isActive) { %>
            <span class="menu-icon ms-auto">
              <i class="ki-duotone ki-check fs-4">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </span>
            <% } %>
          </a>
        </div>
        <% }) %>
      </div>

      <button
        type="button"
        class="btn btn-sm btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#inviteMemberModal"
      >
        <i class="ki-duotone ki-plus fs-2"></i>
        Send Invite
      </button>
    </div>
  </div>

  <div class="card-body">
    <% if (inviteView.rows && inviteView.rows.length > 0) { %>
    <div class="table-responsive">
      <table class="table align-middle table-row-dashed fs-6 gy-5">
        <thead>
          <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">
            <th>Email</th>
            <th>Role</th>
            <th>Branch</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>

        <tbody class="fw-semibold text-gray-700">
          <% inviteView.rows.forEach((invite) => { %>
          <tr>
            <td>
              <div class="fw-bold text-gray-800"><%= invite.email %></div>
            </td>

            <td>
              <span class="badge badge-light-primary"> <%= invite.roleLabel %> </span>
            </td>

            <td>
              <span class="text-gray-700"> <%= invite.branchName %> </span>
            </td>

            <td>
              <span class="badge <%= invite.statusBadgeClass %>"> <%= invite.statusLabel %> </span>
            </td>

            <td class="text-end">
              <% if (invite.canModify) { %>
              <button
                type="button"
                class="btn btn-sm btn-light btn-active-light-primary"
                data-kt-menu-trigger="click"
                data-kt-menu-placement="bottom-end"
              >
                Actions
                <i class="ki-duotone ki-down fs-5 ms-1"></i>
              </button>

              <div
                class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-150px py-3"
                data-kt-menu="true"
              >
                <div class="menu-item px-3">
                  <a
                    href="#"
                    class="menu-link px-3 js-resend-invite"
                    data-invite-id="<%= invite.id %>"
                    data-invite-email="<%= invite.email %>"
                  >
                    Resend
                  </a>
                </div>

                <div class="menu-item px-3">
                  <a
                    href="#"
                    class="menu-link px-3 js-edit-invite"
                    data-bs-toggle="modal"
                    data-bs-target="#editInviteModal"
                    data-invite-id="<%= invite.id %>"
                    data-invite-email="<%= invite.email %>"
                    data-invite-role="<%= invite.role %>"
                    data-invite-branch-id="<%= invite.branchId %>"
                  >
                    Edit
                  </a>
                </div>

                <div class="menu-item px-3">
                  <a
                    href="#"
                    class="menu-link px-3 text-danger js-revoke-invite"
                    data-invite-id="<%= invite.id %>"
                    data-invite-email="<%= invite.email %>"
                  >
                    Delete
                  </a>
                </div>
              </div>
              <% } else { %>
              <span class="text-muted fs-7">No Actions</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-10">
      <div class="fw-bold fs-5 text-gray-800 mb-2">No Invites Found</div>
      <div class="text-muted fw-semibold"><%= inviteView.emptyMessage %></div>
    </div>
    <% } %>
  </div>
</div>
