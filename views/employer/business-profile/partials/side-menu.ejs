<!-- views/employer/business-profile/partials/side-menu.ejs -->

<div class="card mb-5 mb-xl-8">
  <div class="card-body pt-12">
    <div class="d-flex flex-center flex-column mb-8">
      <div class="symbol symbol-100px symbol-circle mb-7">
        <span class="symbol-label bg-light-primary text-primary fw-bold fs-1">
          <%= businessProfileSummary.initials %>
        </span>
      </div>

      <a
        href="/employer/business-profile"
        class="fs-3 text-gray-800 text-hover-primary fw-bold mb-1 text-center"
      >
        <%= businessProfileSummary.businessName %>
      </a>

      <div class="fs-6 fw-semibold text-muted text-center mb-3">
        <%= businessProfileSummary.businessEmail %>
      </div>

      <div>
        <span class="badge badge-light-primary fw-bold">
          <%= businessProfileSummary.accountStatus %>
        </span>
      </div>
    </div>

    <div class="d-flex flex-wrap flex-center mb-8">
      <div class="border border-gray-300 border-dashed rounded py-3 px-4 mx-2 mb-3">
        <div class="fs-4 fw-bold text-gray-800 text-center">
          <%= businessProfileSummary.totalBranches %>
        </div>
        <div class="fw-semibold text-muted">Branches</div>
      </div>

      <div class="border border-gray-300 border-dashed rounded py-3 px-4 mx-2 mb-3">
        <div class="fs-4 fw-bold text-gray-800 text-center">
          <%= businessProfileSummary.totalMembers %>
        </div>
        <div class="fw-semibold text-muted">Members</div>
      </div>
    </div>

    <div class="separator separator-dashed my-5"></div>

    <div class="menu menu-column menu-rounded fw-semibold fs-6 business-profile-side-menu">
      <div class="menu-item">
        <a
          class="menu-link px-4 py-3 <%= activeTab === 'overview' ? 'active bg-light-primary' : '' %>"
          href="/employer/business-profile?tab=overview"
        >
          <span class="menu-icon">
            <i class="ki-duotone ki-element-11 fs-2">
              <span class="path1"></span><span class="path2"></span><span class="path3"></span
              ><span class="path4"></span>
            </i>
          </span>
          <span class="menu-title">Overview</span>
        </a>
      </div>

      <div class="menu-item">
        <a
          class="menu-link px-4 py-3 <%= activeTab === 'business-details' ? 'active bg-light-primary' : '' %>"
          href="/employer/business-profile?tab=business-details"
        >
          <span class="menu-icon">
            <i class="ki-duotone ki-briefcase fs-2">
              <span class="path1"></span><span class="path2"></span>
            </i>
          </span>
          <span class="menu-title">Business Details</span>
        </a>
      </div>

      <div class="menu-item">
        <a
          class="menu-link px-4 py-3 <%= activeTab === 'verification' ? 'active bg-light-primary' : '' %>"
          href="/employer/business-profile?tab=verification"
        >
          <span class="menu-icon">
            <i class="ki-duotone ki-shield-tick fs-2">
              <span class="path1"></span><span class="path2"></span>
            </i>
          </span>
          <span class="menu-title">Verification</span>
        </a>
      </div>

      <div class="menu-item">
        <a
          class="menu-link px-4 py-3 <%= activeTab === 'branches' ? 'active bg-light-primary' : '' %>"
          href="/employer/business-profile?tab=branches"
        >
          <span class="menu-icon">
            <i class="ki-duotone ki-geolocation fs-2">
              <span class="path1"></span><span class="path2"></span>
            </i>
          </span>
          <span class="menu-title">Branches</span>
        </a>
      </div>

      <div class="menu-item">
        <a
          class="menu-link px-4 py-3 <%= activeTab === 'team' ? 'active bg-light-primary' : '' %>"
          href="/employer/business-profile?tab=team"
        >
          <span class="menu-icon">
            <i class="ki-duotone ki-people fs-2">
              <span class="path1"></span><span class="path2"></span><span class="path3"></span
              ><span class="path4"></span><span class="path5"></span>
            </i>
          </span>
          <span class="menu-title">Team Members</span>
        </a>
      </div>

      <div class="menu-item">
        <a
          class="menu-link px-4 py-3 <%= activeTab === 'invites' ? 'active bg-light-primary' : '' %>"
          href="/employer/business-profile?tab=invites"
        >
          <span class="menu-icon">
            <i class="ki-duotone ki-user-tick fs-2">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>
          </span>

          <span class="menu-title">Invites</span>

          <% if (businessProfileSummary.pendingInvites > 0) { %>
          <span class="badge badge-light-warning ms-auto">
            <%= businessProfileSummary.pendingInvites %>
          </span>
          <% } %>
        </a>
      </div>
    </div>
  </div>
</div>
