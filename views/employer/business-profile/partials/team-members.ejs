<!-- views/employer/business-profile/partials/team-members.ejs -->

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <h3 class="fw-bold m-0">Team Members</h3>
    </div>

    <div class="card-toolbar d-flex align-items-center gap-3">
      <% if (memberStatusView && memberStatusView.filters && memberStatusView.filters.length > 0) {
      %>
      <button
        type="button"
        class="btn btn-sm btn-light btn-active-light-primary"
        data-kt-menu-trigger="click"
        data-kt-menu-placement="bottom-end"
      >
        <i class="ki-duotone ki-filter fs-3">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>
        <%= memberStatusView.activeFilterLabel || "Active" %>
        <i class="ki-duotone ki-down fs-5 ms-1"></i>
      </button>

      <div
        class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-200px py-3"
        data-kt-menu="true"
      >
        <% memberStatusView.filters.forEach((filter) => { %>
        <div class="menu-item px-3">
          <a href="<%= filter.url %>" class="menu-link px-3 <%= filter.isActive ? 'active' : '' %>">
            <span class="menu-title"><%= filter.label %></span>

            <% if (filter.isActive) { %>
            <span class="menu-icon ms-auto">
              <i class="ki-duotone ki-check fs-4">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </span>
            <% } %>
          </a>
        </div>
        <% }) %>
      </div>
      <% } %>

      <a href="/employer/business-profile?tab=invites" class="btn btn-sm btn-light-primary">
        Invite Member
      </a>
    </div>
  </div>

  <div class="card-body">
    <% if (members && members.length > 0) { %>
    <div class="table-responsive">
      <table class="table align-middle table-row-dashed fs-6 gy-5">
        <thead>
          <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>

        <tbody class="fw-semibold text-gray-700">
          <% members.forEach((member) => { %>
          <tr>
            <td><%= member.name || "-" %></td>

            <td><%= member.email || "-" %></td>

            <td>
              <span class="badge <%= member.roleBadgeClass || 'badge-light-primary' %>">
                <%= member.roleLabel || "-" %>
              </span>
            </td>

            <td>
              <span class="badge <%= member.statusBadgeClass || 'badge-light-success' %>">
                <%= member.statusLabel || "Active" %>
              </span>
            </td>

            <td class="text-end">
              <% if (member.canView || member.canEdit || member.canRemove) { %>
              <button
                type="button"
                class="btn btn-sm btn-light btn-active-light-primary"
                data-kt-menu-trigger="click"
                data-kt-menu-placement="bottom-end"
              >
                Actions
                <i class="ki-duotone ki-down fs-5 ms-1"></i>
              </button>

              <div
                class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-150px py-3"
                data-kt-menu="true"
              >
                <% if (member.canView) { %>
                <div class="menu-item px-3">
                  <a
                    href="#"
                    class="menu-link px-3 js-view-team-member"
                    data-bs-toggle="modal"
                    data-bs-target="#viewTeamMemberModal"
                    data-member-id="<%= member._id %>"
                    data-member-url="<%= member.viewUrl %>"
                  >
                    View
                  </a>
                </div>
                <% } %> <% if (member.canEdit) { %>
                <div class="menu-item px-3">
                  <a
                    href="#"
                    class="menu-link px-3 js-edit-team-member"
                    data-bs-toggle="modal"
                    data-bs-target="#editTeamMemberModal"
                    data-member-id="<%= member._id %>"
                    data-member-url="<%= member.viewUrl %>"
                    data-update-url="<%= member.updateUrl %>"
                  >
                    Edit
                  </a>
                </div>
                <% } %> <% if (member.canRemove) { %>
                <div class="menu-item px-3">
                  <a
                    href="#"
                    class="menu-link px-3 text-danger js-remove-team-member"
                    data-bs-toggle="modal"
                    data-bs-target="#removeTeamMemberModal"
                    data-member-id="<%= member._id %>"
                    data-member-name="<%= member.name || '-' %>"
                    data-member-email="<%= member.email || '-' %>"
                    data-remove-url="<%= member.removeUrl %>"
                  >
                    Remove
                  </a>
                </div>
                <% } %>
              </div>
              <% } else { %>
              <span class="text-muted fs-7">No Actions</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-10">
      <div class="fw-bold fs-5 text-gray-800 mb-2">No Team Members Found</div>
      <div class="text-muted fw-semibold">Team members matching this filter will appear here.</div>
    </div>
    <% } %>
  </div>
</div>
