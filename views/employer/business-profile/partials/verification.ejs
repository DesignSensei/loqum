<!-- views/employer/business-profile/partials/verification.ejs -->

<!-- ───────────────────── VERIFICATION OVERVIEW ───────────────────── -->

<div class="card mb-8">
  <div class="card-header">
    <div class="card-title">
      <h3 class="fw-bold m-0">Verification</h3>
    </div>
  </div>

  <div class="card-body">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-6">
      <div class="flex-grow-1">
        <h4 class="fw-bold text-gray-900 mb-2">Business Verification Status</h4>

        <div class="text-muted fw-semibold">
          View the registration information submitted during onboarding and track your CAC
          verification, facility registration, employer approval, and account status.
        </div>
      </div>

      <% if (verificationView.supportMessage) { %>
      <div class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-5">
        <i class="ki-duotone ki-information-5 fs-2tx text-primary me-4">
          <span class="path1"></span>
          <span class="path2"></span>
          <span class="path3"></span>
        </i>

        <div class="fw-semibold text-gray-700"><%= verificationView.supportMessage %></div>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ───────────────────── VERIFICATION CARDS ───────────────────── -->

<div class="row g-6 g-xl-8">
  <% verificationView.items.forEach((item) => { %> <% const details = Array.isArray(item.details) ?
  item.details : []; %>

  <div class="col-md-6">
    <div class="card card-flush h-100">
      <div class="card-body d-flex flex-column">
        <!-- Verification heading and status -->
        <div class="d-flex align-items-start justify-content-between gap-4 mb-6">
          <div class="d-flex align-items-start">
            <div class="symbol symbol-45px me-4 flex-shrink-0">
              <span class="symbol-label bg-light-primary">
                <i class="ki-duotone ki-shield-tick fs-2 text-primary">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
              </span>
            </div>

            <div>
              <div class="fs-5 fw-bold text-gray-900"><%= item.title %></div>

              <div class="fs-7 fw-semibold text-muted mt-1"><%= item.description %></div>
            </div>
          </div>

          <span class="badge <%= item.badgeClass %> flex-shrink-0"> <%= item.statusLabel %> </span>
        </div>

        <!-- Registration details -->
        <% if (details.length > 0) { %>

        <div class="bg-light rounded p-5 mb-5">
          <% details.forEach((detail, index) => { %>

          <div
            class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-2 <%= index < details.length - 1 ? 'mb-4' : '' %>"
          >
            <div class="fs-7 fw-semibold text-muted"><%= detail.label %></div>

            <div class="fs-6 fw-bold text-gray-900 text-break text-sm-end"><%= detail.value %></div>
          </div>

          <% }) %>

          <!-- Submitted registration details are read-only -->
          <% if (item.identifierLocked) { %>

          <div class="separator separator-dashed my-4"></div>

          <div class="d-flex align-items-center gap-2 text-muted">
            <i class="ki-duotone ki-lock fs-5">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <span class="fs-7 fw-semibold">
              Registration details are locked after submission.
            </span>
          </div>

          <% } %>
        </div>

        <% } %>

        <!-- Verification date -->
        <% if (item.dateValue) { %>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-5">
          <span class="fs-7 fw-semibold text-muted"> <%= item.dateLabel %> </span>

          <span class="fs-7 fw-semibold text-gray-800"> <%= item.dateValue %> </span>
        </div>

        <% } %>

        <!-- Verification feedback -->
        <% if (item.note) { %>

        <div
          class="notice d-flex bg-light rounded border-gray-300 border border-dashed p-4 mt-auto"
        >
          <i class="ki-duotone ki-message-text-2 fs-2 text-gray-600 me-3">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          <div class="fw-semibold text-gray-700 text-break"><%= item.note %></div>
        </div>

        <% } else { %>

        <div class="fs-7 fw-semibold text-muted mt-auto">
          No additional verification feedback is available.
        </div>

        <% } %>
      </div>
    </div>
  </div>

  <% }) %>
</div>

<!-- ───────────────────── BUSINESS DETAILS ───────────────────── -->

<div class="card mt-8">
  <div
    class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-5"
  >
    <div class="flex-grow-1">
      <h4 class="fw-bold text-gray-900 mb-2">Business Details</h4>

      <div class="text-muted fw-semibold">
        <% if (employerContext.canManageBusinessProfile) { %> You can update permitted business
        contact information from the Business Details tab. Registered business identity and
        regulatory registration details are protected. Contact Loqum Support if these details need
        to be corrected. <% } else { %> You can view the business information associated with this
        account. Only authorised business owners and administrators can update permitted business
        details. <% } %>
      </div>
    </div>

    <a
      href="/employer/business-profile?tab=business-details"
      class="btn btn-light-primary flex-shrink-0"
    >
      <% if (employerContext.canManageBusinessProfile) { %> Manage Business Details <% } else { %>
      View Business Details <% } %>
    </a>
  </div>
</div>
