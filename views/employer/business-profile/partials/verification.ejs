<!-- views/employer/business-profile/partials/verification.ejs -->

<div class="card mb-8">
  <div class="card-header">
    <div class="card-title">
      <h3 class="fw-bold m-0">Verification</h3>
    </div>
  </div>

  <div class="card-body">
    <h4 class="fw-bold text-gray-900 mb-2">Business and Facility Verification</h4>

    <p class="text-muted fw-semibold mb-4">
      CAC confirms your registered business identity. Facility permits are assessed independently
      for each branch and its current premises.
    </p>

    <% if (verificationView.supportMessage) { %>
    <div class="notice d-flex bg-light-primary border border-primary border-dashed rounded p-5">
      <i class="ki-duotone ki-information-5 fs-2 text-primary me-4"></i>
      <span class="fw-semibold text-gray-700"> <%= verificationView.supportMessage %> </span>
    </div>
    <% } %>
  </div>
</div>

<h4 class="fw-bold text-gray-900 mb-4">CAC Registration</h4>

<div class="card card-flush mb-8">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-5">
      <div>
        <h5 class="fw-bold text-gray-900 mb-1"><%= verificationView.cac.title %></h5>
        <div class="text-muted fw-semibold"><%= verificationView.cac.description %></div>
      </div>

      <span class="badge <%= verificationView.cac.badgeClass %>">
        <%= verificationView.cac.statusLabel %>
      </span>
    </div>

    <div class="bg-light rounded p-5 mb-5">
      <% verificationView.cac.details.forEach(function (detail) { %>
      <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-3">
        <span class="text-muted fw-semibold"> <%= detail.label %> </span>
        <span class="fw-bold text-gray-900 text-break"> <%= detail.value %> </span>
      </div>
      <% }); %> <% if (verificationView.cac.identifierLocked) { %>
      <div class="separator separator-dashed my-4"></div>
      <div class="text-muted fw-semibold">
        <i class="ki-duotone ki-lock me-2"></i>
        <%= verificationView.cac.identityNotice %>
      </div>
      <% } %>
    </div>

    <% if (verificationView.cac.dateValue) { %>
    <div class="d-flex justify-content-between gap-3 mb-4">
      <span class="text-muted"> <%= verificationView.cac.dateLabel %> </span>
      <span class="fw-semibold"> <%= verificationView.cac.dateValue %> </span>
    </div>
    <% } %> <% if (verificationView.cac.note) { %>
    <div class="notice bg-light rounded p-4 text-gray-700 fw-semibold">
      <%= verificationView.cac.note %>
    </div>
    <% } %>
  </div>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-4 mb-5">
  <div>
    <h4 class="fw-bold text-gray-900 mb-2">Branch Facility Permits</h4>

    <div class="text-muted fw-semibold">
      Each branch must meet its own regulatory requirements before new shifts or permanent Jobs can
      be published from that branch.
    </div>
  </div>

  <% if (verificationView.canViewBranches) { %>
  <a href="/employer/business-profile?tab=branches" class="btn btn-light-primary">
    View Branches
  </a>
  <% } %>
</div>

<% if (verificationView.hasBranches) { %>
<div class="row g-6 g-xl-8">
  <% verificationView.branches.forEach(function (branch) { %>
  <div class="col-md-6">
    <div class="card card-flush h-100">
      <div class="card-body d-flex flex-column">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
          <div>
            <h5 class="fw-bold text-gray-900 mb-1"><%= branch.title %></h5>
            <div class="text-muted fw-semibold"><%= branch.description %></div>
          </div>

          <span class="badge <%= branch.badgeClass %>"> <%= branch.statusLabel %> </span>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
          <span class="text-muted fw-semibold"> Branch status: </span>

          <span class="badge <%= branch.branchStatusBadgeClass %>">
            <%= branch.branchStatusLabel %>
          </span>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 mb-5">
          <span class="text-muted fw-semibold"> Facility permit readiness: </span>

          <span class="badge <%= branch.regulatoryReadinessBadgeClass %>">
            <%= branch.regulatoryReadinessLabel %>
          </span>
        </div>

        <% if (branch.hasDetails) { %>
        <div class="bg-light rounded p-5 mb-5">
          <h6 class="fw-bold text-gray-900 mb-3">Applicable Permit Requirements</h6>

          <% branch.details.forEach(function (detail) { %>
          <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
            <span class="text-muted fw-semibold"> <%= detail.label %> </span>

            <span class="fw-bold text-gray-900"> <%= detail.value %> </span>
          </div>
          <% }); %>
        </div>
        <% } %> <% if (branch.showRequirementsUnavailable) { %>
        <div class="bg-light rounded p-5 mb-5 text-muted fw-semibold">
          No applicable facility permit requirements are available for display.
        </div>
        <% } %> <% if (branch.note) { %>
        <div class="notice bg-light rounded p-4 fw-semibold text-gray-700 mt-auto">
          <%= branch.note %>
        </div>
        <% } %> <% if (branch.operationalNotice) { %>
        <p class="text-muted fw-semibold mt-4 mb-0"><%= branch.operationalNotice %></p>
        <% } %> <% if (branch.showManagePermitsAction) { %>
        <a href="<%= branch.managePermitsUrl %>" class="btn btn-light-primary mt-5">
          Manage Permits
        </a>
        <% } %>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<% } else { %>
<div class="card card-flush">
  <div class="card-body py-10 text-center">
    <h4 class="fw-bold text-gray-900 mb-3">No Branch Permit Information Available</h4>

    <div class="text-muted fw-semibold">
      <% if (verificationView.canViewBranches) { %> Permit information will appear here for branches
      available to your account. <% } else { %> Your account does not have permission to view branch
      permit details. <% } %>
    </div>
  </div>
</div>
<% } %>

<div class="card mt-8">
  <div
    class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-5"
  >
    <div class="flex-grow-1">
      <h4 class="fw-bold text-gray-900 mb-2">Business Details</h4>

      <% if (verificationView.canManageBusinessDetails) { %>
      <div class="text-muted fw-semibold">
        Update permitted business contact details from the Business Details tab. Registered identity
        fields remain protected.
      </div>
      <% } else { %>
      <div class="text-muted fw-semibold">
        View business details. Only authorized owners and administrators may edit them.
      </div>
      <% } %>
    </div>

    <a href="/employer/business-profile?tab=business-details" class="btn btn-light-primary">
      <% if (verificationView.canManageBusinessDetails) { %> Manage Business Details <% } else { %>
      View Business Details <% } %>
    </a>
  </div>
</div>
