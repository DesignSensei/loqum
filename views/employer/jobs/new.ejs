
<!-- views/employer/jobs/new.ejs -->

<div class="d-flex flex-column gap-6">
  <% if (!jobCreateView.permissions.canCreateDraft) { %>
    <div class="card">
      <div class="card-body">
        <h2 class="fs-4">Job creation unavailable</h2>

        <p class="text-gray-600 mb-0">
          <%= jobCreateView.unavailableMessage %>
        </p>
      </div>
    </div>
  <% } else { %>
    <noscript>
      <div class="alert alert-warning">
        Enable JavaScript to complete and save this form.
      </div>
    </noscript>

    <div
      id="job-create-feedback"
      class="alert mb-0"
      role="status"
      aria-live="polite"
      hidden
    ></div>

    <form
      id="job-create-form"
      method="post"
      action="<%= jobCreateView.actions.submitUrl %>"
      data-currency="<%= jobCreateView.currency.code %>"
      data-currency-decimals="<%= jobCreateView.currency.decimalPlaces %>"
      data-max-list-items="<%= jobCreateView.limits.listItems %>"
      data-max-questions="<%= jobCreateView.limits.screeningQuestions %>"
      data-jobs-url="<%= jobCreateView.actions.jobsUrl %>"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- The client script enables fields after installing JSON submission. -->
      <fieldset id="job-create-fields" class="border-0 p-0 m-0" disabled>
        <legend class="visually-hidden">Create a job draft</legend>

        <!-- Job details -->
        <section class="card mb-6" aria-labelledby="job-details-heading">
          <div class="card-header">
            <h2 id="job-details-heading" class="card-title fs-4">
              1. Job details
            </h2>
          </div>

          <div class="card-body">
            <p class="text-gray-600 mb-6">
              You can save incomplete details and finish them before publishing.
            </p>

            <div class="row g-5">
              <div class="col-12">
                <label class="form-label" for="job-roleTitle">
                  Job title
                </label>

                <input
                  id="job-roleTitle"
                  name="roleTitle"
                  class="form-control"
                  maxlength="<%= jobCreateView.limits.roleTitle %>"
                  placeholder="e.g. Medical Officer"
                >
              </div>

              <div class="col-12">
                <label class="form-label" for="job-branch">
                  Branch<%= jobCreateView.branchRequired ? ' (required)' : '' %>
                </label>

                <select
                  id="job-branch"
                  name="branch"
                  class="form-select"
                  aria-describedby="job-branch-help"
                  <%= jobCreateView.branchRequired ? 'required' : '' %>
                >
                  <option value="">
                    <%= jobCreateView.branchPlaceholder %>
                  </option>

                  <% jobCreateView.branches.forEach((branch) => { %>
                    <option value="<%= branch.id %>">
                      <%= branch.name || 'Branch' %><%= branch.locationLabel ? ' — ' + branch.locationLabel : '' %>
                    </option>
                  <% }); %>
                </select>

                <div id="job-branch-help" class="form-text">
                  <%= jobCreateView.branchHelp %>
                </div>
              </div>

              <% [
                ['professionalType', 'Profession', jobCreateView.options.professionalTypes],
                ['employmentType', 'Employment type', jobCreateView.options.employmentTypes],
                ['workplaceType', 'Workplace type', jobCreateView.options.workplaceTypes]
              ].forEach(([name, label, options]) => { %>
                <div class="col-12 col-md-4">
                  <label class="form-label" for="job-<%= name %>">
                    <%= label %>
                  </label>

                  <select
                    id="job-<%= name %>"
                    name="<%= name %>"
                    class="form-select"
                  >
                    <option value="">Choose later</option>

                    <% options.forEach((option) => { %>
                      <option value="<%= option.value %>">
                        <%= option.label %>
                      </option>
                    <% }); %>
                  </select>
                </div>
              <% }); %>

              <% [
                ['specialty', 'Specialty'],
                ['department', 'Department']
              ].forEach(([name, label]) => { %>
                <div class="col-12 col-md-6">
                  <label class="form-label" for="job-<%= name %>">
                    <%= label %>
                  </label>

                  <input
                    id="job-<%= name %>"
                    name="<%= name %>"
                    class="form-control"
                    maxlength="<%= jobCreateView.limits[name] %>"
                  >
                </div>
              <% }); %>

              <div class="col-12 col-md-6">
                <label class="form-label" for="job-vacancyCount">
                  Number of vacancies
                </label>

                <input
                  id="job-vacancyCount"
                  name="vacancyCount"
                  type="number"
                  min="1"
                  step="1"
                  required
                  class="form-control"
                  value="<%= jobCreateView.defaults.vacancyCount %>"
                >
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label" for="job-employmentStartDate">
                  Expected start date
                </label>

                <input
                  id="job-employmentStartDate"
                  name="employmentStartDate"
                  type="date"
                  class="form-control"
                >
              </div>

              <% [
                ['summary', 'Short summary', 3],
                ['description', 'Job description', 7]
              ].forEach(([name, label, rows]) => { %>
                <div class="col-12">
                  <label class="form-label" for="job-<%= name %>">
                    <%= label %>
                  </label>

                  <textarea
                    id="job-<%= name %>"
                    name="<%= name %>"
                    class="form-control"
                    rows="<%= rows %>"
                    maxlength="<%= jobCreateView.limits[name] %>"
                  ></textarea>
                </div>
              <% }); %>
            </div>
          </div>
        </section>

        <!-- Requirements and benefits -->
        <section class="card mb-6" aria-labelledby="job-requirements-heading">
          <div class="card-header">
            <h2 id="job-requirements-heading" class="card-title fs-4">
              2. Requirements and benefits
            </h2>
          </div>

          <div class="card-body">
            <div class="row g-5">
              <div class="col-12 col-md-4">
                <label class="form-label" for="job-minimumYearsOfExperience">
                  Minimum years of experience
                </label>

                <input
                  id="job-minimumYearsOfExperience"
                  name="minimumYearsOfExperience"
                  type="number"
                  min="0"
                  step="1"
                  required
                  class="form-control"
                  value="<%= jobCreateView.defaults.minimumYearsOfExperience %>"
                >
              </div>

              <div class="col-12 col-md-8">
                <label class="form-label" for="job-educationRequirement">
                  Education requirement
                </label>

                <textarea
                  id="job-educationRequirement"
                  name="educationRequirement"
                  class="form-control"
                  rows="2"
                  maxlength="<%= jobCreateView.limits.educationRequirement %>"
                ></textarea>
              </div>

              <% [
                ['responsibilities', 'Responsibilities', jobCreateView.limits.sectionItem],
                ['requirements', 'Requirements', jobCreateView.limits.sectionItem],
                ['preferredQualifications', 'Preferred qualifications', jobCreateView.limits.sectionItem],
                ['skills', 'Skills', jobCreateView.limits.skillItem],
                ['benefits', 'Benefits', jobCreateView.limits.benefitItem]
              ].forEach(([name, label, itemLimit]) => { %>
                <div class="col-12">
                  <label class="form-label" for="job-<%= name %>">
                    <%= label %>
                  </label>

                  <textarea
                    id="job-<%= name %>"
                    name="<%= name %>"
                    class="form-control"
                    rows="4"
                    data-list-field
                    data-item-limit="<%= itemLimit %>"
                    aria-describedby="job-<%= name %>-help"
                  ></textarea>

                  <div id="job-<%= name %>-help" class="form-text">
                    One item per line. Up to <%= jobCreateView.limits.listItems %>
                    items, <%= itemLimit %> characters per item.
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </section>

        <!-- Compensation -->
        <section class="card mb-6" aria-labelledby="job-compensation-heading">
          <div class="card-header">
            <h2 id="job-compensation-heading" class="card-title fs-4">
              3. Compensation
            </h2>
          </div>

          <div class="card-body">
            <p class="text-gray-600">
              Salary is shown to applicants.
              Currency: <strong><%= jobCreateView.currency.code %></strong>.
            </p>

            <label class="form-check form-check-custom form-check-solid mb-6">
              <input
                id="job-include-compensation"
                class="form-check-input"
                type="checkbox"
              >
              <span class="form-check-label">Add compensation now</span>
            </label>

            <div id="job-compensation-fields" class="row g-5" hidden>
              <div class="col-12 col-md-6">
                <label class="form-label" for="job-compensation-type">
                  Salary type
                </label>

                <select
                  id="job-compensation-type"
                  name="compensationType"
                  class="form-select"
                >
                  <% jobCreateView.options.compensationTypes.forEach((option) => { %>
                    <option
                      value="<%= option.value %>"
                      <%= option.value === jobCreateView.defaults.compensationType ? 'selected' : '' %>
                    >
                      <%= option.label %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label" for="job-compensation-period">
                  Salary period
                </label>

                <select
                  id="job-compensation-period"
                  name="compensationPeriod"
                  class="form-select"
                >
                  <% jobCreateView.options.salaryPeriods.forEach((option) => { %>
                    <option
                      value="<%= option.value %>"
                      <%= option.value === jobCreateView.defaults.salaryPeriod ? 'selected' : '' %>
                    >
                      <%= option.label %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="col-12 col-md-6">
                <label
                  id="job-minimum-amount-label"
                  class="form-label"
                  for="job-minimum-amount"
                >
                  <%= jobCreateView.currency.label %>
                </label>

                <input
                  id="job-minimum-amount"
                  name="minimumAmountDisplay"
                  type="text"
                  inputmode="decimal"
                  class="form-control"
                  aria-describedby="job-salary-help"
                  autocomplete="off"
                >
              </div>

              <div
                id="job-maximum-amount-group"
                class="col-12 col-md-6"
                hidden
              >
                <label class="form-label" for="job-maximum-amount">
                  Maximum salary (<%= jobCreateView.currency.code %>)
                </label>

                <input
                  id="job-maximum-amount"
                  name="maximumAmountDisplay"
                  type="text"
                  inputmode="decimal"
                  class="form-control"
                  autocomplete="off"
                >
              </div>

              <div class="col-12">
                <div id="job-salary-help" class="form-text mb-4">
                  Enter amounts without commas, using up to
                  <%= jobCreateView.currency.decimalPlaces %> decimal places.
                </div>

                <label class="form-check form-check-custom form-check-solid">
                  <input
                    name="negotiable"
                    type="checkbox"
                    class="form-check-input"
                    <%= jobCreateView.defaults.negotiable ? 'checked' : '' %>
                  >
                  <span class="form-check-label">Negotiable</span>
                </label>
              </div>
            </div>

            <p class="form-text mt-5 mb-0">
              Compensation can be added later, but is required before publication.
            </p>
          </div>
        </section>

        <!-- Screening questions -->
        <section class="card mb-6" aria-labelledby="job-screening-heading">
          <div class="card-header">
            <h2 id="job-screening-heading" class="card-title fs-4">
              4. Screening questions
            </h2>
          </div>

          <div class="card-body">
            <p class="text-gray-600 mb-2">
              <%= jobCreateView.screeningHelp %>
            </p>

            <p class="form-text mb-6">
              Screening questions are optional. You can add up to
              <%= jobCreateView.limits.screeningQuestions %> questions.
            </p>

            <div
              id="job-screening-questions"
              class="d-flex flex-column gap-5"
              aria-label="Screening questions"
            ></div>

            <div class="d-flex flex-wrap align-items-center gap-3 mt-5">
              <button
                id="job-add-question"
                type="button"
                class="btn btn-light-primary"
              >
                <i class="ki-duotone ki-plus fs-3" aria-hidden="true">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
                Add question
              </button>
            </div>
          </div>
        </section>

        <!-- Application deadline -->
        <section class="card mb-6" aria-labelledby="job-deadline-heading">
          <div class="card-header">
            <h2 id="job-deadline-heading" class="card-title fs-4">
              5. Application deadline
            </h2>
          </div>

          <div class="card-body">
            <label class="form-label" for="job-applicationDeadline">
              Deadline (optional)
            </label>

            <input
              id="job-applicationDeadline"
              name="applicationDeadline"
              type="datetime-local"
              class="form-control"
              aria-describedby="job-deadline-help"
            >

            <div id="job-deadline-help" class="form-text">
              Use your device's local time. The deadline will be checked against
              the publication period when you publish.
            </div>
          </div>
        </section>

        <!-- Form actions -->
        <div class="d-flex flex-wrap align-items-center gap-4">
          <button
            id="job-save-draft"
            type="submit"
            class="btn btn-primary"
          >
            <%= jobCreateView.actions.submitLabel %>
          </button>

          <a href="<%= jobCreateView.actions.jobsUrl %>" class="btn btn-light">
            Cancel
          </a>

          <span class="text-gray-600">
            Saving a draft does not publish the job or take payment.
          </span>
        </div>
      </fieldset>
    </form>

    <!-- Dynamic screening question template -->
    <template id="job-screening-question-template">
      <fieldset
        class="border border-dashed border-gray-300 rounded-3 p-5 p-lg-6"
        data-screening-question
      >
        <legend
          class="float-none w-auto px-2 fs-6 fw-bold text-gray-800"
          data-question-title
        >
          Question
        </legend>

        <div class="d-flex justify-content-end mb-5">
          <button
            type="button"
            class="btn btn-sm btn-light-danger"
            data-remove-question
          >
            <i class="ki-duotone ki-trash fs-5" aria-hidden="true">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
              <span class="path5"></span>
            </i>
            Remove question
          </button>
        </div>

        <div class="row g-5">
          <!-- Full-width question input -->
          <div class="col-12">
            <label class="form-label fw-semibold d-block w-100">
              Question

              <textarea
                data-field="prompt"
                class="form-control w-100 mt-2"
                rows="3"
                maxlength="<%= jobCreateView.limits.screeningPrompt %>"
                placeholder="Enter the question applicants will answer"
                required
              ></textarea>
            </label>
          </div>

          <!-- Question configuration -->
          <div class="col-12 col-lg-6">
            <label class="form-label fw-semibold d-block w-100">
              Answer type

              <select
                data-field="type"
                class="form-select w-100 mt-2"
              >
                <% jobCreateView.options.screeningQuestionTypes.forEach((option) => { %>
                  <option value="<%= option.value %>">
                    <%= option.label %>
                  </option>
                <% }); %>
              </select>
            </label>
          </div>

          <div class="col-12 col-lg-6">
            <label class="form-label fw-semibold d-block w-100">
              Criterion

              <select
                data-field="requirementLevel"
                class="form-select w-100 mt-2"
              >
                <% jobCreateView.options.screeningRequirementLevels.forEach((option) => { %>
                  <option
                    value="<%= option.value %>"
                    <%= option.value === jobCreateView.defaults.screeningRequirementLevel ? 'selected' : '' %>
                  >
                    <%= option.label %>
                  </option>
                <% }); %>
              </select>
            </label>
          </div>

          <!-- Response requirement -->
          <div class="col-12">
            <div class="pt-2">
              <label class="form-check form-check-custom form-check-solid">
                <input
                  data-field="isResponseRequired"
                  type="checkbox"
                  class="form-check-input"
                  <%= jobCreateView.defaults.screeningResponseRequired ? 'checked' : '' %>
                >
                <span class="form-check-label">
                  Applicant must answer this question
                </span>
              </label>
            </div>
          </div>

          <!-- Answer options -->
          <div class="col-12" data-question-options hidden>
            <label class="form-label fw-semibold d-block w-100">
              Answer options

              <textarea
                data-field="options"
                class="form-control w-100 mt-2"
                rows="4"
                data-item-limit="<%= jobCreateView.limits.screeningOption %>"
                placeholder="Enter one answer option per line"
              ></textarea>
            </label>

            <div class="form-text mt-2">
              One option per line; at least two unique options.
              Up to <%= jobCreateView.limits.screeningOption %> characters each.
            </div>
          </div>

          <!-- Yes/No qualifying answer -->
          <div class="col-12 col-lg-6" data-question-boolean hidden>
            <label class="form-label fw-semibold d-block w-100">
              Qualifying answer

              <select
                data-field="qualifyingBoolean"
                class="form-select w-100 mt-2"
              >
                <option value="">Choose an answer</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
              </select>
            </label>
          </div>

          <!-- Numeric qualifying values -->
          <div class="col-12" data-question-numbers hidden>
            <div class="row g-5">
              <div class="col-12 col-lg-6">
                <label class="form-label fw-semibold d-block w-100">
                  Minimum qualifying value

                  <input
                    data-field="minimumNumber"
                    type="number"
                    step="any"
                    class="form-control w-100 mt-2"
                    placeholder="Minimum value"
                  >
                </label>
              </div>

              <div class="col-12 col-lg-6">
                <label class="form-label fw-semibold d-block w-100">
                  Maximum qualifying value

                  <input
                    data-field="maximumNumber"
                    type="number"
                    step="any"
                    class="form-control w-100 mt-2"
                    placeholder="Maximum value"
                  >
                </label>
              </div>
            </div>

            <div class="form-text mt-2">
              Provide at least one bound for a preferred or required criterion.
            </div>
          </div>

          <!-- Qualifying selection options -->
          <div class="col-12" data-question-acceptable hidden>
            <label class="form-label fw-semibold d-block w-100">
              Qualifying options

              <textarea
                data-field="acceptableOptions"
                class="form-control w-100 mt-2"
                rows="3"
                placeholder="Enter one qualifying option per line"
              ></textarea>
            </label>

            <div class="form-text mt-2">
              One per line, copied exactly from the answer options.
            </div>
          </div>

          <!-- Multi-select qualification -->
          <div class="col-12" data-question-all-options hidden>
            <label class="form-check form-check-custom form-check-solid">
              <input
                data-field="requireAllOptions"
                type="checkbox"
                class="form-check-input"
              >
              <span class="form-check-label">
                Require all qualifying options
              </span>
            </label>
          </div>
        </div>
      </fieldset>
    </template>
  <% } %>
</div>
