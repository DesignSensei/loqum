<!-- views/employer/shifts/assignments.ejs -->

<div id="shiftAssignmentsPage">
  
  <!-- ─────────────────────────────── FOCUSED SHIFT ─────────────────────────────── -->

  <% if (assignmentsView.focusedShiftSection.visible) { %>
    <div class="card mb-8">
      <div class="card-body py-6">
        <div
          class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-5"
        >
          <div class="d-flex align-items-start gap-4">
            <div class="symbol symbol-50px flex-shrink-0">
              <div class="symbol-label bg-light-primary">
                <i class="ki-duotone ki-briefcase fs-2x text-primary">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>
              </div>
            </div>

            <div>
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="fw-bold fs-4 text-gray-900">
                  <%= assignmentsView.focusedShiftSection.title %>
                </span>

                <% if (assignmentsView.focusedShiftSection.referenceCode) { %>
                  <span class="badge badge-light">
                    <%= assignmentsView.focusedShiftSection.referenceCode %>
                  </span>
                <% } %>

                <% assignmentsView.focusedShiftSection.badges.forEach((badge) => { %>
                  <span class="badge <%= badge.badgeClass %>">
                    <%= badge.label %>
                  </span>
                <% }) %>
              </div>

              <% if (assignmentsView.focusedShiftSection.metaItems.length > 0) { %>
                <div class="d-flex flex-wrap gap-4 fs-7 text-muted">
                  <% assignmentsView.focusedShiftSection.metaItems.forEach((item) => { %>
                    <span>
                      <% if (item.icon) { %>
                        <i class="ki-duotone <%= item.icon %> fs-6 me-1">
                          <span class="path1"></span>
                          <span class="path2"></span>
                        </i>
                      <% } %>

                      <%= item.value %>
                    </span>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2">
            <% if (assignmentsView.focusedShiftSection.viewShiftAction.visible) { %>
              <a
                href="<%= assignmentsView.focusedShiftSection.viewShiftAction.url %>"
                class="btn btn-sm <%= assignmentsView.focusedShiftSection.viewShiftAction.buttonClass %>"
              >
                <%= assignmentsView.focusedShiftSection.viewShiftAction.label %>
              </a>
            <% } %>

            <% if (assignmentsView.focusedShiftSection.showAllAction.visible) { %>
              <a
                href="<%= assignmentsView.focusedShiftSection.showAllAction.url %>"
                class="btn btn-sm <%= assignmentsView.focusedShiftSection.showAllAction.buttonClass %>"
              >
                <%= assignmentsView.focusedShiftSection.showAllAction.label %>
              </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- ─────────────────────────────── READ-ONLY NOTICE ─────────────────────────────── -->

  <% if (assignmentsView.readOnlyNotice.visible) { %>
    <div
      class="notice d-flex rounded border border-dashed p-6 mb-8 <%= assignmentsView.readOnlyNotice.noticeClass %>"
    >
      <i
        class="ki-duotone <%= assignmentsView.readOnlyNotice.icon %> fs-2tx me-5 <%= assignmentsView.readOnlyNotice.iconClass %>"
      >
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
      </i>

      <div>
        <div class="fw-bold text-gray-900 mb-1">
          <%= assignmentsView.readOnlyNotice.title %>
        </div>

        <div class="fs-7 text-muted">
          <%= assignmentsView.readOnlyNotice.message %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- ─────────────────────────────── SUMMARY CARDS ─────────────────────────────── -->

<div class="row g-5 g-xl-8 mb-8">
  <% assignmentsView.summaryCards.forEach((card) => { %>
    <div class="col-sm-6 col-lg-3">
      <div class="card card-flush h-100">
        <div
          class="card-body d-flex flex-column justify-content-center align-items-center text-center"
        >
          <div class="symbol symbol-60px mb-5">
            <span class="symbol-label <%= card.symbolClass %>">
              <i class="ki-duotone <%= card.icon %> fs-2x <%= card.iconClass %>">
                <% card.iconPaths.forEach((path) => { %>
                  <span class="path<%= path %>"></span>
                <% }) %>
              </i>
            </span>
          </div>

          <div class="fs-2 fw-bold <%= card.valueClass %>">
            <%= card.value %>
          </div>

          <div class="fs-6 fw-semibold text-gray-700">
            <%= card.label %>
          </div>          
        </div>
      </div>
    </div>
  <% }) %>
</div>

  <!-- ─────────────────────────────── RESULTS HEADER / FILTER ─────────────────────────────── -->

<div
  class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-5"
>
  <div>
    <div class="fw-bold fs-4 text-gray-900">
      <%= assignmentsView.resultsHeader.title %>
    </div>

    <div class="fs-7 text-muted">
      <%= assignmentsView.resultsHeader.subtitle %>
    </div>
  </div>

  <div class="d-flex align-items-center">
    <button
      type="button"
      class="btn btn-sm btn-light btn-active-light-primary"
      data-kt-menu-trigger="click"
      data-kt-menu-placement="bottom-end"
    >
      <i class="ki-duotone ki-filter fs-3">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      <%= assignmentsView.filters.selectedLabel %>

      <i class="ki-duotone ki-down fs-5 ms-1"></i>
    </button>

    <div
      class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-250px py-3"
      data-kt-menu="true"
    >
      <% assignmentsView.filters.options.forEach((option) => { %>
        <div class="menu-item px-3">
          <a
            href="<%= option.url %>"
            class="menu-link px-3 <%= option.active ? 'active' : '' %>"
          >
            <span class="menu-title">
              <%= option.label %>
            </span>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</div>

  <!-- ─────────────────────────────── ASSIGNMENTS ─────────────────────────────── -->

  <% if (assignmentsView.hasAssignments) { %>
    <div class="d-flex flex-column gap-6">
      <% assignmentsView.assignments.forEach((assignment) => { %>
        <div
          class="card"
          data-assignment-id="<%= assignment.data.assignmentId %>"
          data-shift-id="<%= assignment.data.shiftId %>"
          data-assignment-status="<%= assignment.data.status %>"
          data-assignment-type="<%= assignment.data.assignmentType %>"
          data-slot-number="<%= assignment.data.slotNumber %>"
        >
          <div class="card-body p-6 p-lg-8">
            <!-- ───────────────── ASSIGNMENT HEADER ───────────────── -->

            <div
              class="d-flex flex-column flex-lg-row justify-content-between gap-6 mb-7"
            >
              <div class="d-flex align-items-start gap-4">
                <% if (assignment.professional) { %>
                  <div class="symbol symbol-60px symbol-circle flex-shrink-0">
                    <% if (assignment.professional.avatar.photo) { %>
                      <img
                        src="<%= assignment.professional.avatar.photo %>"
                        alt="<%= assignment.professional.avatar.alt %>"
                      >
                    <% } else { %>
                      <div
                        class="symbol-label fs-3 fw-bold bg-light-primary text-primary"
                      >
                        <%= assignment.professional.avatar.initials %>
                      </div>
                    <% } %>
                  </div>
                <% } %>

                <div>
                  <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="fw-bold fs-3 text-gray-900">
                      <%= assignment.professional ? assignment.professional.name : "Professional" %>
                    </span>

                    <% assignment.badges.forEach((badge) => { %>
                      <span class="badge <%= badge.badgeClass %>">
                        <%= badge.label %>
                      </span>
                    <% }) %>
                  </div>

                  <div class="fw-semibold text-gray-700 mb-2">
                    <%= assignment.scopeSubtitle %>
                  </div>

                  <% if (assignment.branch?.name) { %>
                    <div class="fs-7 text-muted">
                      <i class="ki-duotone ki-geolocation fs-6 me-1">
                        <span class="path1"></span>
                        <span class="path2"></span>
                      </i>

                      <%= assignment.branch.name %>

                      <% if (assignment.branch.locationLabel) { %>
                        · <%= assignment.branch.locationLabel %>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>

              <% if (assignment.shift) { %>
                <div class="text-lg-end">
                  <div class="fw-bold text-gray-900 mb-1">
                    <%= assignment.shift.heading %>
                  </div>

                  <% if (assignment.shift.referenceCode) { %>
                    <div class="fs-7 text-muted mb-2">
                      <%= assignment.shift.referenceCode %>
                    </div>
                  <% } %>

                  <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                    <% if (assignment.shift.status) { %>
                      <span class="badge <%= assignment.shift.statusBadgeClass %>">
                        <%= assignment.shift.statusLabel %>
                      </span>
                    <% } %>

                    <% if (assignment.shift.paymentStatus) { %>
                      <span class="badge <%= assignment.shift.paymentStatusBadgeClass %>">
                        <%= assignment.shift.paymentStatusLabel %>
                      </span>
                    <% } %>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- ───────────────── PROFESSIONAL METRICS ───────────────── -->

            <% if (
              assignment.professional &&
              assignment.professional.metrics.length > 0
            ) { %>
              <div class="row g-5 mb-7">
                <% assignment.professional.metrics.forEach((metric) => { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="border rounded p-4 h-100">
                      <div class="fs-8 text-muted text-uppercase fw-semibold mb-1">
                        <%= metric.label %>
                      </div>

                      <div class="fw-bold text-gray-900">
                        <% if (metric.icon) { %>
                          <i
                            class="ki-duotone <%= metric.icon %> fs-6 text-warning me-1"
                          ></i>
                        <% } %>

                        <%= metric.value %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <% if (
              assignment.professional &&
              assignment.professional.statusBadges.length > 0
            ) { %>
              <div class="d-flex flex-wrap gap-2 mb-7">
                <% assignment.professional.statusBadges.forEach((badge) => { %>
                  <span class="badge <%= badge.badgeClass %>">
                    <%= badge.label %>
                  </span>
                <% }) %>
              </div>
            <% } %>

            <!-- ───────────────── ASSIGNMENT OVERVIEW ───────────────── -->

            <% if (assignment.overviewItems.length > 0) { %>
              <div class="row g-4 mb-7">
                <% assignment.overviewItems.forEach((item) => { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="border rounded p-4 h-100">
                      <div class="fs-8 text-muted mb-1">
                        <%= item.label %>
                      </div>

                      <div class="fw-semibold text-gray-900">
                        <%= item.value %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <!-- ───────────────── REPLACEMENT CONTEXT ───────────────── -->

            <% if (assignment.isReplacement) { %>
              <div
                class="notice d-flex rounded border border-dashed border-warning bg-light-warning p-5 mb-7"
              >
                <i class="ki-duotone ki-arrows-circle fs-2x text-warning me-4">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>

                <div>
                  <div class="fw-bold text-gray-900 mb-1">
                    <%= assignment.replacementScopeLabel %>
                  </div>

                  <div class="fs-7 text-muted">
                    <% if (assignment.isOccurrenceSpecific) { %>
                      This assignment replaces responsibility for one exact professional-position/work-date occurrence.
                    <% } else { %>
                      This assignment replaces responsibility for the remaining authorized assignment range in the same staffing position.
                    <% } %>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- ───────────────── PLANNED / EFFECTIVE COVERAGE ───────────────── -->

            <div class="row g-5 mb-7">
              <div class="col-lg-6">
                <div class="border rounded p-5 h-100">
                  <div class="fw-bold text-gray-900 mb-4">
                    Planned responsibility
                  </div>

                  <div class="d-flex flex-column gap-3 fs-7">
                    <% if (assignment.plannedRange.rangeLabel) { %>
                      <div class="d-flex justify-content-between gap-3">
                        <span class="text-muted">Work dates</span>

                        <span class="fw-semibold text-gray-800">
                          <%= assignment.plannedRange.rangeLabel %>
                        </span>
                      </div>
                    <% } %>

                    <% if (assignment.plannedRange.countLabel) { %>
                      <div class="d-flex justify-content-between gap-3">
                        <span class="text-muted">Coverage</span>

                        <span class="fw-semibold text-gray-800">
                          <%= assignment.plannedRange.countLabel %>
                        </span>
                      </div>
                    <% } %>

                    <div class="d-flex justify-content-between gap-3">
                      <span class="text-muted">Starts</span>

                      <span class="fw-semibold text-gray-800">
                        <%= assignment.plannedRange.startsAtDisplay %>
                      </span>
                    </div>

                    <div class="d-flex justify-content-between gap-3">
                      <span class="text-muted">Planned end</span>

                      <span class="fw-semibold text-gray-800">
                        <%= assignment.plannedRange.endsAtDisplay %>
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-6">
                <div class="border rounded p-5 h-100">
                  <div class="fw-bold text-gray-900 mb-4">
                    Effective responsibility
                  </div>

                  <% if (assignment.effectiveRange) { %>
                    <div class="d-flex flex-column gap-3 fs-7">
                      <% if (assignment.effectiveRange.rangeLabel) { %>
                        <div class="d-flex justify-content-between gap-3">
                          <span class="text-muted">Work dates</span>

                          <span class="fw-semibold text-gray-800">
                            <%= assignment.effectiveRange.rangeLabel %>
                          </span>
                        </div>
                      <% } %>

                      <% if (assignment.effectiveRange.countLabel) { %>
                        <div class="d-flex justify-content-between gap-3">
                          <span class="text-muted">Coverage</span>

                          <span class="fw-semibold text-gray-800">
                            <%= assignment.effectiveRange.countLabel %>
                          </span>
                        </div>
                      <% } %>

                      <div class="d-flex justify-content-between gap-3">
                        <span class="text-muted">Effective end</span>

                        <span class="fw-semibold text-gray-800">
                          <%= assignment.effectiveRange.endsAtDisplay %>
                        </span>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="text-muted fs-7">
                      No early or final effective endpoint has been recorded.
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- ───────────────── EXACT OCCURRENCE REPLACEMENT ───────────────── -->

            <% if (assignment.exactOccurrence) { %>
              <div class="border border-dashed rounded p-5 mb-7">
                <div
                  class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4"
                >
                  <div>
                    <div class="fw-bold text-gray-900">
                      Exact work-date assignment
                    </div>

                    <div class="fs-7 text-muted">
                      <%= assignment.exactOccurrence.identityLabel %>
                    </div>
                  </div>

                  <span class="badge <%= assignment.exactOccurrence.ownershipBadgeClass %>">
                    <%= assignment.exactOccurrence.ownershipLabel %>
                  </span>
                </div>

                <div class="row g-4">
                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Date
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.exactOccurrence.occurrenceDateDisplay %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Assignment state
                    </div>

                    <div>
                      <span class="badge <%= assignment.exactOccurrence.assignmentStatusBadgeClass %>">
                        <%= assignment.exactOccurrence.assignmentStatusLabel %>
                      </span>
                    </div>
                  </div>

                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Occurrence state
                    </div>

                    <div>
                      <span class="badge <%= assignment.exactOccurrence.statusBadgeClass %>">
                        <%= assignment.exactOccurrence.statusLabel %>
                      </span>
                    </div>
                  </div>

                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Attendance
                    </div>

                    <div>
                      <span class="badge <%= assignment.exactOccurrence.attendanceStatusBadgeClass %>">
                        <%= assignment.exactOccurrence.attendanceStatusLabel %>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- ───────────────── OCCURRENCE OWNERSHIP ───────────────── -->

            <% if (assignment.occurrenceContext.visible) { %>
              <div class="border rounded p-5 mb-7">
                <div
                  class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-5"
                >
                  <div>
                    <div class="fw-bold text-gray-900">
                      Work-date ownership
                    </div>

                    <div class="fs-7 text-muted">
                      <%= assignment.occurrenceContext.summaryText %>
                    </div>
                  </div>

                  <div class="d-flex flex-wrap gap-2">
                    <span class="badge badge-light-success">
                      <%= assignment.occurrenceContext.ownedCount %> current
                    </span>

                    <% if (assignment.occurrenceContext.reassignedCount > 0) { %>
                      <span class="badge badge-light-secondary">
                        <%= assignment.occurrenceContext.reassignedCount %> reassigned
                      </span>
                    <% } %>

                    <% if (assignment.occurrenceContext.replacementRequiredCount > 0) { %>
                      <span class="badge badge-light-warning">
                        <%= assignment.occurrenceContext.replacementRequiredCount %> replacement required
                      </span>
                    <% } %>
                  </div>
                </div>

                <div class="table-responsive">
                  <table class="table align-middle table-row-dashed gy-4 mb-0">
                    <thead>
                      <tr
                        class="text-start text-muted fw-bold fs-7 text-uppercase gs-0"
                      >
                        <th>Occurrence</th>
                        <th>Date</th>
                        <th>Ownership</th>
                        <th>Occurrence</th>
                        <th>Attendance</th>
                        <th>Settlement</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% assignment.occurrenceContext.items.forEach((occurrence) => { %>
                        <tr>
                          <td>
                            <div class="fw-semibold text-gray-900">
                              <%= occurrence.identityLabel %>
                            </div>

                            <% if (occurrence.referenceCode) { %>
                              <div class="fs-8 text-muted font-monospace">
                                <%= occurrence.referenceCode %>
                              </div>
                            <% } %>
                          </td>

                          <td>
                            <div class="fw-semibold text-gray-800">
                              <%= occurrence.occurrenceDateDisplay %>
                            </div>
                          </td>

                          <td>
                            <span class="badge <%= occurrence.ownershipBadgeClass %>">
                              <%= occurrence.ownershipLabel %>
                            </span>
                          </td>

                          <td>
                            <span class="badge <%= occurrence.statusBadgeClass %>">
                              <%= occurrence.statusLabel %>
                            </span>
                          </td>

                          <td>
                            <span class="badge <%= occurrence.attendanceStatusBadgeClass %>">
                              <%= occurrence.attendanceStatusLabel %>
                            </span>
                          </td>

                          <td>
                            <% if (occurrence.settlementStatusLabel) { %>
                              <div class="fw-semibold text-gray-800">
                                <%= occurrence.settlementStatusLabel %>
                              </div>
                            <% } else { %>
                              <span class="text-muted">
                                -
                              </span>
                            <% } %>

                            <% if (occurrence.overtimeStatusLabel) { %>
                              <div class="fs-8 text-muted mt-1">
                                OT: <%= occurrence.overtimeStatusLabel %>
                              </div>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% } %>

            <!-- ───────────────── OPEN CASE ───────────────── -->

            <% if (assignment.openCase.visible) { %>
              <div
                class="notice d-flex rounded border border-dashed p-5 mb-7 <%= assignment.openCase.requiresEmployerAttention ? "bg-light-warning border-warning" : "bg-light-info border-info" %>"
              >
                <i
                  class="ki-duotone ki-information fs-2x me-4 <%= assignment.openCase.requiresEmployerAttention ? "text-warning" : "text-info" %>"
                >
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>

                <div class="flex-grow-1">
                  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="fw-bold text-gray-900">
                      <%= assignment.openCase.relationshipLabel %>
                    </span>

                    <span class="badge <%= assignment.openCase.statusBadgeClass %>">
                      <%= assignment.openCase.statusLabel %>
                    </span>

                    <% if (assignment.openCase.attentionBadge) { %>
                      <span class="badge <%= assignment.openCase.attentionBadge.badgeClass %>">
                        <%= assignment.openCase.attentionBadge.label %>
                      </span>
                    <% } %>
                  </div>

                  <% if (assignment.openCase.details.length > 0) { %>
                    <div class="row g-4">
                      <% assignment.openCase.details.forEach((detail) => { %>
                        <div class="col-sm-6 col-xl-4">
                          <div class="fs-8 text-muted">
                            <%= detail.label %>
                          </div>

                          <div class="fw-semibold text-gray-800">
                            <%= detail.value %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>

                  <% if (assignment.openCase.exitProposal.visible) { %>
                    <div class="border-top border-gray-300 mt-5 pt-5">
                      <div class="fw-semibold text-gray-900 mb-3">
                        Exit proposal
                      </div>

                      <% if (assignment.openCase.exitProposal.reasonLabel) { %>
                        <div class="fs-7 mb-2">
                          <span class="text-muted">
                            Reason:
                          </span>

                          <span class="fw-semibold">
                            <%= assignment.openCase.exitProposal.reasonLabel %>
                          </span>
                        </div>
                      <% } %>

                      <% if (assignment.openCase.exitProposal.details) { %>
                        <div class="fs-7 text-gray-700">
                          <%= assignment.openCase.exitProposal.details %>
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <% if (assignment.openCase.employerIssue.visible) { %>
                    <div class="border-top border-gray-300 mt-5 pt-5">
                      <div class="fw-semibold text-gray-900 mb-3">
                        Employer issue
                      </div>

                      <% if (assignment.openCase.employerIssue.issueTypeLabel) { %>
                        <div class="fs-7 mb-2">
                          <span class="text-muted">
                            Issue:
                          </span>

                          <span class="fw-semibold">
                            <%= assignment.openCase.employerIssue.issueTypeLabel %>
                          </span>
                        </div>
                      <% } %>

                      <% if (assignment.openCase.employerIssue.occurrenceIdentityLabel) { %>
                        <div class="fs-7 mb-2">
                          <span class="text-muted">
                            Occurrence:
                          </span>

                          <span class="fw-semibold">
                            <%= assignment.openCase.employerIssue.occurrenceIdentityLabel %>
                          </span>
                        </div>
                      <% } %>

                      <% if (assignment.openCase.employerIssue.details) { %>
                        <div class="fs-7 text-gray-700">
                          <%= assignment.openCase.employerIssue.details %>
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <% if (assignment.openCase.professionalResponse.visible) { %>
                    <div class="border-top border-gray-300 mt-5 pt-5">
                      <div class="fw-semibold text-gray-900 mb-2">
                        Professional response
                      </div>

                      <div class="fs-7">
                        <span class="text-muted">
                          Decision:
                        </span>

                        <span class="fw-semibold">
                          <%= assignment.openCase.professionalResponse.decisionLabel %>
                        </span>
                      </div>

                      <% if (assignment.openCase.professionalResponse.details) { %>
                        <div class="fs-7 text-gray-700 mt-2">
                          <%= assignment.openCase.professionalResponse.details %>
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <% if (assignment.openCase.employerResponse.visible) { %>
                    <div class="border-top border-gray-300 mt-5 pt-5">
                      <div class="fw-semibold text-gray-900 mb-2">
                        Employer response
                      </div>

                      <div class="fs-7">
                        <span class="text-muted">
                          Decision:
                        </span>

                        <span class="fw-semibold">
                          <%= assignment.openCase.employerResponse.decisionLabel %>
                        </span>
                      </div>

                      <% if (assignment.openCase.employerResponse.details) { %>
                        <div class="fs-7 text-gray-700 mt-2">
                          <%= assignment.openCase.employerResponse.details %>
                        </div>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>

            <!-- ───────────────── HISTORICAL / REPLACEMENT LINKS ───────────────── -->

            <% if (
              assignment.replacesAssignment ||
              assignment.replacedByAssignment
            ) { %>
              <div class="row g-5 mb-7">
                <% if (assignment.replacesAssignment) { %>
                  <div class="col-lg-6">
                    <div class="border rounded p-5 h-100">
                      <div class="fw-bold text-gray-900 mb-3">
                        <%= assignment.replacesAssignment.relationshipLabel %>
                      </div>

                      <div class="fw-semibold text-gray-800 mb-1">
                        <%= assignment.replacesAssignment.referenceCode %>
                      </div>

                      <% if (assignment.replacesAssignment.professional) { %>
                        <div class="fs-7 text-muted mb-2">
                          <%= assignment.replacesAssignment.professional.name %>
                        </div>
                      <% } %>

                      <div class="d-flex flex-wrap gap-2">
                        <span class="badge <%= assignment.replacesAssignment.statusBadgeClass %>">
                          <%= assignment.replacesAssignment.statusLabel %>
                        </span>

                        <% if (assignment.replacesAssignment.rangeLabel) { %>
                          <span class="badge badge-light">
                            <%= assignment.replacesAssignment.rangeLabel %>
                          </span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% } %>

                <% if (assignment.replacedByAssignment) { %>
                  <div class="col-lg-6">
                    <div class="border rounded p-5 h-100">
                      <div class="fw-bold text-gray-900 mb-3">
                        <%= assignment.replacedByAssignment.relationshipLabel %>
                      </div>

                      <div class="fw-semibold text-gray-800 mb-1">
                        <%= assignment.replacedByAssignment.referenceCode %>
                      </div>

                      <% if (assignment.replacedByAssignment.professional) { %>
                        <div class="fs-7 text-muted mb-2">
                          <%= assignment.replacedByAssignment.professional.name %>
                        </div>
                      <% } %>

                      <div class="d-flex flex-wrap gap-2">
                        <span class="badge <%= assignment.replacedByAssignment.statusBadgeClass %>">
                          <%= assignment.replacedByAssignment.statusLabel %>
                        </span>

                        <% if (assignment.replacedByAssignment.rangeLabel) { %>
                          <span class="badge badge-light">
                            <%= assignment.replacedByAssignment.rangeLabel %>
                          </span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>

            <!-- ───────────────── ASSIGNMENT ORIGIN ───────────────── -->

            <% if (assignment.applicationOrigin.visible) { %>
              <div class="border border-dashed rounded p-5 mb-7">
                <div class="fw-bold text-gray-900 mb-4">
                  Assignment origin
                </div>

                <div class="row g-4">
                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Application type
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.applicationOrigin.applicationTypeLabel %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Round
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.applicationOrigin.applicationRound %>
                    </div>
                  </div>

                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Application status
                    </div>

                    <span class="badge <%= assignment.applicationOrigin.statusBadgeClass %>">
                      <%= assignment.applicationOrigin.statusLabel %>
                    </span>
                  </div>

                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Accepted
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.applicationOrigin.acceptedAtDisplay %>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- ───────────────── LIFECYCLE AUDIT ───────────────── -->

            <div class="border-top pt-5 mb-5">
              <div class="fw-bold text-gray-900 mb-4">
                Assignment lifecycle
              </div>

              <div class="row g-4">
                <div class="col-sm-6 col-xl-3">
                  <div class="fs-8 text-muted">
                    Assigned
                  </div>

                  <div class="fw-semibold text-gray-800">
                    <%= assignment.lifecycleAudit.assignedAtDisplay %>
                  </div>
                </div>

                <% if (assignment.lifecycleAudit.activatedAt) { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Activated
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.lifecycleAudit.activatedAtDisplay %>
                    </div>
                  </div>
                <% } %>

                <% if (assignment.lifecycleAudit.endedAt) { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Ended
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.lifecycleAudit.endedAtDisplay %>
                    </div>
                  </div>
                <% } %>

                <% if (assignment.lifecycleAudit.cancelledAt) { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Cancelled
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.lifecycleAudit.cancelledAtDisplay %>
                    </div>
                  </div>
                <% } %>

                <% if (assignment.lifecycleAudit.endReasonLabel) { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      End reason
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.lifecycleAudit.endReasonLabel %>
                    </div>
                  </div>
                <% } %>

                <% if (assignment.lifecycleAudit.cancellationReason) { %>
                  <div class="col-sm-6 col-xl-3">
                    <div class="fs-8 text-muted">
                      Cancellation reason
                    </div>

                    <div class="fw-semibold text-gray-800">
                      <%= assignment.lifecycleAudit.cancellationReason %>
                    </div>
                  </div>
                <% } %>
              </div>

              <% if (assignment.lifecycleAudit.endNotes) { %>
                <div class="bg-light rounded p-4 mt-4 fs-7 text-gray-700">
                  <%= assignment.lifecycleAudit.endNotes %>
                </div>
              <% } %>
            </div>

            <!-- ───────────────── MANAGEMENT ACTIONS ───────────────── -->

            <% if (assignment.actions.hasManagementActions) { %>
              <div class="border-top pt-5 mb-5">
                <div
                  class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4"
                >
                  <div>
                    <div class="fw-bold text-gray-900 mb-1">
                      Assignment management
                    </div>

                    <div class="fs-8 text-muted">
                      Available actions reflect the current assignment and case state.
                    </div>
                  </div>

                  <div class="d-flex flex-wrap gap-2">
                    <% assignment.actions.managementItems.forEach((action) => { %>
                      <button
                        type="button"
                        class="btn btn-sm <%= action.buttonClass %> js-assignment-action-trigger"
                        data-bs-toggle="modal"
                        data-bs-target="#<%= assignmentsView.actionModal.id %>"
                        data-action-config="<%= JSON.stringify(action) %>"
                      >
                        <% if (action.icon) { %>
                          <i class="ki-duotone <%= action.icon %> fs-5">
                            <span class="path1"></span>
                            <span class="path2"></span>
                            <span class="path3"></span>
                          </i>
                        <% } %>

                        <%= action.label %>
                      </button>
                    <% }) %>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- ───────────────── FOOTER / NAVIGATION ───────────────── -->

            <div
              class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 border-top pt-5"
            >
              <div class="fs-8 text-muted font-monospace">
                <%= assignment.footerReference %>
              </div>

              <% if (assignment.actions.hasNavigationActions) { %>
                <div class="d-flex flex-wrap gap-2">
                  <% assignment.actions.navigationItems.forEach((action) => { %>
                    <a
                      href="<%= action.url %>"
                      class="btn btn-sm <%= action.buttonClass %>"
                    >
                      <% if (action.icon) { %>
                        <i class="ki-duotone <%= action.icon %> fs-5">
                          <span class="path1"></span>
                          <span class="path2"></span>
                          <span class="path3"></span>
                        </i>
                      <% } %>

                      <%= action.label %>
                    </a>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- ─────────────────────────────── EMPTY STATE ─────────────────────────────── -->

    <div class="card">
      <div class="card-body py-15 text-center">
        <div class="mb-5">
          <i
            class="ki-duotone <%= assignmentsView.emptyState.icon %> fs-5x text-gray-400"
          >
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
          </i>
        </div>

        <h3 class="fw-bold text-gray-900 mb-2">
          <%= assignmentsView.emptyState.title %>
        </h3>

        <div class="text-muted fs-6 mb-6">
          <%= assignmentsView.emptyState.message %>
        </div>

        <% if (assignmentsView.emptyState.action.visible) { %>
          <a
            href="<%= assignmentsView.emptyState.action.url %>"
            class="btn <%= assignmentsView.emptyState.action.buttonClass %>"
          >
            <%= assignmentsView.emptyState.action.label %>
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- ─────────────────────────────── PAGINATION ─────────────────────────────── -->

  <% if (assignmentsView.pagination.hasPagination) { %>
    <div
      class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 mt-8"
    >
      <div class="fs-7 text-muted">
        <%= assignmentsView.pagination.pageText %>
      </div>

      <div class="d-flex gap-2">
        <% if (assignmentsView.pagination.previous.enabled) { %>
          <a
            href="<%= assignmentsView.pagination.previous.url %>"
            class="btn btn-sm btn-light"
          >
            <%= assignmentsView.pagination.previous.label %>
          </a>
        <% } else { %>
          <button
            type="button"
            class="btn btn-sm btn-light"
            disabled
          >
            <%= assignmentsView.pagination.previous.label %>
          </button>
        <% } %>

        <% if (assignmentsView.pagination.next.enabled) { %>
          <a
            href="<%= assignmentsView.pagination.next.url %>"
            class="btn btn-sm btn-light"
          >
            <%= assignmentsView.pagination.next.label %>
          </a>
        <% } else { %>
          <button
            type="button"
            class="btn btn-sm btn-light"
            disabled
          >
            <%= assignmentsView.pagination.next.label %>
          </button>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<!-- ─────────────────────────────── ASSIGNMENT ACTION MODAL ─────────────────────────────── -->

<% if (assignmentsView.actionModal.enabled) { %>
  <div
    class="modal fade"
    id="<%= assignmentsView.actionModal.id %>"
    tabindex="-1"
    aria-labelledby="<%= assignmentsView.actionModal.titleId %>"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered mw-650px">
      <div class="modal-content">
        <form
          id="<%= assignmentsView.actionModal.formId %>"
          novalidate
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

          <input
            type="hidden"
            id="<%= assignmentsView.actionModal.actionTypeInputId %>"
            value=""
          >

          <input
            type="hidden"
            id="<%= assignmentsView.actionModal.actionUrlInputId %>"
            value=""
          >

          <div class="modal-header">
            <div>
              <h2
                class="fw-bold text-gray-900 mb-1"
                id="<%= assignmentsView.actionModal.titleId %>"
              >
                <%= assignmentsView.actionModal.defaultTitle %>
              </h2>

              <div
                class="fs-7 text-muted"
                id="<%= assignmentsView.actionModal.contextId %>"
              ></div>
            </div>

            <button
              type="button"
              class="btn btn-icon btn-sm btn-active-light-primary"
              data-bs-dismiss="modal"
              aria-label="Close"
            >
              <i class="ki-duotone ki-cross fs-2">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </button>
          </div>

          <div class="modal-body py-8 px-lg-10">
            <div
              class="alert alert-danger d-none"
              id="<%= assignmentsView.actionModal.alertId %>"
              role="alert"
            ></div>

            <div
              class="notice rounded border border-dashed p-5 mb-7 d-none"
              id="<%= assignmentsView.actionModal.noticeId %>"
            ></div>

            <div
              id="<%= assignmentsView.actionModal.fieldsContainerId %>"
            ></div>
          </div>

          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-light"
              data-bs-dismiss="modal"
            >
              <%= assignmentsView.actionModal.cancelLabel %>
            </button>

            <button
              type="submit"
              class="btn btn-primary"
              id="<%= assignmentsView.actionModal.submitButtonId %>"
            >
              <span class="indicator-label">
                <%= assignmentsView.actionModal.defaultSubmitLabel %>
              </span>

              <span class="indicator-progress">
                <%= assignmentsView.actionModal.loadingLabel %>

                <span
                  class="spinner-border spinner-border-sm align-middle ms-2"
                ></span>
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>