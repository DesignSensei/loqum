<!-- views/employer/shifts/attendance.ejs -->

<div id="shiftAttendancePage">
  <!-- ─────────────────────────────── READ-ONLY NOTICE ─────────────────────────────── -->

  <% if (attendanceView.readOnlyNotice.visible) { %>
  <div
    class="notice d-flex rounded border border-dashed p-6 mb-8 <%= attendanceView.readOnlyNotice.noticeClass %>"
  >
    <i
      class="ki-duotone <%= attendanceView.readOnlyNotice.icon %> fs-2tx me-5 <%= attendanceView.readOnlyNotice.iconClass %>"
    >
      <span class="path1"></span>
      <span class="path2"></span>
      <span class="path3"></span>
    </i>

    <div>
      <div class="fw-bold text-gray-900 mb-1"><%= attendanceView.readOnlyNotice.title %></div>

      <div class="fs-7 text-muted"><%= attendanceView.readOnlyNotice.message %></div>
    </div>
  </div>
  <% } %>

  <!-- ─────────────────────────────── FOCUSED SHIFT ─────────────────────────────── -->

  <% if (attendanceView.focusedShiftSection.visible) { %>
  <div class="card mb-8">
    <div class="card-body py-6">
      <div
        class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-5"
      >
        <div class="d-flex align-items-start gap-4">
          <div class="symbol symbol-50px flex-shrink-0">
            <div class="symbol-label bg-light-primary">
              <i class="ki-duotone ki-calendar-tick fs-2x text-primary">
                <span class="path1"></span>
                <span class="path2"></span>
                <span class="path3"></span>
              </i>
            </div>
          </div>

          <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
              <span class="fw-bold fs-4 text-gray-900">
                <%= attendanceView.focusedShiftSection.title %>
              </span>

              <% if (attendanceView.focusedShiftSection.referenceCode) { %>
              <span class="badge badge-light">
                <%= attendanceView.focusedShiftSection.referenceCode %>
              </span>
              <% } %> <% if (attendanceView.focusedShiftSection.statusLabel) { %>
              <span class="badge <%= attendanceView.focusedShiftSection.statusBadgeClass %>">
                <%= attendanceView.focusedShiftSection.statusLabel %>
              </span>
              <% } %>
            </div>

            <div class="d-flex flex-wrap gap-4 fs-7 text-muted">
              <% if (attendanceView.focusedShiftSection.branch) { %>
              <span>
                <i class="ki-duotone ki-geolocation fs-6 me-1">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>

                <%= attendanceView.focusedShiftSection.branch.name %> <% if
                (attendanceView.focusedShiftSection.branch.locationLabel) { %> · <%=
                attendanceView.focusedShiftSection.branch.locationLabel %> <% } %>
              </span>
              <% } %> <% if (attendanceView.focusedShiftSection.startDisplay) { %>
              <span>
                <i class="ki-duotone ki-calendar fs-6 me-1">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>

                <%= attendanceView.focusedShiftSection.startDisplay %>
              </span>
              <% } %>

              <span>
                <i class="ki-duotone ki-people fs-6 me-1">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>

                <%= attendanceView.focusedShiftSection.requiredProfessionals %> professional
                positions
              </span>

              <span>
                <%= attendanceView.focusedShiftSection.occurrenceCount %> work dates per position
              </span>
            </div>
          </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <% if (attendanceView.focusedShiftSection.viewShiftAction.visible) { %>
          <a
            href="<%= attendanceView.focusedShiftSection.viewShiftAction.url %>"
            class="btn btn-sm <%= attendanceView.focusedShiftSection.viewShiftAction.buttonClass %>"
          >
            <%= attendanceView.focusedShiftSection.viewShiftAction.label %>
          </a>
          <% } %> <% if (attendanceView.focusedShiftSection.showAllAction.visible) { %>
          <a
            href="<%= attendanceView.focusedShiftSection.showAllAction.url %>"
            class="btn btn-sm <%= attendanceView.focusedShiftSection.showAllAction.buttonClass %>"
          >
            <%= attendanceView.focusedShiftSection.showAllAction.label %>
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ─────────────────────────────── SUMMARY CARDS ─────────────────────────────── -->

  <!-- Summary cards -->

  <div class="row g-5 g-xl-8 mb-8">
    <% attendanceView.summaryCards.forEach((card) => { %>
    <div class="col-6 col-lg-3">
      <div class="card card-flush h-100">
        <div
          class="card-body d-flex flex-column justify-content-center align-items-center text-center"
        >
          <div class="symbol symbol-60px mb-5">
            <span class="symbol-label <%= card.symbolClass %>">
              <i class="ki-duotone <%= card.icon %> fs-2x <%= card.iconClass %>">
                <% for (let pathIndex = 1; pathIndex <= card.iconPaths; pathIndex += 1) { %>
                <span class="path<%= pathIndex %>"></span>
                <% } %>
              </i>
            </span>
          </div>

          <div class="fs-2 fw-bold <%= card.valueClass %>"><%= card.value %></div>

          <div class="fs-6 fw-semibold text-gray-700 mt-2"><%= card.label %></div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- ─────────────────────────────── RESULTS HEADER / FILTER ─────────────────────────────── -->

  <div
    class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-5"
  >
    <div>
      <div class="fw-bold fs-4 text-gray-900"><%= attendanceView.resultsHeader.title %></div>

      <div class="fs-7 text-muted"><%= attendanceView.resultsHeader.subtitle %></div>
    </div>

    <div class="d-flex align-items-center">
      <button
        type="button"
        class="btn btn-sm btn-light btn-active-light-primary"
        data-kt-menu-trigger="click"
        data-kt-menu-placement="bottom-end"
      >
        <i class="ki-duotone ki-filter fs-3">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>

        <%= attendanceView.filters.selectedLabel %>

        <i class="ki-duotone ki-down fs-5 ms-1"></i>
      </button>

      <div
        class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-250px py-3"
        data-kt-menu="true"
      >
        <% attendanceView.filters.options.forEach((option) => { %>
        <div class="menu-item px-3">
          <a href="<%= option.url %>" class="menu-link px-3 <%= option.active ? 'active' : '' %>">
            <span class="menu-title"> <%= option.label %> </span>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- ─────────────────────────────── OCCURRENCES ─────────────────────────────── -->

  <% if (attendanceView.hasOccurrences) { %>
  <div class="d-flex flex-column gap-6">
    <% attendanceView.occurrences.forEach((occurrence) => { %>
    <div
      class="card"
      data-occurrence-id="<%= occurrence.data.occurrenceId %>"
      data-shift-id="<%= occurrence.data.shiftId %>"
      data-slot-number="<%= occurrence.data.slotNumber %>"
      data-sequence-number="<%= occurrence.data.sequenceNumber %>"
      data-attendance-status="<%= occurrence.data.attendanceStatus %>"
    >
      <div class="card-body p-6 p-lg-8">
        <!-- ───────────────── OCCURRENCE HEADER ───────────────── -->

        <div class="d-flex flex-column flex-xl-row justify-content-between gap-6 mb-7">
          <div class="d-flex align-items-start gap-4">
            <div class="symbol symbol-60px symbol-circle flex-shrink-0">
              <% if (occurrence.professional.photo) { %>
              <img
                src="<%= occurrence.professional.photo %>"
                alt="<%= occurrence.professional.name %>"
              />
              <% } else { %>
              <div class="symbol-label fs-3 fw-bold bg-light-primary text-primary">
                <%= occurrence.professional.initials %>
              </div>
              <% } %>
            </div>

            <div>
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="fw-bold fs-3 text-gray-900">
                  <%= occurrence.professional.name %>
                </span>

                <span class="badge <%= occurrence.attendanceStatusBadgeClass %>">
                  <%= occurrence.attendanceStatusLabel %>
                </span>

                <span class="badge <%= occurrence.timing.badgeClass %>">
                  <%= occurrence.timing.label %>
                </span>

                <% if (occurrence.hasActiveCase) { %>
                <span class="badge badge-light-danger"> Active case </span>
                <% } %>
              </div>

              <div class="fw-semibold text-gray-700 mb-2"><%= occurrence.occurrenceLabel %></div>

              <div class="d-flex flex-wrap gap-3 fs-7 text-muted">
                <% if (occurrence.professional.professionalTypeLabel) { %>
                <span> <%= occurrence.professional.professionalTypeLabel %> </span>
                <% } %> <% if (occurrence.professional.specialty) { %>
                <span> · <%= occurrence.professional.specialty %> </span>
                <% } %> <% if (occurrence.referenceCode) { %>
                <span class="font-monospace"> · <%= occurrence.referenceCode %> </span>
                <% } %>
              </div>
            </div>
          </div>

          <% if (occurrence.shift) { %>
          <div class="text-xl-end">
            <div class="fw-bold text-gray-900 mb-1"><%= occurrence.shift.roleTitle %></div>

            <% if (occurrence.shift.referenceCode) { %>
            <div class="fs-7 text-muted mb-2"><%= occurrence.shift.referenceCode %></div>
            <% } %> <% if (occurrence.shift.branch) { %>
            <div class="fs-7 text-muted">
              <i class="ki-duotone ki-geolocation fs-6 me-1">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>

              <%= occurrence.shift.branch.name %>
            </div>
            <% } %>
          </div>
          <% } %>
        </div>

        <!-- ───────────────── OCCURRENCE IDENTITY ───────────────── -->

        <div class="row g-4 mb-7">
          <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-4 h-100">
              <div class="fs-8 text-muted mb-1">Position</div>

              <div class="fw-bold text-gray-900"><%= occurrence.positionLabel %></div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-4 h-100">
              <div class="fs-8 text-muted mb-1">Work date</div>

              <div class="fw-bold text-gray-900"><%= occurrence.dateLabel %></div>

              <div class="fs-8 text-muted mt-1"><%= occurrence.occurrenceDateDisplay %></div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-4 h-100">
              <div class="fs-8 text-muted mb-1">Scheduled time</div>

              <div class="fw-bold text-gray-900">
                <%= occurrence.startTimeDisplay %> – <%= occurrence.endTimeDisplay %>
              </div>

              <% if (occurrence.scheduleTimeZone) { %>
              <div class="fs-8 text-muted mt-1"><%= occurrence.scheduleTimeZone %></div>
              <% } %>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="border rounded p-4 h-100">
              <div class="fs-8 text-muted mb-2">Assignment</div>

              <span class="badge <%= occurrence.assignmentStatusBadgeClass %>">
                <%= occurrence.assignmentStatusLabel %>
              </span>
            </div>
          </div>
        </div>

        <!-- ───────────────── STATUS STRIP ───────────────── -->

        <div class="row g-4 mb-7">
          <div class="col-md-4">
            <div class="bg-light rounded p-4 h-100">
              <div class="fs-8 text-muted mb-2">Occurrence state</div>

              <span class="badge <%= occurrence.occurrenceStatusBadgeClass %>">
                <%= occurrence.occurrenceStatusLabel %>
              </span>
            </div>
          </div>

          <div class="col-md-4">
            <div class="bg-light rounded p-4 h-100">
              <div class="fs-8 text-muted mb-2">Attendance state</div>

              <span class="badge <%= occurrence.attendanceStatusBadgeClass %>">
                <%= occurrence.attendanceStatusLabel %>
              </span>
            </div>
          </div>

          <div class="col-md-4">
            <div class="bg-light rounded p-4 h-100">
              <div class="fs-8 text-muted mb-2">Settlement state</div>

              <span class="badge <%= occurrence.settlementStatusBadgeClass %>">
                <%= occurrence.settlementStatusLabel %>
              </span>
            </div>
          </div>
        </div>

        <!-- ───────────────── ATTENDANCE TIMES ───────────────── -->

        <div class="row g-5 mb-7">
          <div class="col-lg-6">
            <div class="border rounded p-5 h-100">
              <div class="d-flex align-items-center gap-3 mb-4">
                <div class="symbol symbol-40px">
                  <div class="symbol-label bg-light-success">
                    <i class="ki-duotone ki-login fs-2 text-success">
                      <span class="path1"></span>
                      <span class="path2"></span>
                      <span class="path3"></span>
                    </i>
                  </div>
                </div>

                <div>
                  <div class="fw-bold text-gray-900">Check-in</div>

                  <div class="fs-8 text-muted">Recorded attendance start</div>
                </div>
              </div>

              <% if (occurrence.checkedInAt) { %>
              <div class="fw-bold fs-5 text-gray-900 mb-2">
                <%= occurrence.checkedInAtDisplay %>
              </div>

              <% if (occurrence.checkInPinUsedAt) { %>
              <div class="fs-8 text-muted">PIN used: <%= occurrence.checkInPinUsedAtDisplay %></div>
              <% } %> <% } else { %>
              <div class="text-muted fs-7">No check-in has been recorded.</div>
              <% } %>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="border rounded p-5 h-100">
              <div class="d-flex align-items-center gap-3 mb-4">
                <div class="symbol symbol-40px">
                  <div class="symbol-label bg-light-info">
                    <i class="ki-duotone ki-exit-right fs-2 text-info">
                      <span class="path1"></span>
                      <span class="path2"></span>
                      <span class="path3"></span>
                    </i>
                  </div>
                </div>

                <div>
                  <div class="fw-bold text-gray-900">Check-out</div>

                  <div class="fs-8 text-muted">Recorded attendance end</div>
                </div>
              </div>

              <% if (occurrence.checkedOutAt) { %>
              <div class="fw-bold fs-5 text-gray-900 mb-2">
                <%= occurrence.checkedOutAtDisplay %>
              </div>

              <% if (occurrence.checkOutPinUsedAt) { %>
              <div class="fs-8 text-muted">
                PIN used: <%= occurrence.checkOutPinUsedAtDisplay %>
              </div>
              <% } %> <% } else { %>
              <div class="text-muted fs-7">No check-out has been recorded.</div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- ───────────────── PIN ACCESS ───────────────── -->

        <div class="border border-dashed rounded p-5 mb-7">
          <div
            class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4"
          >
            <div>
              <div class="fw-bold text-gray-900 mb-1">Attendance PIN access</div>

              <div class="fs-8 text-muted">
                PINs are occurrence-specific and revealed only when currently authorized.
              </div>
            </div>

            <% if (occurrence.pinAccess.actions.length > 0) { %>
            <div class="d-flex flex-wrap gap-2">
              <% occurrence.pinAccess.actions.forEach((action) => { %>
              <button
                type="button"
                class="btn btn-sm <%= action.buttonClass %> js-attendance-pin-trigger"
                data-bs-toggle="modal"
                data-bs-target="#<%= attendanceView.pinModal.id %>"
                data-pin-config="<%= JSON.stringify(action) %>"
                data-pin-context="<%= occurrence.occurrenceLabel %>"
                data-occurrence-reference="<%= occurrence.referenceCode %>"
              >
                <% if (action.icon) { %>
                <i class="ki-duotone <%= action.icon %> fs-5">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>
                <% } %> <%= action.label %>
              </button>
              <% }) %>
            </div>
            <% } else if (occurrence.pinAccess.unavailableMessage) { %>
            <div class="fs-7 text-muted"><%= occurrence.pinAccess.unavailableMessage %></div>
            <% } %>
          </div>
        </div>

        <!-- ───────────────── ATTENDANCE TIMELINE ───────────────── -->

        <% if (occurrence.timeline.length > 0) { %>
        <div class="border rounded p-5 mb-7">
          <div class="fw-bold text-gray-900 mb-4">Attendance activity</div>

          <div class="d-flex flex-column gap-3">
            <% occurrence.timeline.forEach((item) => { %>
            <div
              class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2"
            >
              <div class="d-flex align-items-center gap-2">
                <span class="badge <%= item.badgeClass %>"> <%= item.label %> </span>
              </div>

              <div class="fs-7 fw-semibold text-gray-700"><%= item.value %></div>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- ───────────────── ATTENDANCE OVERRIDE ───────────────── -->

        <% if (occurrence.attendanceOverride.visible) { %>
        <div
          class="notice d-flex rounded border border-dashed border-warning bg-light-warning p-5 mb-7"
        >
          <i class="ki-duotone ki-shield-tick fs-2x text-warning me-4">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          <div class="flex-grow-1">
            <div class="fw-bold text-gray-900 mb-3">Attendance override</div>

            <div class="row g-4">
              <% if (occurrence.attendanceOverride.typeLabel) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Type</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.attendanceOverride.typeLabel %>
                </div>
              </div>
              <% } %> <% if (occurrence.attendanceOverride.reasonLabel) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Reason</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.attendanceOverride.reasonLabel %>
                </div>
              </div>
              <% } %> <% if (occurrence.attendanceOverride.approvedStartTime) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Approved start</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.attendanceOverride.approvedStartTimeDisplay %>
                </div>
              </div>
              <% } %> <% if (occurrence.attendanceOverride.approvedEndTime) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Approved end</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.attendanceOverride.approvedEndTimeDisplay %>
                </div>
              </div>
              <% } %>
            </div>

            <% if (occurrence.attendanceOverride.notes) { %>
            <div class="fs-7 text-gray-700 mt-4"><%= occurrence.attendanceOverride.notes %></div>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- ───────────────── LATE CHECKOUT ───────────────── -->

        <% if (occurrence.lateCheckout.visible) { %>
        <div class="border rounded p-5 mb-7">
          <div class="fw-bold text-gray-900 mb-4">Late checkout</div>

          <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
              <div class="fs-8 text-muted">Minutes after scheduled end</div>

              <div class="fw-semibold text-gray-800">
                <%= occurrence.lateCheckout.minutesLate %>
              </div>
            </div>

            <% if (occurrence.lateCheckout.selectedOptionLabel) { %>
            <div class="col-sm-6 col-xl-3">
              <div class="fs-8 text-muted">Checkout selection</div>

              <div class="fw-semibold text-gray-800">
                <%= occurrence.lateCheckout.selectedOptionLabel %>
              </div>
            </div>
            <% } %> <% if (occurrence.lateCheckout.reasonLabel) { %>
            <div class="col-sm-6 col-xl-3">
              <div class="fs-8 text-muted">Reason</div>

              <div class="fw-semibold text-gray-800">
                <%= occurrence.lateCheckout.reasonLabel %>
              </div>
            </div>
            <% } %> <% if (occurrence.lateCheckout.recordedAt) { %>
            <div class="col-sm-6 col-xl-3">
              <div class="fs-8 text-muted">Recorded</div>

              <div class="fw-semibold text-gray-800">
                <%= occurrence.lateCheckout.recordedAtDisplay %>
              </div>
            </div>
            <% } %>
          </div>

          <% if (occurrence.lateCheckout.notes) { %>
          <div class="fs-7 text-gray-700 mt-4"><%= occurrence.lateCheckout.notes %></div>
          <% } %>
        </div>
        <% } %>

        <!-- ───────────────── CHECKOUT FALLBACK ───────────────── -->

        <% if (occurrence.checkoutFallback.visible) { %>
        <div
          class="notice d-flex rounded border border-dashed border-warning bg-light-warning p-5 mb-7"
        >
          <i class="ki-duotone ki-information fs-2x text-warning me-4">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
              <span class="fw-bold text-gray-900"> Checkout fallback </span>

              <% if (occurrence.checkoutFallback.isResolved) { %>
              <span class="badge badge-light-success"> Resolved </span>
              <% } else { %>
              <span class="badge badge-light-warning"> Awaiting review </span>
              <% } %>
            </div>

            <div class="row g-4">
              <% if (occurrence.checkoutFallback.reasonLabel) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Reason</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.checkoutFallback.reasonLabel %>
                </div>
              </div>
              <% } %> <% if (occurrence.checkoutFallback.requestedAt) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Requested</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.checkoutFallback.requestedAtDisplay %>
                </div>
              </div>
              <% } %> <% if (occurrence.checkoutFallback.resolvedAt) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Resolved</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.checkoutFallback.resolvedAtDisplay %>
                </div>
              </div>
              <% } %> <% if (occurrence.checkoutFallback.approvedEndTime) { %>
              <div class="col-sm-6 col-xl-3">
                <div class="fs-8 text-muted">Approved end</div>

                <div class="fw-semibold text-gray-800">
                  <%= occurrence.checkoutFallback.approvedEndTimeDisplay %>
                </div>
              </div>
              <% } %>
            </div>

            <% if (occurrence.checkoutFallback.notes) { %>
            <div class="fs-7 text-gray-700 mt-4"><%= occurrence.checkoutFallback.notes %></div>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- ───────────────── ABSENCE EXPLANATION ───────────────── -->

        <% if (occurrence.absence.visible) { %>
        <div
          class="notice d-flex rounded border border-dashed border-danger bg-light-danger p-5 mb-7"
        >
          <i class="ki-duotone ki-user-cross fs-2x text-danger me-4">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          <div>
            <div class="fw-bold text-gray-900 mb-2">Absence explanation</div>

            <div class="fs-7 text-gray-700 mb-2"><%= occurrence.absence.explanation %></div>

            <% if (occurrence.absence.explainedAt) { %>
            <div class="fs-8 text-muted">
              Submitted: <%= occurrence.absence.explainedAtDisplay %>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- ───────────────── ASSIGNMENT CONTEXT ───────────────── -->

        <% if (occurrence.assignment) { %>
        <div class="border border-dashed rounded p-5 mb-7">
          <div
            class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4"
          >
            <div>
              <div class="fw-bold text-gray-900 mb-2">Assignment context</div>

              <div class="d-flex flex-wrap align-items-center gap-2">
                <% if (occurrence.assignment.referenceCode) { %>
                <span class="font-monospace fs-7 text-gray-700">
                  <%= occurrence.assignment.referenceCode %>
                </span>
                <% } %> <% if (occurrence.assignment.assignmentTypeLabel) { %>
                <span class="badge badge-light">
                  <%= occurrence.assignment.assignmentTypeLabel %>
                </span>
                <% } %> <% if (occurrence.assignment.statusLabel) { %>
                <span class="badge <%= occurrence.assignment.statusBadgeClass %>">
                  <%= occurrence.assignment.statusLabel %>
                </span>
                <% } %>
              </div>
            </div>

            <% if (occurrence.assignment.detailsUrl) { %>
            <a href="<%= occurrence.assignment.detailsUrl %>" class="btn btn-sm btn-light">
              View assignments
            </a>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- ───────────────── FOOTER ───────────────── -->

        <div
          class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 border-top pt-5"
        >
          <div class="fs-8 text-muted">
            <span class="font-monospace"> Occurrence ID: <%= occurrence.id %> </span>

            <span class="mx-2"> · </span>

            <span>
              Position <%= occurrence.slotNumber %> / Work date <%= occurrence.sequenceNumber %>
            </span>
          </div>

          <% if (occurrence.detailsUrl) { %>
          <a href="<%= occurrence.detailsUrl %>" class="btn btn-sm btn-light-primary">
            <i class="ki-duotone ki-eye fs-5">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            View occurrence
          </a>
          <% } %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <!-- ─────────────────────────────── EMPTY STATE ─────────────────────────────── -->

  <div class="card">
    <div class="card-body py-15 text-center">
      <div class="mb-5">
        <i class="ki-duotone <%= attendanceView.emptyState.icon %> fs-5x text-gray-400">
          <span class="path1"></span>
          <span class="path2"></span>
          <span class="path3"></span>
          <span class="path4"></span>
        </i>
      </div>

      <h3 class="fw-bold text-gray-900 mb-2"><%= attendanceView.emptyState.title %></h3>

      <div class="text-muted fs-6 mb-6"><%= attendanceView.emptyState.message %></div>

      <% if (attendanceView.emptyState.action.visible) { %>
      <a
        href="<%= attendanceView.emptyState.action.url %>"
        class="btn <%= attendanceView.emptyState.action.buttonClass %>"
      >
        <%= attendanceView.emptyState.action.label %>
      </a>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ─────────────────────────────── PAGINATION ─────────────────────────────── -->

  <% if (attendanceView.pagination.hasPagination) { %>
  <div
    class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 mt-8"
  >
    <div class="fs-7 text-muted"><%= attendanceView.pagination.pageText %></div>

    <div class="d-flex gap-2">
      <% if (attendanceView.pagination.previous.enabled) { %>
      <a href="<%= attendanceView.pagination.previous.url %>" class="btn btn-sm btn-light">
        <%= attendanceView.pagination.previous.label %>
      </a>
      <% } else { %>
      <button type="button" class="btn btn-sm btn-light" disabled>
        <%= attendanceView.pagination.previous.label %>
      </button>
      <% } %> <% if (attendanceView.pagination.next.enabled) { %>
      <a href="<%= attendanceView.pagination.next.url %>" class="btn btn-sm btn-light">
        <%= attendanceView.pagination.next.label %>
      </a>
      <% } else { %>
      <button type="button" class="btn btn-sm btn-light" disabled>
        <%= attendanceView.pagination.next.label %>
      </button>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<!-- ─────────────────────────────── ATTENDANCE PIN MODAL ─────────────────────────────── -->

<% if (attendanceView.pinModal.enabled) { %>
<div
  class="modal fade"
  id="<%= attendanceView.pinModal.id %>"
  tabindex="-1"
  aria-labelledby="<%= attendanceView.pinModal.titleId %>"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered mw-500px">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h2 class="fw-bold text-gray-900 mb-1" id="<%= attendanceView.pinModal.titleId %>">
            <%= attendanceView.pinModal.defaultTitle %>
          </h2>

          <div class="fs-7 text-muted" id="<%= attendanceView.pinModal.contextId %>"></div>
        </div>

        <button
          type="button"
          class="btn btn-icon btn-sm btn-active-light-primary"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="ki-duotone ki-cross fs-2">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
        </button>
      </div>

      <div class="modal-body py-10 px-lg-10">
        <div
          class="alert alert-danger d-none mb-6"
          id="<%= attendanceView.pinModal.alertId %>"
          role="alert"
        ></div>

        <div class="text-center py-8 js-attendance-pin-loading d-none">
          <div class="spinner-border text-primary mb-4" role="status"></div>

          <div class="text-muted fs-7"><%= attendanceView.pinModal.loadingText %></div>
        </div>

        <div class="text-center d-none js-attendance-pin-result">
          <div class="text-muted fs-7 mb-3">Attendance PIN</div>

          <div
            class="fw-bolder fs-3x text-gray-900 font-monospace letter-spacing"
            id="<%= attendanceView.pinModal.pinValueId %>"
          ></div>

          <div class="text-muted fs-8 mt-4">
            Share this PIN only with the professional assigned to this exact occurrence.
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
          <%= attendanceView.pinModal.closeButtonLabel %>
        </button>
      </div>
    </div>
  </div>
</div>
<% } %>
