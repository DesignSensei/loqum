<!-- views/employer/shifts/index.ejs -->

<div
  id="manageShiftsPage"
  data-currency="<%= shiftsView.employer.currency %>"
>
  <!-- POSTING AVAILABILITY  -->

  <% if (shiftsView.postShiftForm.unavailableMessage) { %>
    <div
      class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-6 mb-8"
    >
      <i class="ki-duotone ki-information-5 fs-2tx text-warning me-4">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
      </i>

      <div class="d-flex flex-stack flex-grow-1">
        <div class="fw-semibold">
          <div class="fs-6 text-gray-700">
            <%= shiftsView.postShiftForm.unavailableMessage %>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <% if (
    shiftsView.postShiftForm.canOpenModal &&
    !shiftsView.postShiftForm.hasSelectableBranches
  ) { %>
    <div
      class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-6 mb-8"
    >
      <i class="ki-duotone ki-information-5 fs-2tx text-warning me-4">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
      </i>

      <div class="d-flex flex-stack flex-grow-1">
        <div class="fw-semibold">
          <% if (shiftsView.postShiftForm.hasBranches) { %>
            <div class="fs-6 text-gray-700">
              No active branch with a valid location is available.
            </div>

            <div class="fs-7 text-muted mt-1">
              Update a branch location before posting a shift.
            </div>
          <% } else { %>
            <div class="fs-6 text-gray-700">
              No active branch is available.
            </div>

            <div class="fs-7 text-muted mt-1">
              Add or assign an active branch before posting a shift.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- SHIFT SUMMARY CARDS -->

<div class="row g-5 g-xl-8 mb-8">
  <% shiftsView.summaryCards.forEach((card) => { %>
    <div class="col-sm-6 col-lg-4 col-xl">
      <div class="card card-flush h-100">
        <div
          class="card-body d-flex flex-column justify-content-center align-items-center text-center"
        >

        <!-- ALL SHIFTS -->

<% if (card.status === "all") { %>
  <div class="symbol symbol-60px mb-5">
    <span class="symbol-label bg-light-dark">
      <i class="ki-duotone ki-abstract-26 fs-2x text-dark">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
    </span>
  </div>

  <div class="fs-2 fw-bold text-gray-900">
    <%= card.count %>
  </div>
<% } %>
          <!-- OPEN -->

          <% if (card.status === "open") { %>
            <div class="symbol symbol-60px mb-5">
              <span class="symbol-label bg-light-primary">
                <i class="ki-duotone ki-briefcase fs-2x text-primary">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
              </span>
            </div>

            <div class="fs-2 fw-bold text-primary">
              <%= card.count %>
            </div>
          <% } %>

          <!-- CONFIRMED -->

          <% if (card.status === "confirmed") { %>
            <div class="symbol symbol-60px mb-5">
              <span class="symbol-label bg-light-info">
                <i class="ki-duotone ki-user-tick fs-2x text-info">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>
              </span>
            </div>

            <div class="fs-2 fw-bold text-info">
              <%= card.count %>
            </div>
          <% } %>

          <!-- IN PROGRESS -->

          <% if (card.status === "in_progress") { %>
            <div class="symbol symbol-60px mb-5">
              <span class="symbol-label bg-light-warning">
                <i class="ki-duotone ki-time fs-2x text-warning">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
              </span>
            </div>

            <div class="fs-2 fw-bold text-warning">
              <%= card.count %>
            </div>
          <% } %>

          <!-- PENDING SETTLEMENT -->

          <% if (card.status === "pending_settlement") { %>
            <div class="symbol symbol-60px mb-5">
              <span class="symbol-label bg-light-danger">
                <i class="ki-duotone ki-wallet fs-2x text-danger">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                  <span class="path4"></span>
                </i>
              </span>
            </div>

            <div class="fs-2 fw-bold text-danger">
              <%= card.count %>
            </div>
          <% } %>

          <!-- COMPLETED -->

          <% if (card.status === "completed") { %>
            <div class="symbol symbol-60px mb-5">
              <span class="symbol-label bg-light-success">
                <i class="ki-duotone ki-check-circle fs-2x text-success">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
              </span>
            </div>

            <div class="fs-2 fw-bold text-success">
              <%= card.count %>
            </div>
          <% } %>

          <div class="fs-6 fw-semibold text-gray-700">
            <%= card.label %>
          </div>

          <div class="fs-7 fw-semibold text-muted mt-1">
            <%= card.description %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

  <!-- ─────────────────────────────── SHIFTS TABLE ─────────────────────────────── -->

  <div class="card">
    <div class="card-header">
      <div class="card-title">
        <div>
          <h3 class="fw-bold m-0">
            <%= shiftsView.selectedStatusLabel %>
          </h3>

          <div class="fs-7 text-muted mt-1">
            <% if (shiftsView.pagination.totalItems > 0) { %>
              Showing
              <%= shiftsView.pagination.startItem %>–<%= shiftsView.pagination.endItem %>
              of
              <%= shiftsView.pagination.totalItems %>
              shifts
            <% } else { %>
              No shifts found
            <% } %>
          </div>
        </div>
      </div>

      <div class="card-toolbar d-flex align-items-center gap-3">
        <% if (
          shiftsView.filterTabs &&
          shiftsView.filterTabs.length > 0
        ) { %>
          <button
            type="button"
            class="btn btn-sm btn-light btn-active-light-primary"
            data-kt-menu-trigger="click"
            data-kt-menu-placement="bottom-end"
          >
            <i class="ki-duotone ki-filter fs-3">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>

            <%= shiftsView.selectedStatusLabel %>

            <i class="ki-duotone ki-down fs-5 ms-1"></i>
          </button>

          <div
            class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-225px py-3"
            data-kt-menu="true"
          >
            <% shiftsView.filterTabs.forEach((filter) => { %>
              <div class="menu-item px-3">
                <a
                  href="<%= filter.url %>"
                  class="menu-link px-3 <%= filter.isActive ? 'active' : '' %>"
                >
                  <span class="menu-title">
                    <%= filter.label %>
                  </span>

                  <% if (filter.isActive) { %>
                    <span class="menu-icon ms-2">
                      <i class="ki-duotone ki-check fs-4">
                        <span class="path1"></span>
                        <span class="path2"></span>
                      </i>
                    </span>
                  <% } %>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>

        <% if (
          shiftsView.postShiftForm.canOpenModal &&
          shiftsView.postShiftForm.hasSelectableBranches
        ) { %>
          <button
            type="button"
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#<%= shiftsView.postShiftForm.modalId %>"
          >
            <i class="ki-duotone ki-plus fs-3"></i>
            Post a Shift
          </button>
        <% } else { %>
          <button
            type="button"
            class="btn btn-sm btn-primary"
            disabled
            title="<%= shiftsView.postShiftForm.unavailableMessage || 'Add an active branch with a valid location before posting a shift.' %>"
          >
            <i class="ki-duotone ki-plus fs-3"></i>
            Post a Shift
          </button>
        <% } %>
      </div>
    </div>

    <div class="card-body">
      <% if (shiftsView.hasShifts) { %>
        <div class="table-responsive">
          <table class="table align-middle table-row-dashed fs-6 gy-5">
            <thead>
              <tr
                class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0"
              >
                <th>Shift</th>
                <th>Branch</th>
                <th>Schedule</th>
                <th>Pay</th>
                <th>Status</th>
                <th>Applications</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody class="fw-semibold text-gray-700">
              <% shiftsView.shifts.forEach((shift) => { %>
                <tr>
                  <!-- SHIFT -->

                  <td>
                    <div class="d-flex flex-column">
                      <span class="fw-bold text-gray-900">
                        <%= shift.roleTitle %>
                      </span>

                      <span class="fs-7 text-muted mt-1">
                        <%= shift.professionalTypeLabel %>
                      </span>

                      <span class="fs-8 text-muted mt-1">
                        <%= shift.referenceCode %>
                      </span>
                    </div>
                  </td>

                  <!-- BRANCH -->

                  <td>
                    <% if (shift.branch) { %>
                      <div class="d-flex flex-column">
                        <span class="fw-bold text-gray-800">
                          <%= shift.branch.name %>
                        </span>

                        <% if (shift.branch.address) { %>
                          <span class="fs-7 text-muted mt-1">
                            <%= shift.branch.address %>
                          </span>
                        <% } %>

                        <% if (shift.branch.lga) { %>
                          <span class="fs-7 text-muted">
                            <%= shift.branch.lga %>
                          </span>
                        <% } %>

                        <% if (shift.branch.state) { %>
                          <span class="fs-7 text-muted">
                            <%= shift.branch.state %>
                          </span>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span class="text-muted">
                        Branch unavailable
                      </span>
                    <% } %>
                  </td>

                  <!-- SCHEDULE -->

                  <td>
                    <div class="d-flex flex-column">
                      <span class="fw-bold text-gray-800">
                        <%= shift.startDateDisplay %>
                      </span>

                      <span class="fs-7 text-muted mt-1">
                        <%= shift.startTimeDisplay %>
                        –
                        <%= shift.endTimeDisplay %>
                      </span>

                      <span class="fs-7 text-muted mt-1">
                        <%= shift.scheduledHoursDisplay %>
                      </span>

                      <span class="fs-8 text-muted">
                        <%= shift.breakDurationDisplay %>
                      </span>
                    </div>
                  </td>

                  <!-- PAY -->

                  <td>
                    <div class="d-flex flex-column">
                      <span class="fw-bold text-gray-900">
                        <%= shift.hourlyRateDisplay %>/hour
                      </span>

                      <span class="fs-7 text-muted mt-1">
                        Professional:
                        <%= shift.estimatedProfessionalPayDisplay %>
                      </span>

                      <span class="fs-7 text-muted">
                        Platform fee:
                        <%= shift.estimatedPlatformFeeDisplay %>
                      </span>

                      <span class="fs-7 fw-bold text-gray-700 mt-1">
                        Total:
                        <%= shift.estimatedEmployerChargeDisplay %>
                      </span>
                    </div>
                  </td>

                  <!-- STATUS -->

                  <td>
                    <div class="d-flex flex-column align-items-start gap-2">
                      <span
                        class="badge <%= shift.statusBadgeClass || 'badge-light-primary' %>"
                      >
                        <%= shift.statusLabel %>
                      </span>

                      <span
                        class="badge <%= shift.paymentStatusBadgeClass || 'badge-light-secondary' %>"
                      >
                        <%= shift.paymentStatusLabel %>
                      </span>
                    </div>
                  </td>

                  <!-- APPLICATIONS -->

                  <td>
                    <span class="badge badge-light-primary">
                      <%= shift.totalApplications %>
                    </span>
                  </td>

                  <!-- ACTIONS -->

                  <td class="text-end">
                    <% if (
                      shift.canRevealCheckInPin ||
                      shift.canRevealCheckOutPin
                    ) { %>
                      <button
                        type="button"
                        class="btn btn-sm btn-light btn-active-light-primary"
                        data-kt-menu-trigger="click"
                        data-kt-menu-placement="bottom-end"
                      >
                        Actions

                        <i class="ki-duotone ki-down fs-5 ms-1"></i>
                      </button>

                      <div
                        class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-175px py-3"
                        data-kt-menu="true"
                      >
                        <% if (shift.canRevealCheckInPin) { %>
                          <div class="menu-item px-3">
                            <a
                              href="#"
                              class="menu-link px-3 js-reveal-attendance-pin"
                              data-pin-url="<%= shift.checkInPinUrl %>"
                              data-pin-type="check_in"
                              data-shift-reference="<%= shift.referenceCode %>"
                            >
                              Check-in PIN
                            </a>
                          </div>
                        <% } %>

                        <% if (shift.canRevealCheckOutPin) { %>
                          <div class="menu-item px-3">
                            <a
                              href="#"
                              class="menu-link px-3 js-reveal-attendance-pin"
                              data-pin-url="<%= shift.checkOutPinUrl %>"
                              data-pin-type="check_out"
                              data-shift-reference="<%= shift.referenceCode %>"
                            >
                              Check-out PIN
                            </a>
                          </div>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span class="text-muted fs-7">
                        No Actions
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- ─────────────────────────────── PAGINATION ─────────────────────────────── -->

        <% if (shiftsView.pagination.hasPagination) { %>
          <div
            class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 pt-5"
          >
            <div class="fs-7 text-muted">
              Showing
              <%= shiftsView.pagination.startItem %>
              to
              <%= shiftsView.pagination.endItem %>
              of
              <%= shiftsView.pagination.totalItems %>
              shifts
            </div>

            <ul class="pagination mb-0">
              <li
                class="page-item previous <%= shiftsView.pagination.hasPreviousPage ? '' : 'disabled' %>"
              >
                <% if (shiftsView.pagination.hasPreviousPage) { %>
                  <a
                    href="<%= shiftsView.pagination.previousPageUrl %>"
                    class="page-link"
                    aria-label="Previous page"
                  >
                    <i class="previous"></i>
                  </a>
                <% } else { %>
                  <span class="page-link">
                    <i class="previous"></i>
                  </span>
                <% } %>
              </li>

              <% shiftsView.pagination.pages.forEach((paginationPage) => { %>
                <li
                  class="page-item <%= paginationPage.isActive ? 'active' : '' %>"
                >
                  <a
                    href="<%= paginationPage.url %>"
                    class="page-link"
                    <%- paginationPage.isActive ? 'aria-current="page"' : "" %>
                  >
                    <%= paginationPage.page %>
                  </a>
                </li>
              <% }) %>

              <li
                class="page-item next <%= shiftsView.pagination.hasNextPage ? '' : 'disabled' %>"
              >
                <% if (shiftsView.pagination.hasNextPage) { %>
                  <a
                    href="<%= shiftsView.pagination.nextPageUrl %>"
                    class="page-link"
                    aria-label="Next page"
                  >
                    <i class="next"></i>
                  </a>
                <% } else { %>
                  <span class="page-link">
                    <i class="next"></i>
                  </span>
                <% } %>
              </li>
            </ul>
          </div>
        <% } %>
      <% } else { %>
        <!-- ─────────────────────────────── EMPTY STATE ─────────────────────────────── -->

        <div class="text-center py-10">
          <div class="symbol symbol-60px mb-5">
            <span class="symbol-label bg-light-primary">
              <i class="ki-duotone ki-information fs-2x text-primary">
                <span class="path1"></span>
                <span class="path2"></span>
                <span class="path3"></span>
              </i>
            </span>
          </div>

          <div class="fw-bold fs-5 text-gray-800 mb-2">
            No Shifts Found
          </div>

          <div class="text-muted fw-semibold mb-5">
            <%= shiftsView.emptyState.message %>
          </div>

          <% if (
            shiftsView.emptyState.canPostShift &&
            shiftsView.postShiftForm.hasSelectableBranches
          ) { %>
            <button
              type="button"
              class="btn btn-sm btn-primary"
              data-bs-toggle="modal"
              data-bs-target="#<%= shiftsView.emptyState.postShiftModalId %>"
            >
              <i class="ki-duotone ki-plus fs-3"></i>
              Post Your First Shift
            </button>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ─────────────────────────────── POST SHIFT MODAL ─────────────────────────────── -->

<% if (
  shiftsView.postShiftForm.canOpenModal &&
  shiftsView.postShiftForm.hasSelectableBranches
) { %>
  <div
  class="modal fade post-shift-modal"
  id="<%= shiftsView.postShiftForm.modalId %>"
  tabindex="-1"
  aria-labelledby="<%= shiftsView.postShiftForm.modalId %>Label"
  aria-hidden="true"
>
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <form
      class="modal-content"
      id="postShiftForm"
      method="post"
      action="<%= shiftsView.postShiftForm.createShiftUrl %>"
      data-platform-fee-rate="<%= shiftsView.postShiftForm.pricing.platformFeeRate %>"
      data-platform-fee-label="<%= shiftsView.postShiftForm.pricing.platformFeeLabel %>"
      data-currency="<%= shiftsView.postShiftForm.pricing.currency %>"
      novalidate
    >
      <div class="modal-header">
            <div>
              <h2
                class="modal-title fw-bold text-gray-900"
                id="<%= shiftsView.postShiftForm.modalId %>Label"
              >
                Post a Shift
              </h2>

              <div class="fs-7 text-muted mt-1">
                Complete the details below to publish a new shift.
              </div>
            </div>

            <button
              type="button"
              class="btn btn-icon btn-sm btn-active-light-primary"
              data-bs-dismiss="modal"
              aria-label="Close"
            >
              <i class="ki-duotone ki-cross fs-2">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </button>
          </div>

          <div class="modal-body py-10 px-lg-17">
            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >

            <div
              class="alert alert-danger d-none"
              id="postShiftFormAlert"
              role="alert"
            ></div>

            <div class="row g-8">
              <!-- SHIFT DETAILS -->

              <div class="col-12">
                <div class="fw-bold fs-5 text-gray-900">
                  Shift Details
                </div>

                <div class="fs-7 text-muted mt-1">
                  Select the branch and professional requirements.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftBranchId"
                  class="required form-label fw-semibold"
                >
                  Branch
                </label>

                <select
                  class="form-select"
                  id="shiftBranchId"
                  name="branchId"
                  required
                >
                  <option value="">
                    Select a branch
                  </option>

                  <% shiftsView.postShiftForm.branchOptions.forEach((branch) => { %>
                    <option
                      value="<%= branch.value %>"
                      <%= branch.isSelectable ? "" : "disabled" %>
                    >
                      <%= branch.name %>

                      <% if (branch.locationLabel) { %>
                        — <%= branch.locationLabel %>
                      <% } %>

                      <% if (!branch.isSelectable) { %>
                        — Location required
                      <% } %>
                    </option>
                  <% }) %>
                </select>

                <div class="invalid-feedback">
                  Select an available branch.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftProfessionalType"
                  class="required form-label fw-semibold"
                >
                  Professional Type
                </label>

                <select
                  class="form-select"
                  id="shiftProfessionalType"
                  name="professionalType"
                  required
                >
                  <option value="">
                    Select a professional type
                  </option>

                  <% shiftsView.postShiftForm.professionalTypeOptions.forEach((professionalType) => { %>
                    <option value="<%= professionalType.value %>">
                      <%= professionalType.label %>
                    </option>
                  <% }) %>
                </select>

                <div class="invalid-feedback">
                  Select the professional type required for this shift.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftRoleTitle"
                  class="required form-label fw-semibold"
                >
                  Role Title
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="shiftRoleTitle"
                  name="roleTitle"
                  maxlength="120"
                  placeholder="Example: Locum Pharmacist"
                  required
                >

                <div class="invalid-feedback">
                  Enter the role title.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftDepartment"
                  class="form-label fw-semibold"
                >
                  Department
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="shiftDepartment"
                  name="department"
                  maxlength="120"
                  placeholder="Example: Outpatient Pharmacy"
                >
              </div>

              <div class="col-12">
                <div class="separator separator-dashed"></div>
              </div>

              <!-- SCHEDULE -->

              <div class="col-12">
                <div class="fw-bold fs-5 text-gray-900">
                  Schedule and Pay
                </div>

                <div class="fs-7 text-muted mt-1">
                  Shift times use
                  <%= shiftsView.postShiftForm.timeZone %>.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftStartTime"
                  class="required form-label fw-semibold"
                >
                  Start Date and Time
                </label>

               <input
  type="text"
  class="form-control"
  id="shiftStartTime"
  name="startTime"
  placeholder="Select start date and time"
  autocomplete="off"
  required
>

                <div class="invalid-feedback">
                  Select the shift start date and time.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftEndTime"
                  class="required form-label fw-semibold"
                >
                  End Date and Time
                </label>

                <input
  type="text"
  class="form-control"
  id="shiftEndTime"
  name="endTime"
  placeholder="Select end date and time"
  autocomplete="off"
  required
>

                <div class="invalid-feedback">
                  Select a valid end date and time.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftBreakDuration"
                  class="form-label fw-semibold"
                >
                  Break Duration
                </label>

                <div class="input-group">
                  <input
                    type="number"
                    class="form-control"
                    id="shiftBreakDuration"
                    name="breakDuration"
                    min="0"
                    step="1"
                    value="0"
                  >

                  <span class="input-group-text">
                    minutes
                  </span>
                </div>

                <div class="form-text">
                  Break duration is informational and is not deducted from
                  professional pay.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftHourlyRate"
                  class="required form-label fw-semibold"
                >
                  Hourly Rate
                </label>

                <div class="input-group">
                  <span class="input-group-text">
                    <%= shiftsView.postShiftForm.pricing.currency %>
                  </span>

                  <input
                    type="number"
                    class="form-control"
                    id="shiftHourlyRate"
                    name="hourlyRate"
                    min="0.01"
                    step="0.01"
                    placeholder="0.00"
                    required
                  >
                </div>

                <div class="invalid-feedback">
                  Enter an hourly rate greater than zero.
                </div>
              </div>

              <div class="col-12">
                <div class="separator separator-dashed"></div>
              </div>

              <!-- REQUIREMENTS -->

              <div class="col-12">
                <div class="fw-bold fs-5 text-gray-900">
                  Requirements and Notes
                </div>

                <div class="fs-7 text-muted mt-1">
                  Add information the professional should know before applying.
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftRequiredSkills"
                  class="form-label fw-semibold"
                >
                  Required Skills
                </label>

                <textarea
                  class="form-control"
                  id="shiftRequiredSkills"
                  name="requiredSkills"
                  rows="3"
                  placeholder="Separate skills with commas"
                ></textarea>

                <div class="form-text">
                  Example: Patient counseling, inventory management, dispensing
                </div>
              </div>

              <div class="col-md-6">
                <label
                  for="shiftDressCode"
                  class="form-label fw-semibold"
                >
                  Dress Code
                </label>

                <textarea
                  class="form-control"
                  id="shiftDressCode"
                  name="dressCode"
                  rows="3"
                  maxlength="300"
                  placeholder="Example: White coat and closed shoes"
                ></textarea>
              </div>

              <div class="col-12">
                <label
                  for="shiftDescription"
                  class="form-label fw-semibold"
                >
                  Additional Information
                </label>

                <textarea
                  class="form-control"
                  id="shiftDescription"
                  name="description"
                  rows="4"
                  maxlength="500"
                  placeholder="Add any other information the professional should know."
                ></textarea>
              </div>

              <!-- PRICING PREVIEW -->

              <div class="col-12">
                <div
                  class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-6"
                >
                  <i class="ki-duotone ki-wallet fs-2tx text-primary me-4">
                    <span class="path1"></span>
                    <span class="path2"></span>
                    <span class="path3"></span>
                    <span class="path4"></span>
                  </i>

                  <div class="flex-grow-1">
                    <div
                      class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-5"
                    >
                      <div>
                        <div class="fw-bold fs-5 text-gray-900">
                          Estimated Pricing
                        </div>

                        <div class="fs-7 text-muted mt-1">
                          Platform fee:
                          <%= shiftsView.postShiftForm.pricing.platformFeeLabel %>
                        </div>
                      </div>

                      <div class="fs-7 text-muted">
                        Final pricing is recalculated when the shift is
                        submitted.
                      </div>
                    </div>

                    <div class="row g-5">
                      <div class="col-sm-6 col-lg-3">
                        <div class="fs-7 fw-semibold text-muted">
                          Scheduled Hours
                        </div>

                        <div
                          class="fs-5 fw-bold text-gray-900 mt-1"
                          id="shiftScheduledHoursPreview"
                        >
                          —
                        </div>
                      </div>

                      <div class="col-sm-6 col-lg-3">
                        <div class="fs-7 fw-semibold text-muted">
                          Professional Pay
                        </div>

                        <div
                          class="fs-5 fw-bold text-gray-900 mt-1"
                          id="shiftProfessionalPayPreview"
                        >
                          —
                        </div>
                      </div>

                      <div class="col-sm-6 col-lg-3">
                        <div class="fs-7 fw-semibold text-muted">
                          Platform Fee
                        </div>

                        <div
                          class="fs-5 fw-bold text-gray-900 mt-1"
                          id="shiftPlatformFeePreview"
                        >
                          —
                        </div>
                      </div>

                      <div class="col-sm-6 col-lg-3">
                        <div class="fs-7 fw-semibold text-muted">
                          Employer Charge
                        </div>

                        <div
                          class="fs-4 fw-bold text-primary mt-1"
                          id="shiftEmployerChargePreview"
                        >
                          —
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer flex-center">
            <button
              type="button"
              class="btn btn-light me-3"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>

            <button
              type="submit"
              class="btn btn-primary"
              id="postShiftSubmitButton"
            >
              <span class="indicator-label">
                Post Shift
              </span>

              <span class="indicator-progress">
                Posting...

                <span
                  class="spinner-border spinner-border-sm align-middle ms-2"
                ></span>
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>
<% } %>

<!-- ─────────────────────────────── ATTENDANCE PIN MODAL ─────────────────────────────── -->

<div
  class="modal fade"
  id="attendancePinModal"
  tabindex="-1"
  aria-labelledby="attendancePinModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h2
            class="modal-title fw-bold text-gray-900"
            id="attendancePinModalLabel"
          >
            Attendance PIN
          </h2>

          <div
            class="fs-7 text-muted mt-1"
            id="attendancePinShiftReference"
          ></div>
        </div>

        <button
          type="button"
          class="btn btn-icon btn-sm btn-active-light-primary"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="ki-duotone ki-cross fs-2">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
        </button>
      </div>

      <div class="modal-body text-center py-10">
        <div
          class="alert alert-danger d-none text-start"
          id="attendancePinAlert"
          role="alert"
        ></div>

        <div
          class="spinner-border text-primary d-none"
          id="attendancePinLoader"
          role="status"
        >
          <span class="visually-hidden">
            Loading attendance PIN
          </span>
        </div>

        <div
          class="d-none"
          id="attendancePinContent"
        >
          <div class="symbol symbol-60px mb-5">
            <span class="symbol-label bg-light-primary">
              <i class="ki-duotone ki-check-circle fs-2x text-primary">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </span>
          </div>

          <div
            class="fs-6 fw-semibold text-muted mb-3"
            id="attendancePinTypeLabel"
          >
            Attendance PIN
          </div>

          <div
            class="fs-2x fw-bold text-gray-900 font-monospace mb-5"
            id="attendancePinValue"
          >
            ——— ———
          </div>

          <div class="fs-7 text-muted">
            Share this PIN only with the professional assigned to this shift.
          </div>
        </div>
      </div>

      <div class="modal-footer flex-center">
        <button
          type="button"
          class="btn btn-light"
          data-bs-dismiss="modal"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</div>