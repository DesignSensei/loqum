<!-- views/employer/shifts/show.ejs -->

<div
  id="shiftDetailsPage"
  data-shift-id="<%= shiftDetailsView.shift.id %>"
  data-csrf-token="<%= csrfToken %>"
>
  
  <!-- ─────────────────────────────── STATUS NOTICES ─────────────────────────────── -->

 <% if (shiftDetailsView.shift.isExpired) { %>
  <div
    class="notice d-flex align-items-center bg-light-danger rounded border border-danger border-dashed p-6 mb-8"
  >
    <div class="symbol symbol-50px me-4">
      <span class="symbol-label bg-light-danger">
        <i class="ki-duotone ki-information fs-2tx text-danger">
          <span class="path1"></span>
          <span class="path2"></span>
          <span class="path3"></span>
        </i>
      </span>
    </div>

    <div class="fw-semibold">
      <div class="fs-6 fw-bold text-danger">
        This Shift expired.
      </div>

      <div class="fs-7 text-gray-700 mt-1">
        It was not funded before its scheduled start time.
      </div>
    </div>
  </div>
<% } %>

<% if (shiftDetailsView.shift.needsPayment) { %>
  <div
    class="notice d-flex align-items-center bg-light-warning rounded border border-warning border-dashed p-6 mb-8"
  >
    <div class="symbol symbol-50px me-4">
      <span class="symbol-label bg-light-warning">
        <i class="ki-duotone ki-wallet fs-2tx text-warning">
          <span class="path1"></span>
          <span class="path2"></span>
          <span class="path3"></span>
          <span class="path4"></span>
        </i>
      </span>
    </div>

    <div class="d-flex flex-wrap flex-stack flex-grow-1 gap-4">
      <div class="fw-semibold">
        <div class="fs-6 fw-bold text-warning">
          Funding is required.
        </div>

        <div class="fs-7 text-gray-700 mt-1">
          This Shift will not be published until the full employer charge has
          been protected.
        </div>
      </div>

      <button
        type="button"
        class="btn btn-sm btn-warning"
        data-bs-toggle="modal"
        data-bs-target="#<%= shiftDetailsView.actions.fundShiftModalId %>"
      >
        <i class="ki-duotone ki-wallet fs-3 me-1">
          <span class="path1"></span>
          <span class="path2"></span>
          <span class="path3"></span>
          <span class="path4"></span>
        </i>

        <%= shiftDetailsView.shift.canRetryPayment ? "Retry Payment" : "Complete Payment" %>
      </button>
    </div>
  </div>
<% } %>

  <!-- MAIN CONTENT -->

  <div class="row g-6 g-xl-8">
    <div class="col-xl-8">
      <!-- SCHEDULE OVERVIEW -->

      <div class="card card-flush mb-6">
        <div class="card-header">
          <div class="card-title">
            <h2 class="fw-bold mb-0">
              Schedule
            </h2>
          </div>
        </div>

        <div class="card-body pt-0">
          <div class="row g-5">
            <div class="col-sm-6 col-lg-4">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Schedule type
                </div>

                <div class="fs-6 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.scheduleModeLabel %>
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-4">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Number of shifts
                </div>

                <div class="fs-6 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.occurrenceCountLabel %>
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-4">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Total scheduled time
                </div>

                <div class="fs-6 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.totalScheduledHoursDisplay %>
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-4">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  First work date
                </div>

                <div class="fs-6 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.firstOccurrenceDateDisplay %>
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-4">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Last work date
                </div>

                <div class="fs-6 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.lastOccurrenceDateDisplay %>
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-4">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Break
                </div>

                <div class="fs-6 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.breakDurationDisplay %>
                </div>
              </div>
            </div>
          </div>

          <% if (shiftDetailsView.shift.isMultipleShift) { %>
            <div class="separator separator-dashed my-6"></div>

            <div class="row g-5">
              <div class="col-md-4">
                <div class="fs-7 text-muted mb-1">
                  Repeat days
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.repeatDaysLabel || "Not specified" %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="fs-7 text-muted mb-1">
                  Daily start time
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.dailyStartTimeDisplay %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="fs-7 text-muted mb-1">
                  Daily end time
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.dailyEndTimeDisplay %>

                  <% if (shiftDetailsView.shift.endsNextDay) { %>
                    <span class="badge badge-light-info ms-2">
                      Next day
                    </span>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- OCCURRENCES -->

      <% if (shiftDetailsView.shift.hasOccurrences) { %>
        <div class="card card-flush mb-6">
          <div class="card-header">
            <div class="card-title">
              <h2 class="fw-bold mb-0">
                <%= shiftDetailsView.shift.isMultipleShift ? "Work Dates" : "Work Date" %>
              </h2>
            </div>

            <% if (shiftDetailsView.shift.selectedOccurrence) { %>
              <div class="card-toolbar">
                <span
                  class="badge <%= shiftDetailsView.shift.selectedOccurrence.statusBadgeClass %>"
                >
                  <%= shiftDetailsView.shift.selectedOccurrence.statusLabel %>
                </span>
              </div>
            <% } %>
          </div>

          <div class="card-body pt-0">
            <% if (shiftDetailsView.shift.isMultipleShift) { %>
              <div class="table-responsive">
                <table class="table align-middle table-row-dashed gy-4">
                  <thead>
                    <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                      <th>Shift</th>
                      <th>Date</th>
                      <th>Time</th>
                      <th>Assignment</th>
                      <th>Attendance</th>
                      <th class="text-end">Action</th>
                    </tr>
                  </thead>

                  <tbody class="fw-semibold text-gray-700">
                    <% shiftDetailsView.shift.occurrences.forEach((occurrence) => { %>
                      <tr
                        class="<%= occurrence.isSelectedOccurrence ? 'bg-light-primary' : '' %>"
                      >
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-gray-900">
                              <%= occurrence.sequenceLabel %>
                            </span>

                            <% if (occurrence.highlight.label) { %>
                              <span class="badge badge-light-primary">
                                <%= occurrence.highlight.label %>
                              </span>
                            <% } %>
                          </div>

                          <div class="fs-8 text-muted mt-1">
                            <%= occurrence.referenceCode %>
                          </div>
                        </td>

                        <td>
                          <%= occurrence.occurrenceDateDisplay %>
                        </td>

                        <td>
                          <%= occurrence.startTimeDisplay %>
                          –
                          <%= occurrence.endTimeDisplay %>

                          <% if (occurrence.crossesMidnight) { %>
                            <div class="fs-8 text-muted mt-1">
                              Ends the next day
                            </div>
                          <% } %>
                        </td>

                        <td>
                          <span class="badge <%= occurrence.assignmentStatusBadgeClass %>">
                            <%= occurrence.assignmentStatusLabel %>
                          </span>
                        </td>

                        <td>
                          <span class="badge <%= occurrence.attendanceStatusBadgeClass %>">
                            <%= occurrence.attendanceStatusLabel %>
                          </span>
                        </td>

                        <td class="text-end">
                          <a
                            href="<%= occurrence.detailsUrl %>"
                            class="btn btn-sm <%= occurrence.isSelectedOccurrence ? 'btn-primary' : 'btn-light-primary' %>"
                          >
                            <%= occurrence.isSelectedOccurrence ? "Selected" : "View" %>
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <% if (shiftDetailsView.shift.selectedOccurrence) { %>
              <% if (shiftDetailsView.shift.isMultipleShift) { %>
                <div class="separator separator-dashed my-6"></div>
              <% } %>

              <div class="row g-5">
                <div class="col-md-6">
                  <div class="border border-dashed rounded p-4 h-100">
                    <div class="fs-7 text-muted mb-1">
                      Selected work date
                    </div>

                    <div class="fs-5 fw-bold text-gray-900">
                      <%= shiftDetailsView.shift.selectedOccurrence.occurrenceDateDisplay %>
                    </div>

                    <div class="fs-7 text-muted mt-2">
                      <%= shiftDetailsView.shift.selectedOccurrence.startTimeDisplay %>
                      –
                      <%= shiftDetailsView.shift.selectedOccurrence.endTimeDisplay %>
                    </div>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="border border-dashed rounded p-4 h-100">
                    <div class="fs-7 text-muted mb-1">
                      Scheduled duration
                    </div>

                    <div class="fs-5 fw-bold text-gray-900">
                      <%= shiftDetailsView.shift.selectedOccurrence.scheduledHoursDisplay %>
                    </div>

                    <div class="fs-7 text-muted mt-2">
                      <%= shiftDetailsView.shift.selectedOccurrence.breakDurationDisplay %>
                    </div>
                  </div>
                </div>

                <div class="col-md-4">
                  <div class="border border-dashed rounded p-4 h-100">
                    <div class="fs-7 text-muted mb-1">
                      Assignment
                    </div>

                    <span
                      class="badge <%= shiftDetailsView.shift.selectedOccurrence.assignmentStatusBadgeClass %>"
                    >
                      <%= shiftDetailsView.shift.selectedOccurrence.assignmentStatusLabel %>
                    </span>
                  </div>
                </div>

                <div class="col-md-4">
                  <div class="border border-dashed rounded p-4 h-100">
                    <div class="fs-7 text-muted mb-1">
                      Attendance
                    </div>

                    <span
                      class="badge <%= shiftDetailsView.shift.selectedOccurrence.attendanceStatusBadgeClass %>"
                    >
                      <%= shiftDetailsView.shift.selectedOccurrence.attendanceStatusLabel %>
                    </span>
                  </div>
                </div>

                <div class="col-md-4">
                  <div class="border border-dashed rounded p-4 h-100">
                    <div class="fs-7 text-muted mb-1">
                      Settlement
                    </div>

                    <span
                      class="badge <%= shiftDetailsView.shift.selectedOccurrence.settlementStatusBadgeClass %>"
                    >
                      <%= shiftDetailsView.shift.selectedOccurrence.settlementStatusLabel %>
                    </span>
                  </div>
                </div>

                <% if (shiftDetailsView.shift.selectedOccurrence.checkedInAt) { %>
                  <div class="col-md-6">
                    <div class="border border-dashed rounded p-4 h-100">
                      <div class="fs-7 text-muted mb-1">
                        Checked in
                      </div>

                      <div class="fs-6 fw-semibold text-gray-900">
                        <%= shiftDetailsView.shift.selectedOccurrence.checkedInAtDisplay %>
                      </div>
                    </div>
                  </div>
                <% } %>

                <% if (shiftDetailsView.shift.selectedOccurrence.checkedOutAt) { %>
                  <div class="col-md-6">
                    <div class="border border-dashed rounded p-4 h-100">
                      <div class="fs-7 text-muted mb-1">
                        Checked out
                      </div>

                      <div class="fs-6 fw-semibold text-gray-900">
                        <%= shiftDetailsView.shift.selectedOccurrence.checkedOutAtDisplay %>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- ROLE DETAILS -->

      <div class="card card-flush mb-6">
        <div class="card-header">
          <div class="card-title">
            <h2 class="fw-bold mb-0">
              Role Details
            </h2>
          </div>
        </div>

        <div class="card-body pt-0">
          <div class="row g-5">
            <div class="col-md-6">
              <div class="fs-7 text-muted mb-1">
                Role
              </div>

              <div class="fs-6 fw-bold text-gray-900">
                <%= shiftDetailsView.shift.roleTitle %>
              </div>
            </div>

            <div class="col-md-6">
              <div class="fs-7 text-muted mb-1">
                Professional type
              </div>

              <div class="fs-6 fw-bold text-gray-900">
                <%= shiftDetailsView.shift.professionalTypeLabel %>
              </div>
            </div>

            <% if (shiftDetailsView.shift.department) { %>
              <div class="col-md-6">
                <div class="fs-7 text-muted mb-1">
                  Department
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.department %>
                </div>
              </div>
            <% } %>

            <% if (shiftDetailsView.shift.dressCode) { %>
              <div class="col-md-6">
                <div class="fs-7 text-muted mb-1">
                  Dress code
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.dressCode %>
                </div>
              </div>
            <% } %>

            <% if (shiftDetailsView.shift.requiredSkills.length > 0) { %>
              <div class="col-12">
                <div class="fs-7 text-muted mb-3">
                  Required skills
                </div>

                <div class="d-flex flex-wrap gap-2">
                  <% shiftDetailsView.shift.requiredSkills.forEach((skill) => { %>
                    <span class="badge badge-light-primary">
                      <%= skill %>
                    </span>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <% if (shiftDetailsView.shift.description) { %>
              <div class="col-12">
                <div class="fs-7 text-muted mb-1">
                  Description
                </div>

                <div class="fs-6 text-gray-800">
                  <%= shiftDetailsView.shift.description %>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- PRICING -->

      <div class="card card-flush">
        <div class="card-header">
          <div class="card-title">
            <h2 class="fw-bold mb-0">
              Pricing
            </h2>
          </div>

          <div class="card-toolbar">
            <span class="badge badge-light-success">
              Pricing locked
            </span>
          </div>
        </div>

        <div class="card-body pt-0">
          <div class="row g-5">
            <div class="col-sm-6 col-lg-3">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Hourly rate
                </div>

                <div class="fs-5 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.hourlyRateDisplay %>
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-3">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Professional pay
                </div>

                <div class="fs-5 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.estimatedProfessionalPayDisplay %>
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-3">
              <div class="border border-dashed rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Platform fee
                </div>

                <div class="fs-5 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.estimatedPlatformFeeDisplay %>
                </div>

                <div class="fs-8 text-muted mt-1">
                  <%= shiftDetailsView.shift.platformFeePercent %>%
                </div>
              </div>
            </div>

            <div class="col-sm-6 col-lg-3">
              <div class="border border-primary border-dashed bg-light-primary rounded p-4 h-100">
                <div class="fs-7 text-muted mb-1">
                  Employer charge
                </div>

                <div class="fs-5 fw-bold text-primary">
                  <%= shiftDetailsView.shift.estimatedEmployerChargeDisplay %>
                </div>
              </div>
            </div>
          </div>

          <% if (shiftDetailsView.shift.isMultipleShift) { %>
            <div class="separator separator-dashed my-6"></div>

            <div class="row g-5">
              <div class="col-md-4">
                <div class="fs-7 text-muted mb-1">
                  Professional pay per shift
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.estimatedProfessionalPayPerOccurrenceDisplay %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="fs-7 text-muted mb-1">
                  Platform fee per shift
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.estimatedPlatformFeePerOccurrenceDisplay %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="fs-7 text-muted mb-1">
                  Employer charge per shift
                </div>

                <div class="fs-6 fw-semibold text-gray-900">
                  <%= shiftDetailsView.shift.estimatedEmployerChargePerOccurrenceDisplay %>
                </div>
              </div>
            </div>
          <% } %>

          <div class="separator separator-dashed my-6"></div>

          <div class="row g-5">
            <div class="col-md-6">
              <div class="fs-7 text-muted mb-1">
                Pricing locked at
              </div>

              <div class="fs-6 fw-semibold text-gray-900">
                <%= shiftDetailsView.shift.pricingLockedAtDisplay %>
              </div>
            </div>

            <div class="col-md-6">
              <div class="fs-7 text-muted mb-1">
                Payment status
              </div>

              <span class="badge <%= shiftDetailsView.shift.paymentStatusBadgeClass %>">
                <%= shiftDetailsView.shift.paymentStatusLabel %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN -->

    <div class="col-xl-4">
      <!-- ATTENDANCE PINS -->

      <div
        class="card card-flush mb-6"
        id="attendancePinPanel"
        data-attendance-pin-panel
        data-selected-occurrence-id="<%= shiftDetailsView.shift.pinPanel.selectedOccurrenceId || '' %>"
        data-can-view-pins="<%= shiftDetailsView.shift.pinPanel.canViewAttendancePins ? 'true' : 'false' %>"
        data-check-in-pin-url="<%= shiftDetailsView.shift.pinPanel.checkInPinUrl || '' %>"
        data-check-out-pin-url="<%= shiftDetailsView.shift.pinPanel.checkOutPinUrl || '' %>"
      >
        <div
          class="card-header"
           <%= shiftDetailsView.shift.pinPanel.brandColor %>;"
        >
          <div class="card-title">
            <div>
              <h2 class="fw-bold mb-1">
                Attendance PINs
              </h2>

              <% if (shiftDetailsView.shift.selectedOccurrence) { %>
                <div class="fs-7 text-muted">
                  <%= shiftDetailsView.shift.selectedOccurrence.sequenceLabel %>
                  ·
                  <%= shiftDetailsView.shift.selectedOccurrence.occurrenceDateDisplay %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="card-body pt-2">
          <% if (shiftDetailsView.shift.pinPanel.canViewAttendancePins) { %>
            <div
              class="notice d-flex bg-light-primary rounded border-primary border border-dashed p-4 mb-5"
            >
              <i class="ki-duotone ki-shield-tick fs-2x text-primary me-3">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>

              <div class="fs-7 text-gray-700">
                Both PINs are available for this occurrence. The professional
                must still pass the attendance-state and location checks.
              </div>
            </div>

            <div class="row g-4">
              <div class="col-12">
                <div
                  class="rounded p-5"
                  style="background-color: <%= shiftDetailsView.shift.pinPanel.brandColor %>;"
                >
                  <div class="d-flex flex-stack gap-3">
                    <div>
                      <div class="fs-7 fw-semibold text-white opacity-75">
                        Check-in PIN
                      </div>

                      <div
                        class="fs-2x fw-bolder text-white ls-2 mt-1"
                        data-pin-value="check_in"
                        aria-live="polite"
                      >
                        ••••
                      </div>

                      <div
                        class="fs-8 text-white opacity-75 mt-1"
                        data-pin-status="check_in"
                      >
                        Loading PIN...
                      </div>
                    </div>

                    <button
                      type="button"
                      class="btn btn-sm btn-light"
                      data-copy-pin="check_in"
                      disabled
                    >
                      <i class="ki-duotone ki-copy fs-3">
                        <span class="path1"></span>
                        <span class="path2"></span>
                      </i>

                      Copy
                    </button>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div
                  class="rounded p-5"
                  style="background-color: <%= shiftDetailsView.shift.pinPanel.brandColor %>;"
                >
                  <div class="d-flex flex-stack gap-3">
                    <div>
                      <div class="fs-7 fw-semibold text-white opacity-75">
                        Check-out PIN
                      </div>

                      <div
                        class="fs-2x fw-bolder text-white ls-2 mt-1"
                        data-pin-value="check_out"
                        aria-live="polite"
                      >
                        ••••
                      </div>

                      <div
                        class="fs-8 text-white opacity-75 mt-1"
                        data-pin-status="check_out"
                      >
                        Loading PIN...
                      </div>
                    </div>

                    <button
                      type="button"
                      class="btn btn-sm btn-light"
                      data-copy-pin="check_out"
                      disabled
                    >
                      <i class="ki-duotone ki-copy fs-3">
                        <span class="path1"></span>
                        <span class="path2"></span>
                      </i>

                      Copy
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div
              class="alert alert-danger d-none mt-5 mb-0"
              role="alert"
              data-pin-error
            ></div>
          <% } else { %>
            <div class="text-center py-8">
              <div class="symbol symbol-70px mb-5">
                <span class="symbol-label bg-light-secondary">
                  <i class="ki-duotone ki-lock fs-2x text-gray-700">
                    <span class="path1"></span>
                    <span class="path2"></span>
                    <span class="path3"></span>
                    <span class="path4"></span>
                    <span class="path5"></span>
                  </i>
                </span>
              </div>

              <div class="fs-6 fw-bold text-gray-900">
                Attendance PINs unavailable
              </div>

              <div class="fs-7 text-muted mt-2">
                <%= shiftDetailsView.shift.pinPanel.unavailableMessage %>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- BRANCH -->

      <% if (shiftDetailsView.shift.branch) { %>
        <div class="card card-flush mb-6">
          <div class="card-header">
            <div class="card-title">
              <h2 class="fw-bold mb-0">
                Branch
              </h2>
            </div>
          </div>

          <div class="card-body pt-0">
            <div class="d-flex align-items-start gap-4">
              <div class="symbol symbol-50px">
                <span class="symbol-label bg-light-primary">
                  <i class="ki-duotone ki-geolocation fs-2 text-primary">
                    <span class="path1"></span>
                    <span class="path2"></span>
                  </i>
                </span>
              </div>

              <div>
                <div class="fs-6 fw-bold text-gray-900">
                  <%= shiftDetailsView.shift.branch.name %>
                </div>

                <div class="fs-7 text-muted mt-1">
                  <%= shiftDetailsView.shift.branch.locationLabel || "No address available" %>
                </div>

                <% if (shiftDetailsView.shift.branch.geofenceRadiusMeters) { %>
                  <div class="fs-8 text-muted mt-3">
                    Attendance radius:
                    <%= shiftDetailsView.shift.branch.geofenceRadiusMeters %>
                    meters
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- FUNDING SUMMARY -->

      <div class="card card-flush mb-6">
        <div class="card-header">
          <div class="card-title">
            <h2 class="fw-bold mb-0">
              Funding
            </h2>
          </div>
        </div>

        <div class="card-body pt-0">
          <div class="d-flex flex-stack mb-4">
            <span class="fs-7 text-muted">
              Employer charge
            </span>

            <span class="fs-6 fw-bold text-gray-900">
              <%= shiftDetailsView.shift.estimatedEmployerChargeDisplay %>
            </span>
          </div>

          <div class="d-flex flex-stack mb-4">
            <span class="fs-7 text-muted">
              Funded amount
            </span>

            <span class="fs-6 fw-bold text-gray-900">
              <%= shiftDetailsView.shift.fundedAmountDisplay %>
            </span>
          </div>

          <div class="d-flex flex-stack mb-4">
            <span class="fs-7 text-muted">
              Funding method
            </span>

            <span class="fs-6 fw-semibold text-gray-900">
              <%= shiftDetailsView.shift.fundingMethodLabel %>
            </span>
          </div>

          <div class="d-flex flex-stack">
            <span class="fs-7 text-muted">
              Payment status
            </span>

            <span class="badge <%= shiftDetailsView.shift.paymentStatusBadgeClass %>">
              <%= shiftDetailsView.shift.paymentStatusLabel %>
            </span>
          </div>

          <% if (shiftDetailsView.shift.needsPayment) { %>
            <button
              type="button"
              class="btn btn-primary w-100 mt-6"
              data-bs-toggle="modal"
              data-bs-target="#<%= shiftDetailsView.actions.fundShiftModalId %>"
            >
              <%= shiftDetailsView.shift.canRetryPayment ? "Retry Payment" : "Complete Payment" %>
            </button>
          <% } %>
        </div>
      </div>

      <!-- LIFECYCLE ACTIONS -->

      <% if (
        shiftDetailsView.shift.lifecycleActions.canCancel ||
        shiftDetailsView.shift.lifecycleActions.canEndShiftEarly
      ) { %>
        <div class="card card-flush">
          <div class="card-header">
            <div class="card-title">
              <h2 class="fw-bold mb-0">
                Shift Actions
              </h2>
            </div>
          </div>

          <div class="card-body pt-0">
            <% if (shiftDetailsView.shift.lifecycleActions.canCancel) { %>
              <button
                type="button"
                class="btn btn-light-danger w-100 mb-3"
                data-cancel-shift
                data-preview-url="<%= shiftDetailsView.shift.lifecycleActions.cancellationPreviewUrl %>"
                data-cancel-url="<%= shiftDetailsView.shift.lifecycleActions.cancelShiftUrl %>"
              >
                <i class="ki-duotone ki-cross-circle fs-2">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>

                <%= shiftDetailsView.shift.lifecycleActions.cancellationActionLabel %>
              </button>
            <% } %>

            <% if (shiftDetailsView.shift.lifecycleActions.canEndShiftEarly) { %>
              <button
                type="button"
                class="btn btn-danger w-100"
                data-end-shift-early
                data-end-early-url="<%= shiftDetailsView.shift.lifecycleActions.endShiftEarlyUrl %>"
              >
                <i class="ki-duotone ki-time fs-2">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>

                <%= shiftDetailsView.shift.lifecycleActions.earlyTerminationActionLabel %>
              </button>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- FUND SHIFT MODAL -->

  <div
    class="modal fade"
    id="<%= shiftDetailsView.actions.fundShiftModalId %>"
    tabindex="-1"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered mw-650px">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="fw-bold">
            <%= shiftDetailsView.shift.paymentReview.actionLabel %>
          </h2>

          <button
            type="button"
            class="btn btn-icon btn-sm btn-active-icon-primary"
            data-bs-dismiss="modal"
            aria-label="Close"
          >
            <i class="ki-duotone ki-cross fs-1">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>
          </button>
        </div>

        <div class="modal-body py-8 px-lg-10">
          <div
            class="rounded border border-dashed border-primary bg-light-primary p-5 mb-7"
          >
            <div class="d-flex flex-stack mb-3">
              <span class="fs-7 text-muted">
                Shift
              </span>

              <span class="fs-6 fw-bold text-gray-900">
                <%= shiftDetailsView.shift.referenceCode %>
              </span>
            </div>

            <div class="d-flex flex-stack mb-3">
              <span class="fs-7 text-muted">
                Schedule
              </span>

              <span class="fs-6 fw-semibold text-gray-900">
                <%= shiftDetailsView.shift.occurrenceCountLabel %>
              </span>
            </div>

            <div class="d-flex flex-stack">
              <span class="fs-7 text-muted">
                Amount due
              </span>

              <span class="fs-4 fw-bold text-primary">
                <%= shiftDetailsView.shift.paymentReview.employerChargeDisplay %>
              </span>
            </div>
          </div>

          <form id="shiftFundingForm" novalidate>
            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            />

            <input
              type="hidden"
              name="shiftId"
              value="<%= shiftDetailsView.shift.id %>"
            />

            <div class="mb-7">
              <label class="form-label fw-bold">
                Select payment method
              </label>

              <div class="d-flex flex-column gap-4">
                <label
                  class="d-flex flex-stack cursor-pointer rounded border border-dashed p-5"
                >
                  <div class="d-flex align-items-center gap-4">
                    <span class="symbol symbol-45px">
                      <span class="symbol-label bg-light-primary">
                        <i class="ki-duotone ki-wallet fs-2 text-primary">
                          <span class="path1"></span>
                          <span class="path2"></span>
                          <span class="path3"></span>
                          <span class="path4"></span>
                        </i>
                      </span>
                    </span>

                    <div>
                      <div class="fs-6 fw-bold text-gray-900">
                        Employer Wallet
                      </div>

                      <div class="fs-7 text-muted mt-1">
                        Available balance:
                        <%= shiftDetailsView.shift.paymentReview.paymentOptions.wallet.availableBalanceDisplay %>
                      </div>

                      <% if (
                        shiftDetailsView.shift.paymentReview.paymentOptions.wallet.unavailableMessage
                      ) { %>
                        <div class="fs-8 text-danger mt-1">
                          <%= shiftDetailsView.shift.paymentReview.paymentOptions.wallet.unavailableMessage %>
                        </div>
                      <% } %>
                    </div>
                  </div>

                  <input
                    class="form-check-input"
                    type="radio"
                    name="fundingMethod"
                    value="wallet"
                    <%= shiftDetailsView.shift.paymentReview.paymentOptions.wallet.canUse ? "" : "disabled" %>
                  />
                </label>

                <label
                  class="d-flex flex-stack cursor-pointer rounded border border-dashed p-5"
                >
                  <div class="d-flex align-items-center gap-4">
                    <span class="symbol symbol-45px">
                      <span class="symbol-label bg-light-success">
                        <i class="ki-duotone ki-credit-cart fs-2 text-success">
                          <span class="path1"></span>
                          <span class="path2"></span>
                        </i>
                      </span>
                    </span>

                    <div>
                      <div class="fs-6 fw-bold text-gray-900">
                        Paystack Checkout
                      </div>

                      <div class="fs-7 text-muted mt-1">
                        <%= shiftDetailsView.shift.paymentReview.paymentOptions.paystackCheckout.description %>
                      </div>
                    </div>
                  </div>

                  <input
                    class="form-check-input"
                    type="radio"
                    name="fundingMethod"
                    value="paystack_checkout"
                    <%= shiftDetailsView.shift.paymentReview.paymentOptions.paystackCheckout.canUse ? "" : "disabled" %>
                  />
                </label>
              </div>
            </div>

            <div
              class="alert alert-danger d-none"
              role="alert"
              data-funding-error
            ></div>

            <div class="d-flex justify-content-end gap-3">
              <button
                type="button"
                class="btn btn-light"
                data-bs-dismiss="modal"
              >
                Cancel
              </button>

              <button
                type="submit"
                class="btn btn-primary"
                data-funding-submit
                data-wallet-url="<%= shiftDetailsView.shift.paymentReview.actions.fundFromWalletUrl %>"
                data-checkout-url="<%= shiftDetailsView.shift.paymentReview.actions.initializeCheckoutUrl %>"
              >
                <span class="indicator-label">
                  Continue
                </span>

                <span class="indicator-progress">
                  Processing...

                  <span
                    class="spinner-border spinner-border-sm align-middle ms-2"
                  ></span>
                </span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>