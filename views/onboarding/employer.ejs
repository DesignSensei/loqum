<!-- views/onboarding/employer.ejs -->

<form id="onboarding_logout_form" action="/logout" method="POST" class="d-none">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
</form>

<form
  action="/onboarding/employer"
  method="POST"
  class="form w-100"
  id="kt_onboarding_employer_form"
>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <!-- ───────────────────── ACCOUNT SWITCHING ───────────────────── -->

  <div class="d-flex justify-content-center mb-6">
    <button
      type="submit"
      form="onboarding_logout_form"
      class="btn btn-sm btn-light btn-active-light-primary fw-semibold"
    >
      <i class="ki-duotone ki-exit-right fs-4 me-1">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      Use another account
    </button>
  </div>

  <!-- ───────────────────── PAGE HEADING ───────────────────── -->

  <div class="text-center mb-11">
    <h1 class="text-gray-900 fw-bolder mb-3">Business Profile</h1>

    <div class="text-gray-500 fw-semibold fs-6">
      Verify your CAC registration and set up your first business location.
    </div>
  </div>

  <!-- ───────────────────── BUSINESS TYPE ───────────────────── -->

  <!--
    The business type classifies the CAC-registered employer.
    Operating permits are uploaded and reviewed separately for each branch.
  -->

  <div class="fv-row mb-8">
    <label class="form-label required mb-4">Business Type</label>

    <div class="row g-4" data-kt-buttons="true">
      <!-- Pharmacy -->

      <div class="col-12 col-md-6">
        <label
          class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex align-items-center p-5 w-100 h-100 active"
          id="pharmacyCard"
        >
          <input class="btn-check" type="radio" name="type" value="pharmacy" checked="checked" />

          <i class="ki-duotone ki-address-book fs-2x me-4"></i>

          <span class="d-flex flex-column text-start">
            <span class="fw-bold fs-6">Pharmacy</span>

            <span class="fs-7 text-muted"> Retail or community pharmacy </span>
          </span>
        </label>
      </div>

      <!-- Clinic -->

      <div class="col-12 col-md-6">
        <label
          class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex align-items-center p-5 w-100 h-100"
          id="clinicCard"
        >
          <input class="btn-check" type="radio" name="type" value="clinic" />

          <i class="ki-duotone ki-clinic fs-2x me-4"></i>

          <span class="d-flex flex-column text-start">
            <span class="fw-bold fs-6">Clinic</span>

            <span class="fs-7 text-muted"> Outpatient clinic </span>
          </span>
        </label>
      </div>

      <!-- Hospital -->

      <div class="col-12 col-md-6">
        <label
          class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex align-items-center p-5 w-100 h-100"
          id="hospitalCard"
        >
          <input class="btn-check" type="radio" name="type" value="hospital" />

          <i class="ki-duotone ki-hospital fs-2x me-4"></i>

          <span class="d-flex flex-column text-start">
            <span class="fw-bold fs-6">Hospital</span>

            <span class="fs-7 text-muted"> Inpatient or specialist hospital </span>
          </span>
        </label>
      </div>

      <!-- Laboratory -->

      <div class="col-12 col-md-6">
        <label
          class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex align-items-center p-5 w-100 h-100"
          id="laboratoryCard"
        >
          <input class="btn-check" type="radio" name="type" value="laboratory" />

          <i class="ki-duotone ki-flask fs-2x me-4"></i>

          <span class="d-flex flex-column text-start">
            <span class="fw-bold fs-6">Laboratory</span>

            <span class="fs-7 text-muted"> Diagnostic or research laboratory </span>
          </span>
        </label>
      </div>
    </div>

    <div class="form-text mt-3">
      Facility operating permits will be requested for each location after setup.
    </div>
  </div>

  <!-- ───────────────────── CAC REGISTRATION VERIFICATION ───────────────────── -->

  <!--
    The employer submits only the CAC registration number
    to the dedicated verification endpoint.

    The service:
    - Authenticates and authorizes the employer;
    - Normalizes and validates the registration number;
    - Selects the configured CAC provider;
    - Reuses eligible cached results;
    - Enforces rolling lookup limits;
    - Blocks active or unresolved provider requests;
    - Persists temporary verification evidence;
    - Returns the registered legal business name.

    Lookup limits:
    - Eight total provider lookups per rolling 24 hours;
    - Six distinct registration numbers per rolling 24 hours;
    - No mandatory cooldown between completed lookups.

    The browser does not calculate remaining allowance.

    CAC registry verification does not verify a healthcare premises
    or authorise regulated shifts at a branch.
  -->

  <div class="fv-row mb-8" id="cacVerificationSection">
    <label for="cacRegistrationNumberInput" class="form-label required">
      CAC Registration Number

      <span class="text-muted fs-7">
        <i
          class="ki-outline ki-information-2 fs-6"
          data-bs-toggle="tooltip"
          data-bs-original-title="Enter the RC or BN registration number issued by the Corporate Affairs Commission."
        ></i>
      </span>
    </label>

    <div class="row g-3 align-items-start">
      <div class="col-12 col-md-8">
        <input
          type="text"
          id="cacRegistrationNumberInput"
          name="cacRegistrationNumber"
          class="form-control bg-transparent"
          placeholder="e.g. RC1234567 or BN1234567"
          autocomplete="off"
          spellcheck="false"
          maxlength="14"
          aria-describedby="cacVerificationHelp cacLookupPolicyHelp"
        />
      </div>

      <div class="col-12 col-md-4">
        <button
          type="button"
          id="kt_onboarding_cac_verify"
          class="btn btn-light-primary w-100"
          data-verify-url="/onboarding/employer/verify-cac"
          aria-controls="cacVerificationResult"
        >
          <span class="indicator-label"> Verify CAC </span>

          <span class="indicator-progress">
            Verifying...

            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
          </span>
        </button>
      </div>
    </div>

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>

    <!-- CAC VERIFICATION INSTRUCTIONS -->

    <div class="form-text mt-2" id="cacVerificationHelp">
      Enter your CAC registration number and select
      <strong>Verify CAC</strong>. Your registered legal business name will be retrieved
      automatically from the CAC verification result.
    </div>

    <!-- CAC LOOKUP ALLOWANCE -->

    <div class="text-muted fs-7 mt-2" id="cacLookupPolicyHelp">
      To prevent repeated paid lookups, each account is limited to
      <strong>8 lookup attempts</strong> across
      <strong>6 different registration numbers</strong>
      within a rolling 24-hour period. There is no mandatory cooldown between completed lookups.
      Eligible cached results may be reused without another paid lookup.
    </div>

    <div class="text-muted fs-7 mt-2">
      Automated verification currently supports RC and BN registrations. Availability may depend on
      the configured provider. For another registration category, contact Loqum Support.
    </div>

    <!-- ───────── CAC VERIFICATION RESULT ───────── -->

    <!--
      JavaScript updates:
      - Alert styling;
      - Verification message;
      - Registered business name;
      - Additional verification guidance.

      Provider values must be inserted using textContent.
      Never render raw provider values as HTML.

      The frontend does not persist authoritative CAC evidence.
    -->

    <div
      id="cacVerificationResult"
      class="alert d-none mt-4 mb-0"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <div class="d-flex align-items-start">
        <i
          id="cacVerificationIcon"
          class="ki-outline ki-information-2 fs-3 me-3"
          aria-hidden="true"
        ></i>

        <div class="flex-grow-1">
          <div id="cacVerificationMessage" class="fw-semibold"></div>

          <div id="cacRegisteredBusinessNameRow" class="mt-2 d-none">
            <div class="text-muted fs-7 mb-1">Registered Legal Business Name</div>

            <div id="cacRegisteredBusinessName" class="fw-bold"></div>
          </div>

          <div id="cacVerificationAdditionalNote" class="fs-7 mt-2 d-none"></div>
        </div>
      </div>
    </div>

    <!-- CAC VERIFICATION DISCLAIMER -->

    <div class="text-muted fs-7 mt-3">
      CAC verification confirms the registered business. Each branch must have its applicable
      operating permits reviewed before it can be used for regulated marketplace activities.
    </div>
  </div>

  <!-- ───────────────────── REGISTERED LEGAL BUSINESS NAME ───────────────────── -->

  <!--
    The registered legal business name is returned
    by the production CAC verification service.

    The employer must not manually supply an
    authoritative registered business name.

    The field remains named businessName to preserve
    the existing form and validation contract.

    readonly is intentionally used instead of disabled
    so FormData can include the displayed value.

    The backend does not trust this browser value.
    It independently obtains the authoritative name
    from previously validated CAC evidence.
  -->

  <div class="fv-row mb-8">
    <label for="businessNameInput" class="form-label required">
      CAC Registered Legal Business Name
    </label>

    <input
      type="text"
      id="businessNameInput"
      name="businessName"
      class="form-control bg-light"
      placeholder="Filled automatically after CAC verification"
      autocomplete="off"
      aria-describedby="businessNameHelp"
      maxlength="150"
      readonly
    />

    <div class="form-text mt-2" id="businessNameHelp">
      This field is populated from your verified CAC registration. It cannot be edited manually. If
      the returned legal name is incorrect, do not submit the profile; contact Loqum Support.
    </div>

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- ───────────────────── STATE AND LGA ───────────────────── -->

  <div class="row gx-3 gy-8 mb-8">
    <div class="col-md-6">
      <label for="stateSelect" class="form-label required"> State </label>

      <select
        id="stateSelect"
        name="state"
        class="form-select bg-transparent"
        data-control="select2"
        data-placeholder="Select State"
      >
        <option></option>
        <option value="">Select State</option>
      </select>

      <div
        class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
      ></div>
    </div>

    <div class="col-md-6">
      <label for="lgaSelect" class="form-label required"> LGA </label>

      <select
        id="lgaSelect"
        name="lga"
        class="form-select bg-transparent"
        data-control="select2"
        data-placeholder="Select LGA"
        disabled
      >
        <option value="">Select LGA</option>
      </select>

      <div class="fv-plugins-message-container invalid-feedback"></div>
    </div>
  </div>

  <!-- ───────────────────── BUSINESS ADDRESS ───────────────────── -->

  <div class="fv-row mb-8">
    <label for="addressInput" class="form-label required"> Main Branch Location Address </label>

    <input
      type="text"
      id="addressInput"
      name="address"
      class="form-control bg-transparent"
      placeholder="Select your main branch address"
      autocomplete="off"
    />

    <!-- Google Places evidence -->

    <input type="hidden" id="latitudeInput" name="latitude" />

    <input type="hidden" id="longitudeInput" name="longitude" />

    <input type="hidden" id="googlePlaceIdInput" name="googlePlaceId" />

    <div class="form-text mt-2">
      Your first branch will be created automatically at this address. You can add more branches and
      upload each location's applicable permits after completing setup.
    </div>

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- ───────────────────── BUSINESS EMAIL ───────────────────── -->

  <div class="fv-row mb-8">
    <label class="form-label required"> Business Email </label>

    <input
      type="email"
      name="businessEmail"
      class="form-control bg-transparent"
      placeholder="e.g. business@example.com"
      autocomplete="off"
    />

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- ───────────────────── BUSINESS PHONE ───────────────────── -->

  <div class="fv-row mb-8">
    <label class="form-label required"> Business Phone Number </label>

    <div class="row g-3">
      <div class="col-4">
        <select
          name="businessPhoneCode"
          class="form-select bg-transparent"
          data-kt-select2="true"
          data-hide-search="false"
          data-placeholder="Code"
        >
          <option value="" disabled>Code</option>
          <option value="+234" selected>🇳🇬 +234</option>
        </select>
      </div>

      <div class="col-8">
        <input
          type="tel"
          name="businessPhone"
          class="form-control bg-transparent"
          placeholder="08012345678"
          autocomplete="off"
        />

        <div
          class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
        ></div>
      </div>
    </div>
  </div>

  <!-- ───────────────────── CONTACT PERSON ───────────────────── -->

  <div class="row g-9 mb-8">
    <div class="col-md-6">
      <label class="form-label required"> Contact First Name </label>

      <input
        type="text"
        name="contactFirstName"
        class="form-control bg-transparent"
        placeholder="John"
        autocomplete="off"
      />

      <div
        class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
      ></div>
    </div>

    <div class="col-md-6">
      <label class="form-label required"> Contact Last Name </label>

      <input
        type="text"
        name="contactLastName"
        class="form-control bg-transparent"
        placeholder="Doe"
        autocomplete="off"
      />

      <div
        class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
      ></div>
    </div>
  </div>

  <!-- ───────────────────── CONTACT ROLE ───────────────────── -->

  <div class="fv-row mb-8">
    <label class="form-label required"> Contact Role </label>

    <select
      name="contactRole"
      class="form-select bg-transparent"
      data-control="select2"
      data-placeholder="Select contact role"
    >
      <option></option>
      <option value="">Select contact role</option>
      <option value="owner">Owner</option>
      <option value="director">Director</option>
      <option value="superintendent_pharmacist">Superintendent Pharmacist</option>
      <option value="branch_manager">Branch Manager</option>
      <option value="hr_admin">HR / Admin</option>
      <option value="operations_manager">Operations Manager</option>
      <option value="procurement_manager">Procurement Manager</option>
      <option value="other">Other</option>
    </select>

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- ───────────────────── CONTACT PHONE ───────────────────── -->

  <div class="fv-row mb-8">
    <label class="form-label required"> Contact Phone Number </label>

    <div class="row g-3">
      <div class="col-4">
        <select
          name="contactPhoneCode"
          class="form-select bg-transparent"
          data-kt-select2="true"
          data-hide-search="false"
          data-placeholder="Code"
        >
          <option value="" disabled>Code</option>
          <option value="+234" selected>🇳🇬 +234</option>
        </select>
      </div>

      <div class="col-8">
        <input
          type="tel"
          name="contactPhone"
          class="form-control bg-transparent"
          placeholder="08012345678"
          autocomplete="off"
        />

        <div
          class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
        ></div>
      </div>
    </div>
  </div>

  <!-- ───────────────────── SUBMIT ───────────────────── -->

  <!--
    The employer frontend enables submission
    only after successful, unexpired production CAC
    verification is available.

    The backend independently validates and consumes
    that evidence before completing onboarding.

    Client-side state is never authoritative.
  -->

  <div class="d-grid mb-10">
    <button type="submit" id="kt_onboarding_submit" class="btn btn-primary" disabled>
      <span class="indicator-label"> Complete Setup </span>

      <span class="indicator-progress">
        Please wait...

        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
      </span>
    </button>
  </div>
</form>

<!-- ───────────────────── LOCATION DATA ───────────────────── -->

<script>
  window.locations = <%- locations %>;
</script>
