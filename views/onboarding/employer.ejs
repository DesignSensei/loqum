          <i
            class="ki-outline ki-information-2 fs-6"
            data-bs-toggle="tooltip"
            data-bs-original-title="Your clinic facility registration number issued by HEFAMAA or your State Ministry of Health."
          ></i>
        </span>
      </label>

      <input
        type="text"
        name="regulatoryRegistrationNumber"
        class="form-control bg-transparent"
