<!-- views/onboarding/employer.ejs -->

<form id="onboarding_logout_form" action="/logout" method="POST" class="d-none">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
</form>

<form
  action="/onboarding/employer"
  method="POST"
  class="form w-100"
  id="kt_onboarding_employer_form"
>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <div class="d-flex justify-content-center mb-6">
    <button
      type="submit"
      form="onboarding_logout_form"
      class="btn btn-sm btn-light btn-active-light-primary fw-semibold"
    >
      <i class="ki-duotone ki-exit-right fs-4 me-1">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
      Use another account
    </button>
  </div>

  <div class="text-center mb-11">
    <h1 class="text-gray-900 fw-bolder mb-3">Business Profile</h1>
    <div class="text-gray-500 fw-semibold fs-6">Tell us about your business to start hiring.</div>
  </div>

  <!-- TYPE CARDS
       Only Pharmacy is active now.
       When scaling: uncomment the other cards, change pharmacy col-12 back to col-12 col-md-6,
       and add h-100 back to all labels.
  -->
  <div class="fv-row mb-8">
    <div class="row g-4" data-kt-buttons="true">
      <div class="col-12">
        <label
          class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex align-items-center p-5 w-100 active"
          id="pharmacyCard"
        >
          <input
            class="btn-check"
            type="radio"
            name="type"
            value="pharmacy"
            checked="checked"
            data-registration-field="field-pharmacy"
            data-validator-message="PCN premises registration number is required."
          />

          <i class="ki-duotone ki-address-book fs-2x me-4"></i>
          <span class="d-flex flex-column text-start">
            <span class="fw-bold fs-6">Pharmacy</span>
            <span class="fs-7 text-muted">Retail or community pharmacy</span>
          </span>
        </label>
      </div>

