    </div>
  </div>

  <!-- Business Name -->
  <div class="fv-row mb-8">
    <label class="form-label required">Business Name</label>
    <input
      type="text"
      name="businessName"
      class="form-control bg-transparent"
      placeholder="e.g. Your Pharmacy Name"
      autocomplete="off"
    />
    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- CAC Registration Number -->
  <div class="fv-row mb-8">
    <label class="form-label required">
      CAC Registration Number
      <span class="text-muted fs-7">
        <i
          class="ki-outline ki-information-2 fs-6"
          data-bs-toggle="tooltip"
          data-bs-original-title="Your Corporate Affairs Commission business registration number."
        ></i>
      </span>
    </label>

    <input
      type="text"
      name="cacRegistrationNumber"
      class="form-control bg-transparent"
      placeholder="e.g. RC1234567 or BN1234567"
      autocomplete="off"
    />

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- FACILITY / REGULATORY REGISTRATION NUMBER
       Only Pharmacy is active now.
       CAC confirms the business entity.
       PCN confirms the pharmacy premises/facility registration.
  -->
  <div class="fv-row mb-8">
    <!-- Pharmacy: PCN -->
    <div id="field-pharmacy" class="registration-field">
      <label class="form-label required">
        PCN Premises Registration Number
        <span class="text-muted fs-7">
          <i
            class="ki-outline ki-information-2 fs-6"
            data-bs-toggle="tooltip"
            data-bs-original-title="Your Pharmacy Council of Nigeria (PCN) premises or pharmacy registration number."
          ></i>
        </span>
      </label>

      <input
        type="text"
        id="regulatoryRegistrationInput"
        name="regulatoryRegistrationNumber"
        class="form-control bg-transparent"
        placeholder="Enter exactly as shown on your PCN premises certificate"
        autocomplete="off"
      />

      <div
        class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
      ></div>
    </div>

    <!-- Clinic: HEFAMAA / State MOH
    <div id="field-clinic" class="registration-field" style="display: none">
      <label class="form-label required">
        HEFAMAA / State Ministry of Health Registration Number
