  </div>

  <!-- State & LGA -->
  <div class="row gx-3 gy-8 mb-8">
    <div class="col-md-6">
      <label class="form-label required">State</label>
      <select
        id="stateSelect"
        name="state"
        class="form-select bg-transparent"
        data-control="select2"
        data-placeholder="Select State"
      >
        <option></option>
        <option value="">Select State</option>
      </select>
      <div
        class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
      ></div>
    </div>
    <div class="col-md-6">
      <label class="form-label required">LGA</label>
      <select
        id="lgaSelect"
        name="lga"
        class="form-select bg-transparent"
        data-control="select2"
        data-placeholder="Select LGA"
        disabled
      >
        <option value="">Select LGA</option>
      </select>
      <div class="fv-plugins-message-container invalid-feedback"></div>
    </div>
  </div>

  <!-- Location Address -->
  <div class="fv-row mb-8">
    <label class="form-label required">Location Address</label>

    <input
      type="text"
      id="addressInput"
      name="address"
      class="form-control bg-transparent"
      placeholder="Business Address"
      autocomplete="off"
    />

    <input type="hidden" id="latitudeInput" name="latitude" />
    <input type="hidden" id="longitudeInput" name="longitude" />
    <input type="hidden" id="googlePlaceIdInput" name="googlePlaceId" />

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- Business Email -->
  <div class="fv-row mb-8">
    <label class="form-label required">Business Email</label>
    <input
      type="email"
      name="businessEmail"
      class="form-control bg-transparent"
      placeholder="e.g. pharmacy@example.com"
      autocomplete="off"
    />
    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- Business Phone -->
  <div class="fv-row mb-8">
    <label class="form-label required">Business Phone Number</label>
    <div class="row g-3">
      <div class="col-4">
        <select
          name="businessPhoneCode"
          class="form-select bg-transparent"
          data-kt-select2="true"
          data-hide-search="false"
          data-placeholder="Code"
        >
          <option value="" disabled>Code</option>
          <option value="+234" selected>🇳🇬 +234</option>
        </select>
      </div>
      <div class="col-8">
        <input
          type="tel"
          name="businessPhone"
          class="form-control bg-transparent"
          placeholder="08012345678"
          autocomplete="off"
        />
        <div
          class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
        ></div>
      </div>
    </div>
  </div>

  <!-- Contact Person -->
  <div class="row g-9 mb-8">
    <div class="col-md-6">
      <label class="form-label required">Contact First Name</label>
      <input
        type="text"
        name="contactFirstName"
        class="form-control bg-transparent"
        placeholder="John"
        autocomplete="off"
      />
      <div
        class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
      ></div>
    </div>
    <div class="col-md-6">
      <label class="form-label required">Contact Last Name</label>
      <input
        type="text"
        name="contactLastName"
        class="form-control bg-transparent"
        placeholder="Doe"
        autocomplete="off"
      />
      <div
        class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
      ></div>
    </div>
  </div>

  <!-- Contact Role -->
  <div class="fv-row mb-8">
    <label class="form-label required">Contact Role</label>

    <select
      name="contactRole"
      class="form-select bg-transparent"
      data-control="select2"
      data-placeholder="Select contact role"
    >
      <option></option>
      <option value="">Select contact role</option>
      <option value="owner">Owner</option>
      <option value="director">Director</option>
      <option value="superintendent_pharmacist">Superintendent Pharmacist</option>
      <option value="branch_manager">Branch Manager</option>
      <option value="hr_admin">HR / Admin</option>
      <option value="operations_manager">Operations Manager</option>
      <option value="procurement_manager">Procurement Manager</option>
      <option value="other">Other</option>
    </select>

    <div
      class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
    ></div>
  </div>

  <!-- Contact Phone -->
  <div class="fv-row mb-8">
    <label class="form-label required">Contact Phone Number</label>
    <div class="row g-3">
      <div class="col-4">
        <select
          name="contactPhoneCode"
          class="form-select bg-transparent"
          data-kt-select2="true"
          data-hide-search="false"
          data-placeholder="Code"
        >
          <option value="" disabled>Code</option>
          <option value="+234" selected>🇳🇬 +234</option>
        </select>
      </div>
      <div class="col-8">
        <input
          type="tel"
          name="contactPhone"
          class="form-control bg-transparent"
          placeholder="08012345678"
          autocomplete="off"
        />
        <div
          class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"
        ></div>
      </div>
    </div>
  </div>

  <!-- Submit -->
  <div class="d-grid mb-10">
    <button type="submit" id="kt_onboarding_submit" class="btn btn-primary">
      <span class="indicator-label">Complete Setup</span>
      <span class="indicator-progress">
        Please wait...
        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
      </span>
    </button>
  </div>
</form>

<script>
  window.locations = <%- locations %>;
</script>
