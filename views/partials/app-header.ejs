<!-- views/partials/app-header.ejs -->

<div id="kt_app_header" class="app-header">
  <div
    class="app-container container-fluid d-flex align-items-center justify-content-between"
    id="kt_app_header_container"
  >
    <!-- Left side -->
    <div class="d-flex align-items-center flex-shrink-0">
      <!-- Mobile sidebar toggle -->
      <button
        type="button"
        class="btn btn-icon btn-color-white btn-active-color-primary-2 w-40px h-40px d-lg-none me-3"
        id="kt_app_sidebar_mobile_toggle"
        title="Show sidebar menu"
      >
        <i class="ki-duotone ki-abstract-14 fs-2">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>
      </button>

      <!-- Brand -->
      <a href="<%= userHome %>" class="d-flex align-items-center">
        <img alt="Loqum Logo" src="/assets/images/logo_white.png" class="h-30px h-lg-35px" />
      </a>
    </div>

    <!-- Header actions -->
    <div class="d-flex align-items-center gap-2 gap-lg-3">
      <!-- Notifications -->
      <div class="app-navbar-item">
        <button
          type="button"
          class="btn btn-icon btn-custom btn-color-white btn-active-color-primary-2 bg-white bg-opacity-10 w-40px h-40px"
          data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
          data-kt-menu-attach="parent"
          data-kt-menu-placement="bottom-end"
        >
          <i class="ki-duotone ki-notification-status fs-1">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
          </i>
        </button>

        <div
          class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg fw-semibold py-4 w-325px"
          data-kt-menu="true"
        >
          <div class="px-5 pb-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <div class="fw-bold fs-5 text-gray-900">Notifications</div>
                <div class="text-muted fs-7">
                  Updates about shifts, invites, and account activity.
                </div>
              </div>

              <span class="badge badge-light-primary">0 new</span>
            </div>
          </div>

          <div class="separator my-2"></div>

          <div class="px-5 py-8 text-center">
            <div class="symbol symbol-55px mx-auto mb-4">
              <span class="symbol-label bg-light-primary">
                <i class="ki-duotone ki-notification-bing fs-2x text-primary">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>
              </span>
            </div>

            <div class="fw-bold text-gray-900 mb-1">No notifications yet</div>
            <div class="text-muted fs-7">
              Important updates will appear here when activity starts.
            </div>
          </div>
        </div>
      </div>

      <!-- Theme mode -->
      <div class="app-navbar-item">
        <button
          type="button"
          class="btn btn-icon btn-custom btn-color-white btn-active-color-primary-2 bg-white bg-opacity-10 w-40px h-40px"
          data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
          data-kt-menu-attach="parent"
          data-kt-menu-placement="bottom-end"
        >
          <i class="ki-duotone ki-night-day theme-light-show fs-1">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
            <span class="path5"></span>
            <span class="path6"></span>
            <span class="path7"></span>
            <span class="path8"></span>
            <span class="path9"></span>
            <span class="path10"></span>
          </i>

          <i class="ki-duotone ki-moon theme-dark-show fs-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
        </button>

        <div
          class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-title-gray-700 menu-icon-gray-500 menu-active-bg menu-state-color fw-semibold py-4 fs-base w-150px"
          data-kt-menu="true"
          data-kt-element="theme-mode-menu"
        >
          <div class="menu-item px-3 my-0">
            <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="light">
              <span class="menu-icon" data-kt-element="icon">
                <i class="ki-duotone ki-night-day fs-2">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                  <span class="path4"></span>
                  <span class="path5"></span>
                  <span class="path6"></span>
                  <span class="path7"></span>
                  <span class="path8"></span>
                  <span class="path9"></span>
                  <span class="path10"></span>
                </i>
              </span>
              <span class="menu-title">Light</span>
            </a>
          </div>

          <div class="menu-item px-3 my-0">
            <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="dark">
              <span class="menu-icon" data-kt-element="icon">
                <i class="ki-duotone ki-moon fs-2">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
              </span>
              <span class="menu-title">Dark</span>
            </a>
          </div>

          <div class="menu-item px-3 my-0">
            <a href="#" class="menu-link px-3 py-2" data-kt-element="mode" data-kt-value="system">
              <span class="menu-icon" data-kt-element="icon">
                <i class="ki-duotone ki-screen fs-2">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                  <span class="path4"></span>
                </i>
              </span>
              <span class="menu-title">System</span>
            </a>
          </div>
        </div>
      </div>

      <!-- User menu -->
      <% if (currentUser) { %>
      <div class="app-navbar-item" id="kt_header_user_menu_toggle">
        <div
          class="d-flex align-items-center bg-white bg-opacity-10 rounded-pill px-2 py-2 cursor-pointer"
          data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
          data-kt-menu-attach="parent"
          data-kt-menu-placement="bottom-end"
        >
          <div class="symbol symbol-35px">
            <% if (userPhoto) { %>
            <img src="<%= userPhoto %>" alt="<%= userDisplayName %>" />
            <% } else { %>
            <div class="symbol-label bg-light-primary text-primary fw-bold">
              <%= userInitials || "U" %>
            </div>
            <% } %>
          </div>

          <div class="d-none d-lg-flex flex-column ms-3 me-2">
            <span class="text-white fw-bold fs-7 lh-1"> <%= userDisplayName || "User" %> </span>
            <span class="text-white opacity-75 fw-semibold fs-8 mt-1">
              <%= userEmail || "" %>
            </span>
          </div>

          <i class="ki-duotone ki-down fs-5 text-white opacity-75 d-none d-lg-inline-flex"></i>
        </div>

        <div
          class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-300px"
          data-kt-menu="true"
        >
          <!-- User summary -->
          <div class="menu-item px-3">
            <div class="menu-content d-flex align-items-center px-3">
              <div class="symbol symbol-55px me-5">
                <% if (userPhoto) { %>
                <img src="<%= userPhoto %>" alt="<%= userDisplayName %>" />
                <% } else { %>
                <div class="symbol-label bg-light-primary text-primary fw-bold fs-3">
                  <%= userInitials || "U" %>
                </div>
                <% } %>
              </div>

              <div class="d-flex flex-column">
                <div class="fw-bold fs-5 text-gray-900"><%= userDisplayName || "User" %></div>

                <div class="fw-semibold text-muted fs-7 text-truncate mw-175px">
                  <%= userEmail || "" %>
                </div>

                <% if (userRoleBadge) { %>
                <span
                  class="badge <%= userRoleBadge.className %> fw-bold fs-8 mt-2 align-self-start"
                >
                  <%= userRoleBadge.label %>
                </span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="separator my-2"></div>

          <!-- My Profile -->
          <% if (userAccountUrl) { %>
          <div class="menu-item px-5">
            <a href="<%= userAccountUrl %>" class="menu-link px-5">
              <span class="menu-icon">
                <i class="ki-duotone ki-user fs-3 text-gray-600">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
              </span>
              <span class="menu-title">Account Settings</span>
            </a>
          </div>

          <div class="separator my-2"></div>
          <% } %>

          <!-- Sign out -->
          <div class="menu-item px-5">
            <form action="/logout" method="POST" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

              <button
                type="submit"
                class="menu-link px-5 border-0 bg-transparent w-100 text-start text-danger"
              >
                <span class="menu-icon">
                  <i class="ki-duotone ki-exit-right fs-3 text-danger">
                    <span class="path1"></span>
                    <span class="path2"></span>
                  </i>
                </span>
                <span class="menu-title">Sign Out</span>
              </button>
            </form>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>
