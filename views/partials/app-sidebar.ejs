<!-- views/partials/app-sidebar.ejs -->

<div class="app-navbar flex-column flex-center py-4">
  <!--begin::Home-->
  <a
    href="<%= userHome %>"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Home"
  >
    <i class="ki-duotone ki-home-2 fs-1">
      <span class="path1"></span>
      <span class="path2"></span>
    </i>
  </a>
  <!--end::Home-->

  <% if (user && user.role === 'professional') { %>

  <!--begin::Find Shifts-->
  <a
    href="/shifts"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Find Shifts"
  >
    <i class="ki-duotone ki-magnifier fs-1">
      <span class="path1"></span>
      <span class="path2"></span>
    </i>
  </a>
  <!--end::Find Shifts-->

  <!--begin::My Shifts-->
  <div
    data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
    data-kt-menu-placement="right-start"
    data-kt-menu-attach="parent"
    class="menu menu-item py-2 mb-3"
  >
    <span class="menu-link menu-center">
      <span class="menu-icon me-0">
        <i class="ki-duotone ki-calendar fs-2x">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>
      </span>
    </span>
    <div
      class="menu-sub menu-sub-dropdown menu-sub-indention px-2 py-4 w-175px"
      data-kt-menu="true"
    >
      <div class="menu-item">
        <div class="menu-content">
          <span class="menu-section fs-5 fw-bolder ps-1 py-1">My Shifts</span>
        </div>
      </div>
      <div class="menu-item">
        <a class="menu-link" href="/shifts/my?tab=pending"
          ><span class="menu-bullet"><span class="bullet bullet-dot"></span></span
          ><span class="menu-title">Pending</span></a
        >
      </div>
      <div class="menu-item">
        <a class="menu-link" href="/shifts/my?tab=confirmed"
          ><span class="menu-bullet"><span class="bullet bullet-dot"></span></span
          ><span class="menu-title">Confirmed</span></a
        >
      </div>
      <div class="menu-item">
        <a class="menu-link" href="/shifts/my?tab=completed"
          ><span class="menu-bullet"><span class="bullet bullet-dot"></span></span
          ><span class="menu-title">Completed</span></a
        >
      </div>
    </div>
  </div>
  <!--end::My Shifts-->

  <!--begin::Earnings-->
  <a
    href="/earnings"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Earnings"
  >
    <i class="ki-duotone ki-wallet fs-1">
      <span class="path1"></span>
      <span class="path2"></span>
      <span class="path3"></span>
      <span class="path4"></span>
    </i>
  </a>
  <!--end::Earnings-->

  <% } else if (user && user.role === 'employer') { %>

  <!--begin::Manage Shifts-->
  <a
    href="/shifts/manage"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Manage Shifts"
  >
    <i class="ki-duotone ki-calendar-tick fs-1">
      <span class="path1"></span>
      <span class="path2"></span>
      <span class="path3"></span>
      <span class="path4"></span>
      <span class="path5"></span>
      <span class="path6"></span>
    </i>
  </a>
  <!--end::Manage Shifts-->

  <!--begin::Business Profile-->
  <a
    href="/business-profile"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Business Profile"
  >
    <i class="ki-duotone ki-shop fs-1">
      <span class="path1"></span>
      <span class="path2"></span>
      <span class="path3"></span>
      <span class="path4"></span>
      <span class="path5"></span>
    </i>
  </a>
  <!--end::Business Profile-->

  <!--begin::Finance-->
  <a
    href="/finance"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Finance"
  >
    <i class="ki-duotone ki-wallet fs-1">
      <span class="path1"></span>
      <span class="path2"></span>
      <span class="path3"></span>
      <span class="path4"></span>
    </i>
  </a>
  <!--end::Finance-->

  <% } else if (user && user.role === 'admin') { %>

  <!--begin::User Management-->
  <div
    data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
    data-kt-menu-placement="right-start"
    data-kt-menu-attach="parent"
    class="menu menu-item py-2 mb-3"
  >
    <span class="menu-link menu-center">
      <span class="menu-icon me-0">
        <i class="ki-duotone ki-people fs-2x">
          <span class="path1"></span><span class="path2"></span><span class="path3"></span
          ><span class="path4"></span><span class="path5"></span>
        </i>
      </span>
    </span>
    <div
      class="menu-sub menu-sub-dropdown menu-sub-indention px-2 py-4 w-175px"
      data-kt-menu="true"
    >
      <div class="menu-item">
        <div class="menu-content">
          <span class="menu-section fs-5 fw-bolder ps-1 py-1">Users</span>
        </div>
      </div>
      <div class="menu-item">
        <a class="menu-link" href="/admin/users?role=employer"
          ><span class="menu-bullet"><span class="bullet bullet-dot"></span></span
          ><span class="menu-title">Employers</span></a
        >
      </div>
      <div class="menu-item">
        <a class="menu-link" href="/admin/users?role=professional"
          ><span class="menu-bullet"><span class="bullet bullet-dot"></span></span
          ><span class="menu-title">Professionals</span></a
        >
      </div>
    </div>
  </div>
  <!--end::User Management-->

  <!--begin::Shift Management-->
  <div
    data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
    data-kt-menu-placement="right-start"
    data-kt-menu-attach="parent"
    class="menu menu-item py-2 mb-3"
  >
    <span class="menu-link menu-center">
      <span class="menu-icon me-0">
        <i class="ki-duotone ki-calendar-tick fs-2x">
          <span class="path1"></span><span class="path2"></span><span class="path3"></span
          ><span class="path4"></span><span class="path5"></span><span class="path6"></span>
        </i>
      </span>
    </span>
    <div
      class="menu-sub menu-sub-dropdown menu-sub-indention px-2 py-4 w-175px"
      data-kt-menu="true"
    >
      <div class="menu-item">
        <div class="menu-content">
          <span class="menu-section fs-5 fw-bolder ps-1 py-1">Shifts</span>
        </div>
      </div>
      <div class="menu-item">
        <a class="menu-link" href="/admin/shifts"
          ><span class="menu-bullet"><span class="bullet bullet-dot"></span></span
          ><span class="menu-title">All Shifts</span></a
        >
      </div>
      <div class="menu-item">
        <a class="menu-link" href="/admin/disputes"
          ><span class="menu-bullet"><span class="bullet bullet-dot"></span></span
          ><span class="menu-title">Disputes</span></a
        >
      </div>
    </div>
  </div>
  <!--end::Shift Management-->

  <!--begin::Global Finance-->
  <a
    href="/admin/finance"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Finance"
  >
    <i class="ki-duotone ki-dollar fs-1">
      <span class="path1"></span><span class="path2"></span><span class="path3"></span>
    </i>
  </a>
  <!--end::Global Finance-->

  <!--begin::Admin Settings-->
  <a
    href="/admin/settings"
    class="btn btn-icon btn-default mx-auto mb-4"
    data-bs-toggle="tooltip"
    data-bs-placement="right"
    title="Admin Settings"
  >
    <i class="ki-duotone ki-setting-2 fs-1">
      <span class="path1"></span><span class="path2"></span>
    </i>
  </a>
  <!--end::Admin Settings-->

  <% } %>
</div>
