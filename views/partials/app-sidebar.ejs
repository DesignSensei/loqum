<!-- views/partials/app-sidebar.ejs -->

<div class="loqum-sidebar-rail">
  <div class="loqum-sidebar-nav app-sidebar-menu">
    <!-- Home -->
    <a
      href="<%= userHome %>"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Home"
    >
      <i class="ki-duotone ki-home-2 fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
    </a>

    <% if (user && user.role === "professional") { %>
    <span class="d-block text-center text-uppercase fs-9 fw-semibold text-gray-500 py-2 w-100">
      Work
    </span>

    <!-- Find Shifts -->
    <a
      href="/professional/shifts"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Find Shifts"
    >
      <i class="ki-duotone ki-magnifier fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
    </a>

    <!-- My Shifts -->
    <div
      class="menu menu-item loqum-sidebar-menu-item"
      data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
      data-kt-menu-placement="right-start"
      data-kt-menu-attach="parent"
    >
      <span class="menu-link menu-center loqum-sidebar-link" aria-label="My Shifts">
        <span class="menu-icon me-0">
          <i class="ki-duotone ki-calendar fs-2x">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
        </span>
      </span>

      <div
        class="menu-sub menu-sub-dropdown menu-sub-indention px-2 py-4 w-175px"
        data-kt-menu="true"
      >
        <div class="menu-item">
          <div class="menu-content">
            <span class="menu-section fs-5 fw-bolder ps-1 py-1"> My Shifts </span>
          </div>
        </div>

        <div class="separator my-2"></div>

        <div class="menu-item">
          <a class="menu-link" href="/professional/shifts/my?tab=pending">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Pending</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/professional/shifts/my?tab=confirmed">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Confirmed</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/professional/shifts/my?tab=completed">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Completed</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Find Jobs -->
    <a
      href="/jobs"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Find Jobs"
      aria-label="Find Jobs"
    >
      <i class="ki-duotone ki-magnifier fs-1" aria-hidden="true">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
    </a>

    <!-- My Applications -->
    <a
      href="/professional/job-applications"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="My Applications"
      aria-label="My Applications"
    >
      <i class="ki-duotone ki-notepad-edit fs-1" aria-hidden="true">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
      </i>
    </a>

    <!-- Cases -->
    <a
      href="/professional/cases"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Cases"
    >
      <i class="ki-duotone ki-notepad-edit fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
      </i>
    </a>

    <!-- Billing -->
    <a
      href="/professional/billing"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Billing"
    >
      <i class="ki-duotone ki-wallet fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
      </i>
    </a>

    <% } else if (user && user.role === "employer") { %>
    <!-- Manage Shifts -->
    <div
      class="menu menu-item loqum-sidebar-menu-item"
      data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
      data-kt-menu-placement="right-start"
      data-kt-menu-overflow="true"
      data-kt-menu-offset="0, 8"
    >
      <span class="menu-link menu-center loqum-sidebar-link" aria-label="Manage Shifts">
        <span class="menu-icon me-0">
          <i class="ki-duotone ki-calendar-tick fs-2x">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
            <span class="path5"></span>
            <span class="path6"></span>
          </i>
        </span>
      </span>

      <div
        class="menu-sub menu-sub-dropdown menu-sub-indention loqum-shifts-submenu px-2 py-4 w-175px"
        data-kt-menu="true"
      >
        <div class="menu-item">
          <div class="menu-content px-3 py-2 ms-3">
            <span class="fs-6 fw-bold text-gray-900"> Manage Shifts </span>
          </div>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/employer/shifts">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">All Shifts</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/employer/shifts?open=post-shift">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Post a Shift</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/employer/shifts/assignments">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Assignments</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/employer/shifts/attendance">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Attendance</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Manage Jobs -->
    <a
      href="/employer/jobs"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Manage Jobs"
      aria-label="Manage Jobs"
    >
      <i class="ki-duotone ki-shop fs-1" aria-hidden="true">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
        <span class="path5"></span>
      </i>
    </a>

    <!-- Applications -->
    <div
      class="menu menu-item loqum-sidebar-menu-item"
      data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
      data-kt-menu-placement="right-start"
      data-kt-menu-overflow="true"
      data-kt-menu-offset="0, 8"
    >
      <span class="menu-link menu-center loqum-sidebar-link" aria-label="Applications">
        <span class="menu-icon me-0">
          <i class="ki-duotone ki-notepad-edit fs-1" aria-hidden="true">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
          </i>
        </span>
      </span>

      <div
        class="menu-sub menu-sub-dropdown menu-sub-indention loqum-shifts-submenu px-2 py-4 w-175px"
        data-kt-menu="true"
      >
        <div class="menu-item">
          <div class="menu-content px-3 py-2 ms-3">
            <span class="fs-6 fw-bold text-gray-900"> Applications </span>
          </div>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/employer/shifts/applications">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Shift Applications</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/employer/job-applications">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Job Applications</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Cases -->
    <a
      href="/employer/cases"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Cases"
    >
      <i class="ki-duotone ki-shield-tick fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
      </i>
    </a>

    <!-- Billing -->
    <a
      href="/employer/billing"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Billing"
    >
      <i class="ki-duotone ki-wallet fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
      </i>
    </a>

    <!-- Business Profile -->
    <a
      href="/employer/business-profile"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Business Profile"
    >
      <i class="ki-duotone ki-shop fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
        <span class="path5"></span>
      </i>
    </a>

    <% } else if (user && user.role === "admin") { %>
    <!-- Shifts -->
    <div
      class="menu menu-item loqum-sidebar-menu-item"
      data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
      data-kt-menu-placement="right-start"
      data-kt-menu-attach="parent"
    >
      <span class="menu-link menu-center loqum-sidebar-link" aria-label="Shifts">
        <span class="menu-icon me-0">
          <i class="ki-duotone ki-calendar-tick fs-2x">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
            <span class="path5"></span>
            <span class="path6"></span>
          </i>
        </span>
      </span>

      <div
        class="menu-sub menu-sub-dropdown menu-sub-indention px-2 py-4 w-175px"
        data-kt-menu="true"
      >
        <div class="menu-item">
          <div class="menu-content">
            <span class="menu-section fs-5 fw-bolder ps-1 py-1"> Shifts </span>
          </div>
        </div>

        <div class="separator my-2"></div>

        <div class="menu-item">
          <a class="menu-link" href="/admin/shifts">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">All Shifts</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Jobs -->
    <a
      href="/admin/jobs"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Jobs"
      aria-label="Jobs"
    >
      <i class="ki-duotone ki-shop fs-1" aria-hidden="true">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
        <span class="path5"></span>
      </i>
    </a>

    <!-- Users -->
    <div
      class="menu menu-item loqum-sidebar-menu-item"
      data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
      data-kt-menu-placement="right-start"
      data-kt-menu-attach="parent"
    >
      <span class="menu-link menu-center loqum-sidebar-link" aria-label="Users">
        <span class="menu-icon me-0">
          <i class="ki-duotone ki-people fs-2x">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
            <span class="path5"></span>
          </i>
        </span>
      </span>

      <div
        class="menu-sub menu-sub-dropdown menu-sub-indention px-2 py-4 w-175px"
        data-kt-menu="true"
      >
        <div class="menu-item">
          <div class="menu-content">
            <span class="menu-section fs-5 fw-bolder ps-1 py-1"> Users </span>
          </div>
        </div>

        <div class="separator my-2"></div>

        <div class="menu-item">
          <a class="menu-link" href="/admin/users?role=employer">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Employers</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/admin/users?role=professional">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Professionals</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Cases -->
    <div
      class="menu menu-item loqum-sidebar-menu-item"
      data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
      data-kt-menu-placement="right-start"
      data-kt-menu-attach="parent"
    >
      <span class="menu-link menu-center loqum-sidebar-link" aria-label="Cases">
        <span class="menu-icon me-0">
          <i class="ki-duotone ki-notepad-edit fs-2x">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
          </i>
        </span>
      </span>

      <div
        class="menu-sub menu-sub-dropdown menu-sub-indention px-2 py-4 w-175px"
        data-kt-menu="true"
      >
        <div class="menu-item">
          <div class="menu-content">
            <span class="menu-section fs-5 fw-bolder ps-1 py-1"> Cases </span>
          </div>
        </div>

        <div class="separator my-2"></div>

        <div class="menu-item">
          <a class="menu-link" href="/admin/cases?type=claims">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Claims</span>
          </a>
        </div>

        <div class="menu-item">
          <a class="menu-link" href="/admin/cases?type=disputes">
            <span class="menu-bullet">
              <span class="bullet bullet-dot"></span>
            </span>
            <span class="menu-title">Disputes</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Finance -->
    <a
      href="/admin/finance"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Finance"
    >
      <i class="ki-duotone ki-dollar fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
      </i>
    </a>
    <% } %>
  </div>

  <!-- Bottom navigation -->
  <div class="loqum-sidebar-bottom">
    <% if (user && user.role === "admin") { %>
    <a
      href="/admin/platform-settings"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Platform Settings"
    >
      <i class="ki-duotone ki-setting-2 fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
    </a>
    <% } else { %>
    <a
      href="/account/settings"
      class="loqum-sidebar-link"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Account Settings"
    >
      <i class="ki-duotone ki-setting-2 fs-1">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>
    </a>
    <% } %>
  </div>
</div>
