<!-- views/partials/cases/admin-actions.ejs -->

<%# ─────────────────────────────── ADMIN ADJUDICATION ─────────────────────────────── %>

<% if (issue.actions.adjudicate?.available) { %>

  <form
    action="<%= issue.actions.adjudicate.url %>"
    method="post"
    data-case-action-form
    class="border-top pt-4"
  >

    <input
      type="hidden"
      name="_csrf"
      value="<%= csrfToken %>"
    />


    <%# ─────────────────────────────── DECISION / REASON ─────────────────────────────── %>

    <div class="row g-3">

      <div class="col-md-4">

        <label class="form-label fw-bold">
          Decision
        </label>

        <select
          class="form-select"
          name="decision"
          data-admin-decision
          required
        >

          <option value="">
            Choose a decision
          </option>

          <% issue.adjudication.decisions.forEach((decision) => { %>

            <option value="<%= decision.value %>">
              <%= decision.label %>
            </option>

          <% }); %>

        </select>

      </div>


      <div class="col-md-8">

        <label class="form-label fw-bold">
          Decision reason
        </label>

        <textarea
          class="form-control"
          name="reason"
          rows="2"
          minlength="10"
          maxlength="1500"
          required
        ></textarea>

      </div>

    </div>


    <%# ─────────────────────────────── ADJUSTED OUTCOME ─────────────────────────────── %>

    <%# Backend defines which adjusted fields belong to this issue.
        cases.js reveals and enables this block only when "adjusted" is selected. %>

    <% if (issue.adjudication.adjustedOutcome?.fields?.length) { %>

      <div
        class="bg-light rounded p-4 mt-3 d-none"
        data-adjusted-outcome
      >

        <div class="fw-bold text-gray-800 mb-3">
          Adjusted outcome
        </div>


        <div class="row g-3">

          <% issue.adjudication.adjustedOutcome.fields.forEach((field) => { %>

            <div class="<%= field.columnClass %>">

              <label class="form-label">
                <%= field.label %>
              </label>


              <% if (field.control === "textarea") { %>

                <textarea
                  class="form-control"
                  name="<%= field.inputName %>"
                  rows="<%= field.rows %>"
                  maxlength="<%= field.maxLength %>"
                  disabled
                ></textarea>

              <% } else { %>

                <input
                  class="form-control"
                  type="<%= field.control %>"
                  name="<%= field.inputName %>"
                  <% if (field.min !== undefined) { %>
                    min="<%= field.min %>"
                  <% } %>
                  <% if (field.step !== undefined) { %>
                    step="<%= field.step %>"
                  <% } %>
                  disabled
                />

              <% } %>

            </div>

          <% }); %>

        </div>

      </div>

    <% } %>


    <%# ─────────────────────────────── SUBMIT ─────────────────────────────── %>

    <button
      type="submit"
      class="btn btn-sm btn-danger mt-3"
    >
      <%= issue.actions.adjudicate.submitLabel %>
    </button>


    <div
      class="mt-3 d-none"
      data-case-action-message
    ></div>

  </form>

<% } %>