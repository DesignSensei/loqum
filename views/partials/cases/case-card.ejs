<!-- views/partials/cases/case-card.ejs -->

<div class="card card-flush border border-gray-300">
  <!-- Case header -->

  <%- include("case-header", { caseItem }) %>

  <div class="card-body pt-3">
    <!-- Case context -->

    <div class="row g-4 mb-5">
      <!-- Shift -->

      <div class="col-md-6 col-xl-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Shift</div>

        <% if (caseItem.shift?.detailsUrl) { %>
        <a href="<%= caseItem.shift.detailsUrl %>" class="fw-bold text-gray-800 text-hover-primary">
          <%= caseItem.shift.roleTitle %>
        </a>
        <% } else { %>
        <div class="fw-bold text-gray-800"><%= caseItem.shift?.roleTitle || "Shift" %></div>
        <% } %> <% if (caseItem.shift?.referenceCode) { %>
        <div class="text-gray-500 fs-7"><%= caseItem.shift.referenceCode %></div>
        <% } %>
      </div>

      <!-- Occurrence -->

      <div class="col-md-6 col-xl-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Occurrence</div>

        <div class="fw-bold text-gray-800">
          <%= caseItem.occurrence?.referenceCode || "Occurrence" %>
        </div>

        <% if (caseItem.occurrence?.startTime) { %>
        <div class="text-gray-500 fs-7"><%= caseItem.occurrence.startTime.label %></div>
        <% } else if (caseItem.occurrence?.occurrenceDate) { %>
        <div class="text-gray-500 fs-7"><%= caseItem.occurrence.occurrenceDate.label %></div>
        <% } %> <% if ( caseItem.occurrence?.slotNumber !== null && caseItem.occurrence?.slotNumber
        !== undefined ) { %>
        <div class="text-gray-500 fs-8">Slot <%= caseItem.occurrence.slotNumber %></div>
        <% } %>
      </div>

      <!-- Professional -->

      <% if (caseItem.professional) { %>
      <div class="col-md-6 col-xl-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Professional</div>

        <div class="fw-bold text-gray-800"><%= caseItem.professional.name %></div>

        <% if (caseItem.professional.type) { %>
        <div class="text-gray-500 fs-7"><%= caseItem.professional.type.label %></div>
        <% } %> <% if (caseItem.professional.specialty) { %>
        <div class="text-gray-500 fs-8"><%= caseItem.professional.specialty %></div>
        <% } %>
      </div>
      <% } %>

      <!-- Business -->

      <div class="col-md-6 col-xl-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Business</div>

        <div class="fw-bold text-gray-800"><%= caseItem.business?.name || "Business" %></div>
      </div>

      <!-- Branch -->

      <div class="col-md-6 col-xl-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Branch</div>

        <div class="fw-bold text-gray-800"><%= caseItem.branch?.name || "Branch" %></div>

        <% if (caseItem.branch?.address) { %>
        <div class="text-gray-500 fs-7"><%= caseItem.branch.address %></div>
        <% } %>
      </div>
    </div>

    <!-- Authoritative occurrence context -->

    <% if (caseItem.authoritativeOccurrence) { %> <% const authority =
    caseItem.authoritativeOccurrence; %>

    <details class="border border-gray-300 rounded p-4 mb-5">
      <summary class="fw-bold text-gray-800 cursor-pointer">
        Current authoritative occurrence
      </summary>

      <div class="pt-4">
        <div class="row g-4">
          <!-- Occurrence status -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Occurrence status</div>

            <% if (authority.status) { %>
            <span class="badge <%= authority.status.className %>">
              <%= authority.status.label %>
            </span>
            <% } else { %>
            <span class="text-gray-500"> Not available </span>
            <% } %>
          </div>

          <!-- Attendance status -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Attendance status</div>

            <% if (authority.attendanceStatus) { %>
            <span class="badge <%= authority.attendanceStatus.className %>">
              <%= authority.attendanceStatus.label %>
            </span>
            <% } else { %>
            <span class="text-gray-500"> Not available </span>
            <% } %>
          </div>

          <!-- Scheduled start -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Scheduled start</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.scheduled?.startTime?.label || "Not available" %>
            </div>
          </div>

          <!-- Scheduled end -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Scheduled end</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.scheduled?.endTime?.label || "Not available" %>
            </div>
          </div>

          <!-- Authoritative check-in -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Authoritative check-in</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.attendance?.authoritativeCheckInAt?.label || "Not available" %>
            </div>
          </div>

          <!-- Authoritative checkout -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Authoritative checkout</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.attendance?.authoritativeCheckOutAt?.label || "Not available" %>
            </div>
          </div>

          <!-- Base billable hours -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">BASE billable hours</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.base?.billableHours ?? "Not available" %>
            </div>
          </div>

          <!-- Base professional pay -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">BASE professional pay</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.base?.professionalPayDisplay || "Not available" %>
            </div>
          </div>

          <!-- Base platform fee -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">BASE platform fee</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.base?.platformFeeDisplay || "Not available" %>
            </div>
          </div>

          <!-- Base employer charge -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">BASE employer charge</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.base?.employerChargeDisplay || "Not available" %>
            </div>
          </div>

          <!-- Refundable amount -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Refundable amount</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.refund?.refundableAmountDisplay || "Not available" %>
            </div>
          </div>

          <!-- Refunded amount -->

          <div class="col-md-6 col-xl-3">
            <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Refunded amount</div>

            <div class="fw-semibold text-gray-800">
              <%= authority.refund?.refundedAmountDisplay || "Not available" %>
            </div>
          </div>
        </div>
      </div>
    </details>
    <% } %>

    <!-- Case issues -->

    <% if (caseItem.issues?.length) { %>
    <div class="d-flex flex-column gap-3">
      <% caseItem.issues.forEach((issue) => { %> <%- include("issue-card", { issue, csrfToken }) %>
      <% }); %>
    </div>
    <% } else { %>
    <div class="alert alert-light border mb-0">No case issues are available.</div>
    <% } %>

    <!-- Case timeline -->

    <% if (caseItem.timeline?.length) { %>
    <details class="border border-gray-300 rounded p-4 mt-5">
      <summary class="fw-bold text-gray-800 cursor-pointer">Case timeline</summary>

      <div class="pt-4">
        <div class="d-flex flex-column gap-3">
          <% caseItem.timeline.forEach((entry) => { %>
          <div class="border-start border-3 border-gray-300 ps-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
              <div class="fw-semibold text-gray-800"><%= entry.label %></div>

              <% if (entry.at) { %>
              <div class="text-gray-500 fs-8"><%= entry.at.label %></div>
              <% } %>
            </div>

            <% if (entry.actor) { %>
            <div class="text-gray-500 fs-8 mt-1">Actor: <%= entry.actor %></div>
            <% } %> <% if (entry.detail) { %>
            <div class="text-gray-600 fs-7 mt-1"><%= entry.detail %></div>
            <% } %>
          </div>
          <% }); %>
        </div>
      </div>
    </details>
    <% } %>

    <!-- Case withdrawal action -->

    <% if (caseItem.actions?.withdraw?.available) { %> <% const withdrawAction =
    caseItem.actions.withdraw; %>

    <form
      action="<%= withdrawAction.url %>"
      method="post"
      data-case-action-form
      class="border-top mt-5 pt-4"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="row g-3 align-items-end">
        <div class="col-md-9">
          <label class="form-label fw-bold" for="case-withdrawal-reason-<%= caseItem.id %>">
            <%= withdrawAction.reasonLabel %>
          </label>

          <textarea
            id="case-withdrawal-reason-<%= caseItem.id %>"
            class="form-control"
            name="reason"
            rows="2"
            minlength="<%= withdrawAction.reasonMinLength %>"
            maxlength="<%= withdrawAction.reasonMaxLength %>"
            placeholder="<%= withdrawAction.reasonPlaceholder %>"
            required
          ></textarea>
        </div>

        <div class="col-md-3">
          <button type="submit" class="btn btn-sm btn-light-danger w-100">
            <%= withdrawAction.label %>
          </button>
        </div>
      </div>

      <div class="mt-3 d-none" data-case-action-message></div>
    </form>
    <% } %>

    <!-- Withdrawal history -->

    <% if (caseItem.withdrawal?.withdrawnAt) { %>
    <div class="border-top mt-5 pt-4">
      <div class="text-gray-600 fs-7">
        Withdrawn

        <strong> <%= caseItem.withdrawal.withdrawnAt.label %> </strong>
      </div>

      <% if (caseItem.withdrawal.reason) { %>
      <div class="text-gray-700 mt-1"><%= caseItem.withdrawal.reason %></div>
      <% } %>
    </div>
    <% } %>
  </div>
</div>
