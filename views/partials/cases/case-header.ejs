<!-- views/partials/cases/case-header.ejs -->

<!-- Case identity -->

<div class="card-header border-0 pt-5 pb-2">
  <div class="card-title d-flex flex-column align-items-start gap-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
      <!-- Case kind -->

      <span class="badge <%= caseItem.kind.className %>"> <%= caseItem.kind.label %> </span>

      <!-- Case status -->

      <span class="badge <%= caseItem.status.className %>"> <%= caseItem.status.label %> </span>

      <!-- Action required -->

      <% if (caseItem.actions.required) { %>
      <span class="badge badge-light-warning"> Action required </span>
      <% } %>
    </div>

    <!-- Case reference -->

    <span class="card-label fw-bold text-gray-900 fs-3"> <%= caseItem.referenceCode %> </span>
  </div>

  <!-- Submission time -->

  <div class="card-toolbar text-gray-500 fs-7">
    Submitted <%= caseItem.submittedAt?.label || "Not available" %>
  </div>
</div>
