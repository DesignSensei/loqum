<!-- views/partials/cases/employer-actions.ejs -->

<!-- Employer claim review -->

<% if (issue.actions.review?.available) { %>
  <% const reviewAction = issue.actions.review; %>

  <form
    action="<%= reviewAction.url %>"
    method="post"
    data-case-action-form
    data-employer-claim-review
    class="border-top pt-4"
  >
    <input
      type="hidden"
      name="_csrf"
      value="<%= csrfToken %>"
    />

    <!-- Decision and reason -->

    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <label
          class="form-label fw-bold"
          for="employer-decision-<%= issue.id %>"
        >
          Decision
        </label>

        <select
          id="employer-decision-<%= issue.id %>"
          class="form-select"
          name="decision"
          required
          data-employer-review-decision
          data-counter-position-decision="<%= reviewAction.counterPositionDecision %>"
        >
          <option value="">
            Choose a decision
          </option>

          <% reviewAction.decisions.forEach((decision) => { %>
            <option value="<%= decision.value %>">
              <%= decision.label %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-8">
        <label
          class="form-label fw-bold"
          for="employer-reason-<%= issue.id %>"
        >
          Reason
        </label>

        <textarea
          id="employer-reason-<%= issue.id %>"
          class="form-control"
          name="reason"
          rows="3"
          minlength="10"
          maxlength="1500"
          required
        ></textarea>

        <div class="form-text">
          Explain the reason for your decision.
        </div>
      </div>
    </div>

    <!-- Counter-position -->

    <% if (reviewAction.counterPositionFields?.length) { %>
      <div
        class="mb-4 d-none"
        data-employer-counter-position
      >
        <div class="fw-bold text-gray-700 mb-1">
          Counter-position
        </div>

        <div class="text-gray-500 fs-7 mb-3">
          If you disagree with the professional's position, you may propose the factual or BASE-pay position you believe is correct.
        </div>

        <div class="row g-3">
          <% reviewAction.counterPositionFields.forEach((field) => { %>
            <div class="<%= field.columnClass || "col-12" %>">
              <label
                class="form-label"
                for="employer-counter-<%= issue.id %>-<%= field.name %>"
              >
                <%= field.label %>
              </label>

              <% if (field.control === "textarea") { %>
                <textarea
                  id="employer-counter-<%= issue.id %>-<%= field.name %>"
                  class="form-control"
                  name="<%= field.inputName %>"
                  rows="<%= field.rows || 3 %>"
                  <% if (field.maxLength !== undefined) { %>
                    maxlength="<%= field.maxLength %>"
                  <% } %>
                  data-counter-position-input
                ></textarea>
              <% } else { %>
                <input
                  id="employer-counter-<%= issue.id %>-<%= field.name %>"
                  class="form-control"
                  type="<%= field.control %>"
                  name="<%= field.inputName %>"
                  <% if (field.min !== undefined) { %>
                    min="<%= field.min %>"
                  <% } %>
                  <% if (field.max !== undefined) { %>
                    max="<%= field.max %>"
                  <% } %>
                  <% if (field.step !== undefined) { %>
                    step="<%= field.step %>"
                  <% } %>
                  data-counter-position-input
                />
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Employer evidence -->

    <% if (reviewAction.evidence?.allowed) { %>
      <% const evidenceConfig = reviewAction.evidence; %>

      <div
        class="mb-4"
        data-case-evidence
        data-evidence-max-items="<%= evidenceConfig.maxItems %>"
      >
        <div
          class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3"
        >
          <div>
            <div class="fw-bold text-gray-700">
              Supporting evidence
            </div>

            <div class="text-gray-500 fs-7">
              Evidence is optional. Add up to
              <%= evidenceConfig.maxItems %>
              item<%= evidenceConfig.maxItems === 1 ? "" : "s" %>.
            </div>
          </div>

          <button
            type="button"
            class="btn btn-sm btn-light-primary"
            data-add-evidence
          >
            Add evidence
          </button>
        </div>

        <!-- Evidence rows are inserted by cases.js -->

        <div
          class="d-flex flex-column gap-3"
          data-evidence-list
        ></div>

        <!-- Evidence row template -->

        <template data-evidence-template>
          <div
            class="border border-gray-300 rounded p-4"
            data-evidence-row
          >
            <div
              class="d-flex align-items-center justify-content-between gap-3 mb-3"
            >
              <div class="fw-bold text-gray-700">
                Evidence item
                <span data-evidence-number></span>
              </div>

              <button
                type="button"
                class="btn btn-sm btn-light-danger"
                data-remove-evidence
              >
                Remove
              </button>
            </div>

            <div class="row g-3">
              <!-- Evidence type -->

              <div class="col-md-4">
                <label class="form-label">
                  Evidence type
                </label>

                <select
                  class="form-select"
                  name="evidence[__INDEX__][type]"
                  data-evidence-type
                  required
                >
                  <option value="">
                    Select evidence type
                  </option>

                  <% evidenceConfig.typeOptions.forEach((option) => { %>
                    <option value="<%= option.value %>">
                      <%= option.label %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <!-- Evidence reference -->

              <div class="col-md-8">
                <label class="form-label">
                  Reference
                </label>

                <input
                  type="text"
                  class="form-control"
                  name="evidence[__INDEX__][reference]"
                  maxlength="<%= evidenceConfig.referenceMaxLength %>"
                  placeholder="URL, file reference, message reference, or other evidence reference"
                  data-evidence-reference
                  required
                />

                <div class="form-text">
                  A reference is required for each evidence item.
                </div>
              </div>

              <!-- Evidence description -->

              <div class="col-12">
                <label class="form-label">
                  Description
                </label>

                <textarea
                  class="form-control"
                  name="evidence[__INDEX__][description]"
                  rows="2"
                  maxlength="<%= evidenceConfig.descriptionMaxLength %>"
                  placeholder="Optional description of this evidence"
                  data-evidence-description
                ></textarea>
              </div>
            </div>
          </div>
        </template>

        <!-- Evidence limit message -->

        <div
          class="text-gray-500 fs-7 mt-2 d-none"
          data-evidence-limit-message
        >
          You have reached the maximum of
          <%= evidenceConfig.maxItems %>
          evidence item<%= evidenceConfig.maxItems === 1 ? "" : "s" %>.
        </div>
      </div>
    <% } %>

    <!-- Review notice -->

    <div class="alert alert-light border mb-4">
      <div class="text-gray-700 fs-7">
        Approving accepts the professional's position. Rejecting sends the disputed issue to admin review. A counter-position and supporting evidence, if provided, will be included in the record for admin adjudication.
      </div>
    </div>

    <!-- Submit action -->

    <div class="d-flex flex-wrap align-items-center gap-3">
      <button
        type="submit"
        class="btn btn-sm btn-primary"
      >
        <%= reviewAction.submitLabel %>
      </button>
    </div>

    <!-- Action result message -->

    <div
      class="mt-3 d-none"
      data-case-action-message
    ></div>
  </form>
<% } %>