<!-- views/partials/cases/issue-card.ejs -->

<details class="border border-gray-300 rounded p-4" open>
  <!-- Issue header -->

  <summary class="d-flex flex-wrap align-items-center justify-content-between gap-3 cursor-pointer">
    <span class="fw-bold text-gray-900"> <%= issue.type.label %> </span>

    <span class="badge <%= issue.status.className %>"> <%= issue.status.label %> </span>
  </summary>

  <div class="pt-4">
    <!-- Settlement scope -->

    <% if (issue.settlementScope?.components?.length) { %>
    <div class="mb-4">
      <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-2">
        <%= issue.settlementScope.label %>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <% issue.settlementScope.components.forEach((component) => { %>
        <span class="badge badge-light-info"> <%= component.label %> </span>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Original submission -->

    <div class="bg-light rounded p-4 mb-4">
      <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Original statement</div>

      <div class="text-gray-800 fs-6"><%= issue.statement || "No statement recorded." %></div>

      <% if (issue.originalPosition?.fields?.length) { %>
      <div class="separator separator-dashed my-3"></div>

      <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-2">Submitted position</div>

      <div class="row g-3">
        <% issue.originalPosition.fields.forEach((field) => { %>
        <div class="col-md-6">
          <div class="text-gray-500 fs-8 mb-1"><%= field.label %></div>

          <div class="fw-semibold text-gray-800"><%= field.displayValue %></div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- Original evidence -->

    <% if (issue.submissionEvidence?.length) { %>
    <div class="mb-4">
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="fw-bold text-gray-700"> Submitted evidence </span>

        <span class="badge badge-light-secondary">
          <%= issue.submissionEvidence.length %> item<%= issue.submissionEvidence.length === 1 ? ""
          : "s" %>
        </span>
      </div>

      <div class="d-flex flex-column gap-2">
        <% issue.submissionEvidence.forEach((evidence) => { %>
        <div class="border border-gray-300 rounded p-3">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <% if (evidence.type) { %>
            <span class="badge badge-light"> <%= evidence.type %> </span>
            <% } %> <% if (evidence.recordedAt) { %>
            <span class="text-gray-500 fs-8"> <%= evidence.recordedAt.label %> </span>
            <% } %>
          </div>

          <% if (evidence.description) { %>
          <div class="text-gray-700"><%= evidence.description %></div>
          <% } %> <% if (evidence.reference) { %>
          <div class="text-gray-500 fs-7 mt-1">Reference: <%= evidence.reference %></div>
          <% } %>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Other party response -->

    <% if (issue.partyResponse) { %>
    <div class="border border-gray-300 rounded p-4 mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="fw-bold text-gray-900"><%= issue.partyResponse.label %></div>

        <% if (issue.partyResponse.respondedAt) { %>
        <div class="text-gray-500 fs-8"><%= issue.partyResponse.respondedAt.label %></div>
        <% } %>
      </div>

      <!-- Response decision -->

      <% if (issue.partyResponse.decision) { %>
      <div class="mb-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Decision</div>

        <div class="text-gray-700"><%= issue.partyResponse.decision.label %></div>
      </div>
      <% } %>

      <!-- Response statement -->

      <% if (issue.partyResponse.statement) { %>
      <div class="mb-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Statement</div>

        <div class="text-gray-700"><%= issue.partyResponse.statement %></div>
      </div>
      <% } %>

      <!-- Response reason -->

      <% if (issue.partyResponse.reason) { %>
      <div class="mb-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-1">Reason</div>

        <div class="text-gray-700"><%= issue.partyResponse.reason %></div>
      </div>
      <% } %>

      <!-- Counter-position -->

      <% if (issue.partyResponse.counterPosition?.fields?.length) { %>
      <div class="mb-3">
        <div class="text-gray-500 fs-8 text-uppercase fw-bold mb-2">Counter-position</div>

        <div class="row g-3">
          <% issue.partyResponse.counterPosition.fields.forEach((field) => { %>
          <div class="col-md-6">
            <div class="text-gray-500 fs-8 mb-1"><%= field.label %></div>

            <div class="fw-semibold text-gray-800"><%= field.displayValue %></div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Response evidence -->

      <% if (issue.partyResponse.evidence?.length) { %>
      <div>
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="text-gray-500 fs-8 text-uppercase fw-bold"> Supporting evidence </span>

          <span class="badge badge-light-secondary">
            <%= issue.partyResponse.evidence.length %> item<%= issue.partyResponse.evidence.length
            === 1 ? "" : "s" %>
          </span>
        </div>

        <div class="d-flex flex-column gap-2">
          <% issue.partyResponse.evidence.forEach((evidence) => { %>
          <div class="border border-gray-300 rounded p-3">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
              <% if (evidence.type) { %>
              <span class="badge badge-light"> <%= evidence.type %> </span>
              <% } %> <% if (evidence.recordedAt) { %>
              <span class="text-gray-500 fs-8"> <%= evidence.recordedAt.label %> </span>
              <% } %>
            </div>

            <% if (evidence.description) { %>
            <div class="text-gray-700"><%= evidence.description %></div>
            <% } %> <% if (evidence.reference) { %>
            <div class="text-gray-500 fs-7 mt-1">Reference: <%= evidence.reference %></div>
            <% } %>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Admin decision -->

    <% if (issue.adminDecision) { %>
    <div class="border-start border-3 border-gray-300 ps-4 mb-4">
      <div class="fw-bold text-gray-700 mb-1">Admin decision</div>

      <div class="text-gray-700"><%= issue.adminDecision.label %></div>

      <% if (issue.adminDecisionReason) { %>
      <div class="text-gray-600 mt-1"><%= issue.adminDecisionReason %></div>
      <% } %>
    </div>
    <% } %>

    <!-- Admin adjudication context -->

    <% if (issue.positions || issue.decisionPreview || issue.timeline?.length) { %> <%-
    include("admin-context", { issue }) %> <% } %>

    <!-- Current response deadline -->

    <% if (issue.deadline) { %>
    <div class="alert alert-warning py-3 px-4 mb-4">
      Response deadline:

      <strong> <%= issue.deadline.label %> </strong>
    </div>
    <% } %>

    <!-- Professional actions -->

    <%- include("professional-actions", { issue, csrfToken }) %>

    <!-- Employer actions -->

    <%- include("employer-actions", { issue, csrfToken }) %>

    <!-- Admin actions -->

    <%- include("admin-actions", { issue, csrfToken }) %>
  </div>
</details>
