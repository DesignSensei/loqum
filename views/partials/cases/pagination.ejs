<!-- views/partials/cases/pagination.ejs -->

<%# ─────────────────────────────── PAGINATION ─────────────────────────────── %> <% if
(pagination.totalPages > 1) { %>

<div class="d-flex align-items-center justify-content-between mt-6">
  <div class="text-gray-500 fs-7">Page <%= pagination.page %> of <%= pagination.totalPages %></div>

  <div class="d-flex gap-2">
    <% if (pagination.previousUrl) { %>

    <a class="btn btn-sm btn-light" href="<%= pagination.previousUrl %>"> Previous </a>

    <% } %> <% if (pagination.nextUrl) { %>

    <a class="btn btn-sm btn-light" href="<%= pagination.nextUrl %>"> Next </a>

    <% } %>
  </div>
</div>

<% } %>
