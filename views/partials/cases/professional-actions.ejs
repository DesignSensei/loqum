<!-- views/partials/cases/professional-actions.ejs -->

<%# ─────────────────────────────── PROFESSIONAL APPEAL ─────────────────────────────── %>

<% if (issue.actions.appeal?.available) { %>

  <form
    action="<%= issue.actions.appeal.url %>"
    method="post"
    data-case-action-form
    class="border-top pt-4"
  >

    <input
      type="hidden"
      name="_csrf"
      value="<%= csrfToken %>"
    />

    <label class="form-label fw-bold">
      <%= issue.actions.appeal.statementLabel %>
    </label>

    <textarea
      class="form-control mb-3"
      name="statement"
      rows="3"
      minlength="10"
      maxlength="2000"
      required
    ></textarea>

    <button
      type="submit"
      class="btn btn-sm btn-primary"
    >
      <%= issue.actions.appeal.submitLabel %>
    </button>

    <div
      class="mt-3 d-none"
      data-case-action-message
    ></div>

  </form>

<% } %>


