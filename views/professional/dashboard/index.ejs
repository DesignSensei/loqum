<!-- views/dashboards/professional/index.ejs -->

<% const view = typeof dashboardView !== "undefined" && dashboardView ? dashboardView : {}; const
dashboardStats = typeof stats !== "undefined" && stats ? stats : {}; const applications = typeof
recentApplications !== "undefined" && Array.isArray(recentApplications) ? recentApplications : [];
%>

<div class="row mb-4">
  <div class="col-12">
    <div class="alert <%= view.profileAlertClass %> border d-flex align-items-center p-4 mb-0">
      <i class="ki-duotone <%= view.profileIconClass %> fs-2x me-4">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
      </i>

      <div class="d-flex flex-column">
        <span class="fw-bold text-gray-900 fs-6"><%= view.profileTitle %></span>
        <span class="text-gray-600 fs-7"><%= view.profileMessage %></span>
      </div>
    </div>
  </div>
</div>

<div class="row gx-3 gx-xl-4 mb-5">
  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-body p-5">
        <div class="d-flex align-items-center mb-3">
          <i class="ki-duotone ki-user-tick fs-2x text-success me-3">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          <div>
            <div class="fw-bold text-gray-900 fs-6">Profile Verification</div>
            <div class="text-gray-500 fs-7"><%= view.profileStatusLabel %></div>
          </div>
        </div>

        <span class="badge <%= view.profileBadgeClass %>"> <%= view.profileBadgeLabel %> </span>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-body p-5">
        <div class="d-flex align-items-center mb-3">
          <i class="ki-duotone ki-shield-tick fs-2x text-info me-3">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>

          <div>
            <div class="fw-bold text-gray-900 fs-6">Professional Approval</div>
            <div class="text-gray-500 fs-7"><%= view.approvalStatusLabel %></div>
          </div>
        </div>

        <span class="badge <%= view.approvalBadgeClass %>"> <%= view.approvalBadgeLabel %> </span>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-body p-5">
        <div class="d-flex align-items-center mb-3">
          <i class="ki-duotone ki-eye fs-2x text-primary me-3">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          <div>
            <div class="fw-bold text-gray-900 fs-6">Marketplace</div>
            <div class="text-gray-500 fs-7"><%= view.marketplaceStatusLabel %></div>
          </div>
        </div>

        <span class="badge <%= view.marketplaceBadgeClass %>">
          <%= view.marketplaceBadgeLabel %>
        </span>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-body p-5">
        <div class="d-flex align-items-center mb-3">
          <i class="ki-duotone ki-wallet fs-2x text-warning me-3">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
          </i>

          <div>
            <div class="fw-bold text-gray-900 fs-6">Payout Setup</div>
            <div class="text-gray-500 fs-7"><%= view.payoutStatusLabel %></div>
          </div>
        </div>

        <span class="badge <%= view.payoutBadgeClass %>"> <%= view.payoutBadgeLabel %> </span>
      </div>
    </div>
  </div>
</div>

<% if (view.showPayoutNotice) { %>
<div class="row mb-5">
  <div class="col-12">
    <div class="alert bg-light-warning border border-warning d-flex align-items-center p-4 mb-0">
      <i class="ki-duotone ki-information-5 fs-2x text-warning me-4">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
      </i>

      <div class="d-flex flex-column">
        <span class="fw-bold text-gray-900 fs-6"><%= view.payoutTitle %></span>
        <span class="text-gray-600 fs-7"><%= view.payoutMessage %></span>
      </div>
    </div>
  </div>
</div>
<% } %>

<div class="row gx-3 gx-xl-4 mb-5">
  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
            <%= dashboardStats.applicationsSubmitted %>
          </span>
          <span class="text-gray-500 pt-1 fw-semibold fs-6"> Applications Submitted </span>
        </div>
      </div>

      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <div class="d-flex align-items-center gap-2">
          <i class="ki-duotone ki-send fs-2 text-primary">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
          <span class="text-gray-500 fw-semibold fs-7">All-time applications</span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
            <%= dashboardStats.pendingApplications %>
          </span>
          <span class="text-gray-500 pt-1 fw-semibold fs-6"> Pending Applications </span>
        </div>
      </div>

      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <div class="d-flex align-items-center gap-2">
          <i class="ki-duotone ki-time fs-2 text-warning">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>
          <span class="text-gray-500 fw-semibold fs-7">Awaiting employer review</span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
            <%= dashboardStats.upcomingShifts %>
          </span>
          <span class="text-gray-500 pt-1 fw-semibold fs-6"> Upcoming Shifts </span>
        </div>
      </div>

      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <div class="d-flex align-items-center gap-2">
          <i class="ki-duotone ki-calendar-tick fs-2 text-success">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>
          <span class="text-gray-500 fw-semibold fs-7">Confirmed future shifts</span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-lg-3 mb-4">
    <div class="card card-flush h-100">
      <div class="card-header pt-5 pb-0">
        <div class="card-title d-flex flex-column">
          <div class="d-flex align-items-center">
            <span class="fs-4 fw-semibold text-gray-500 me-1 align-self-start">₦</span>
            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">
              <%= view.walletBalanceFormatted %>
            </span>
          </div>
          <span class="text-gray-500 pt-1 fw-semibold fs-6">Wallet Balance</span>
        </div>
      </div>

      <div class="card-body d-flex align-items-end pt-6 pb-5">
        <a
          href="/professional/wallet"
          class="badge <%= view.walletCtaBadgeClass %> fs-7 fw-bold text-decoration-none"
        >
          <%= view.walletCtaLabel %>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="row gy-4 g-xl-5">
  <div class="col-xl-8 mb-4">
    <div class="card card-flush h-xl-100">
      <div class="card-header pt-5">
        <h3 class="card-title align-items-start flex-column">
          <span class="card-label fw-bold text-gray-900"> Recent Applications </span>
          <span class="text-gray-500 mt-1 fw-semibold fs-6"> Your latest shift applications </span>
        </h3>

        <div class="card-toolbar">
          <a href="/professional/applications" class="btn btn-sm btn-light"> View All </a>
        </div>
      </div>

      <div class="card-body pt-4">
        <% if (applications.length > 0) { %>
        <div class="table-responsive">
          <table class="table align-middle table-row-dashed fs-6 gy-2">
            <thead>
              <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                <th class="min-w-100px">Reference</th>
                <th class="min-w-125px">Role</th>
                <th class="min-w-100px">Branch</th>
                <th class="min-w-100px">Date</th>
                <th class="min-w-75px">Rate</th>
                <th class="min-w-100px">Application</th>
                <th class="min-w-75px">Shift</th>
              </tr>
            </thead>

            <tbody class="fw-bold text-gray-600">
              <% applications.forEach(function (application) { %>
              <tr>
                <td><%= application.referenceCode %></td>
                <td><%= application.roleTitle %></td>
                <td><%= application.branchName %></td>
                <td><%= application.startDateLabel %></td>
                <td>₦<%= application.hourlyRateFormatted %>/hr</td>

                <td>
                  <span class="badge <%= application.applicationStatusBadgeClass %>">
                    <%= application.applicationStatusLabel %>
                  </span>
                </td>

                <td>
                  <span class="badge <%= application.shiftStatusBadgeClass %>">
                    <%= application.shiftStatusLabel %>
                  </span>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="d-flex flex-column flex-center py-10">
          <i class="ki-duotone ki-calendar fs-4x text-gray-300 mb-4">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>

          <span class="text-gray-500 fw-semibold fs-6 mb-4"> No applications submitted yet </span>

          <% if (view.canApplyForShifts) { %>
          <a href="/professional/shifts" class="btn btn-sm btn-primary">
            Browse Available Shifts
          </a>
          <% } else { %>
          <span class="badge badge-light-warning fs-7 fw-bold">
            <%= view.applyShiftLockedMessage %>
          </span>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-xl-4 mb-4">
    <div class="card card-flush h-xl-100">
      <div class="card-header pt-5">
        <h3 class="card-title align-items-start flex-column">
          <span class="card-label fw-bold text-gray-900">Quick Actions</span>
          <span class="text-gray-500 mt-1 fw-semibold fs-6"> Common tasks at a glance </span>
        </h3>
      </div>

      <div class="card-body pt-4">
        <div class="d-flex flex-column gap-3">
          <% if (view.canApplyForShifts) { %>
          <a
            href="/professional/shifts"
            class="d-flex align-items-center bg-light-primary rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-calendar-search fs-2x text-primary me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <div>
              <div class="fw-bold text-gray-900 fs-6">Browse Shifts</div>
              <div class="text-gray-500 fs-7">Find available locum shifts</div>
            </div>
          </a>
          <% } else { %>
          <div class="d-flex align-items-center bg-light rounded p-3 opacity-75">
            <i class="ki-duotone ki-lock fs-2x text-gray-500 me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <div>
              <div class="fw-bold text-gray-700 fs-6">Browse Shifts</div>
              <div class="text-gray-500 fs-7">Locked until profile verification</div>
            </div>
          </div>
          <% } %>

          <a
            href="/professional/applications"
            class="d-flex align-items-center bg-light-warning rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-send fs-2x text-warning me-4">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>

            <div>
              <div class="fw-bold text-gray-900 fs-6">My Applications</div>
              <div class="text-gray-500 fs-7">Track submitted applications</div>
            </div>
          </a>

          <a
            href="/professional/profile"
            class="d-flex align-items-center bg-light-info rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-user fs-2x text-info me-4">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>

            <div>
              <div class="fw-bold text-gray-900 fs-6">Professional Profile</div>
              <div class="text-gray-500 fs-7">Manage your profile and documents</div>
            </div>
          </a>

          <a
            href="/professional/wallet"
            class="d-flex align-items-center bg-light-success rounded p-3 text-decoration-none"
          >
            <i class="ki-duotone ki-wallet fs-2x text-success me-4">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
            </i>

            <div>
              <div class="fw-bold text-gray-900 fs-6">Wallet</div>
              <div class="text-gray-500 fs-7">View earnings and withdrawals</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
