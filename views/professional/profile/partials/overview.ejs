<!-- views/professional/profile/partials/overview.ejs -->

<!-- ───────────────────── PROFESSIONAL HEADER ───────────────────── -->

<div class="card card-flush mb-5 mb-xl-8">
  <div class="card-body p-5 p-lg-8">
    <div
      class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-5"
    >
      <div class="d-flex align-items-start align-items-sm-center gap-4 gap-lg-5 min-w-0">
        <div class="symbol symbol-60px symbol-sm-75px symbol-circle flex-shrink-0">
          <span class="symbol-label bg-light-primary text-primary fw-bold fs-2">
            <%= professionalProfileSummary.initials %>
          </span>
        </div>

        <div class="min-w-0">
          <div class="text-muted fw-semibold fs-7 mb-1">My Professional Profile</div>

          <h2 class="fs-2 fw-bold text-gray-900 mb-2 text-break">
            <%= professionalProfileSummary.professionalName %>
          </h2>

          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="fw-semibold text-gray-700 fs-6">
              <%= professionalProfileSummary.profession %>
            </span>

            <span class="text-gray-400"> &bull; </span>

            <span class="text-gray-500 fs-6"> <%= professionalProfileSummary.specialty %> </span>
          </div>

          <div class="d-flex align-items-center gap-2 text-gray-500 fs-7 mb-3">
            <i class="ki-duotone ki-geolocation fs-5 flex-shrink-0">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>

            <span class="text-break"> <%= professionalProfileSummary.locationLabel %> </span>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge <%= professionalProfileSummary.accountStatusBadgeClass %> fw-bold">
              <%= professionalProfileSummary.accountStatusLabel %>
            </span>

            <span
              class="badge <%= professionalProfileSummary.availabilityStatusBadgeClass %> fw-bold"
            >
              <%= professionalProfileSummary.availabilityStatusLabel %>
            </span>

            <span class="badge badge-light-primary fw-bold">
              <%= professionalProfileSummary.tierLabel %> Tier
            </span>
          </div>
        </div>
      </div>

      <div class="w-100 w-lg-auto flex-shrink-0">
        <a href="<%= overviewView.availabilityUrl %>" class="btn btn-primary w-100">
          <i class="ki-duotone ki-calendar-tick fs-3 me-2">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          Manage Availability
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ───────────────────── PROFESSIONAL STATISTICS ───────────────────── -->

<div class="row g-4 g-xl-8 mb-5 mb-xl-8">
  <% overviewView.stats.forEach(function (stat) { %>

  <div class="col-12 col-sm-6 col-lg-4">
    <div class="card card-flush h-100">
      <div class="card-body p-5 p-lg-6">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-5">
          <span class="fw-semibold text-gray-500 fs-7"> <%= stat.label %> </span>

          <div class="symbol symbol-45px flex-shrink-0">
            <span class="symbol-label <%= stat.backgroundClass %>">
              <i class="ki-duotone <%= stat.icon %> fs-2x <%= stat.colorClass %>">
                <span class="path1"></span>
                <span class="path2"></span>
                <span class="path3"></span>
                <span class="path4"></span>
              </i>
            </span>
          </div>
        </div>

        <div class="d-flex align-items-baseline flex-wrap gap-2">
          <span class="fs-2hx fw-bold text-gray-900 lh-1"> <%= stat.value %> </span>

          <% if (stat.suffix) { %>

          <span class="fw-semibold fs-6 text-gray-500"> <%= stat.suffix %> </span>

          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% }) %>
</div>

<!-- ───────────────────── MAIN OVERVIEW CONTENT ───────────────────── -->

<div class="row g-5 g-xl-8">
  <!-- ───────────────────── VERIFICATION OVERVIEW ───────────────────── -->

  <div class="col-12 col-xl-7">
    <div class="card card-flush h-100">
      <div class="card-header pt-5">
        <div class="card-title flex-column align-items-start">
          <h3 class="fw-bold text-gray-900 fs-5 mb-1">Verification Overview</h3>

          <span class="text-gray-500 fs-7">
            Your professional verification and marketplace status
          </span>
        </div>
      </div>

      <div class="card-body pt-4">
        <!-- Marketplace readiness -->

        <div
          class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-4 border border-dashed rounded p-4 p-lg-5 mb-6 <%= overviewView.readinessNoticeClass %>"
        >
          <div class="d-flex align-items-start gap-3 min-w-0">
            <i
              class="ki-duotone <%= overviewView.readinessIcon %> fs-2x <%= overviewView.readinessIconClass %> flex-shrink-0"
            >
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>

            <div class="min-w-0">
              <div class="fw-bold text-gray-900 fs-6 mb-2"><%= overviewView.readinessLabel %></div>

              <div class="fw-semibold text-gray-600 fs-7"><%= overviewView.readinessMessage %></div>
            </div>
          </div>

          <span class="badge <%= overviewView.readinessBadgeClass %> fw-bold flex-shrink-0">
            <%= overviewView.readinessLabel %>
          </span>
        </div>

        <!-- Individual verification statuses -->

        <div class="d-flex flex-column gap-3">
          <% overviewView.verificationItems.forEach(function (item) { %>

          <div
            class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 border border-gray-300 border-dashed rounded p-4"
          >
            <div class="d-flex align-items-start gap-3 min-w-0">
              <div class="symbol symbol-35px flex-shrink-0">
                <span class="symbol-label bg-light-primary">
                  <i class="ki-duotone ki-shield-tick fs-3 text-primary">
                    <span class="path1"></span>
                    <span class="path2"></span>
                  </i>
                </span>
              </div>

              <div class="min-w-0">
                <div class="fw-bold text-gray-800 fs-6 mb-1"><%= item.title %></div>

                <div class="text-gray-500 fs-7"><%= item.description %></div>
              </div>
            </div>

            <span class="badge <%= item.badgeClass %> fw-bold flex-shrink-0">
              <%= item.statusLabel %>
            </span>
          </div>

          <% }) %>
        </div>

        <div class="separator separator-dashed my-6"></div>

        <a
          href="<%= overviewView.verificationUrl %>"
          class="btn btn-sm btn-light-primary w-100 w-sm-auto"
        >
          <i class="ki-duotone ki-shield-tick fs-4 me-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>

          View Verification Details
        </a>
      </div>
    </div>
  </div>

  <!-- ───────────────────── PROFESSIONAL SUMMARY ───────────────────── -->

  <div class="col-12 col-xl-5">
    <div class="d-flex flex-column gap-5 gap-xl-8 h-100">
      <!-- Professional snapshot -->

      <div class="card card-flush">
        <div class="card-header pt-5">
          <div class="card-title flex-column align-items-start">
            <h3 class="fw-bold text-gray-900 fs-5 mb-1">Professional Snapshot</h3>

            <span class="text-gray-500 fs-7"> A quick look at your professional information </span>
          </div>
        </div>

        <div class="card-body pt-4">
          <div class="d-flex flex-column gap-5">
            <div class="d-flex flex-wrap justify-content-between gap-2">
              <span class="fw-semibold text-gray-500"> Profession </span>

              <span class="fw-bold text-gray-800 text-end text-break">
                <%= professionalProfileSummary.profession %>
              </span>
            </div>

            <div class="d-flex flex-wrap justify-content-between gap-2">
              <span class="fw-semibold text-gray-500"> Specialty </span>

              <span class="fw-bold text-gray-800 text-end text-break">
                <%= professionalProfileSummary.specialty %>
              </span>
            </div>

            <div class="d-flex flex-wrap justify-content-between gap-2">
              <span class="fw-semibold text-gray-500"> Location </span>

              <span class="fw-bold text-gray-800 text-end text-break">
                <%= professionalProfileSummary.locationLabel %>
              </span>
            </div>

            <div class="d-flex flex-wrap justify-content-between gap-2">
              <span class="fw-semibold text-gray-500"> Professional Tier </span>

              <span class="badge badge-light-primary fw-bold">
                <%= professionalProfileSummary.tierLabel %>
              </span>
            </div>
          </div>

          <div class="separator separator-dashed my-6"></div>

          <a
            href="<%= overviewView.professionalDetailsUrl %>"
            class="btn btn-sm btn-light-primary w-100"
          >
            View Professional Details
          </a>
        </div>
      </div>

      <!-- ───────────────────── QUICK ACTIONS ───────────────────── -->

      <div class="card card-flush flex-grow-1">
        <div class="card-header pt-5">
          <div class="card-title flex-column align-items-start">
            <h3 class="fw-bold text-gray-900 fs-5 mb-1">Quick Actions</h3>

            <span class="text-gray-500 fs-7"> Manage the essentials in a few clicks </span>
          </div>
        </div>

        <div class="card-body pt-4">
          <div class="d-flex flex-column gap-3">
            <!-- Professional details -->

            <a
              href="<%= overviewView.professionalDetailsUrl %>"
              class="d-flex align-items-center gap-4 bg-light-primary rounded p-4 text-decoration-none"
            >
              <i class="ki-duotone ki-award fs-2x text-primary flex-shrink-0">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>

              <div class="flex-grow-1 min-w-0">
                <div class="fw-bold text-gray-800 fs-6">Professional Details</div>

                <div class="text-gray-500 fs-7">View your credentials and experience</div>
              </div>

              <i class="ki-duotone ki-right fs-3 text-primary flex-shrink-0">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </a>

            <!-- Availability -->

            <a
              href="<%= overviewView.availabilityUrl %>"
              class="d-flex align-items-center gap-4 bg-light-success rounded p-4 text-decoration-none"
            >
              <i class="ki-duotone ki-calendar-tick fs-2x text-success flex-shrink-0">
                <span class="path1"></span>
                <span class="path2"></span>
                <span class="path3"></span>
              </i>

              <div class="flex-grow-1 min-w-0">
                <div class="fw-bold text-gray-800 fs-6">Update Availability</div>

                <div class="text-gray-500 fs-7">Choose weekly days or specific dates</div>
              </div>

              <i class="ki-duotone ki-right fs-3 text-success flex-shrink-0">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </a>

            <!-- Verification -->

            <a
              href="<%= overviewView.verificationUrl %>"
              class="d-flex align-items-center gap-4 bg-light-info rounded p-4 text-decoration-none"
            >
              <i class="ki-duotone ki-shield-tick fs-2x text-info flex-shrink-0">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>

              <div class="flex-grow-1 min-w-0">
                <div class="fw-bold text-gray-800 fs-6">My Verification</div>

                <div class="text-gray-500 fs-7">View verification and approval status</div>
              </div>

              <i class="ki-duotone ki-right fs-3 text-info flex-shrink-0">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
