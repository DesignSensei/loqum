<!-- views/professional/profile/partials/side-menu.ejs -->

<div class="card mb-5 mb-xl-8">
  <div class="card-body pt-7 pt-xl-12 px-4 px-xl-7">

    <!-- ───────────────────── PROFESSIONAL IDENTITY ───────────────────── -->

    <div
      class="d-flex flex-row flex-xl-column align-items-center
             justify-content-start justify-content-xl-center
             text-start text-xl-center gap-4 gap-xl-0 mb-6 mb-xl-8"
    >
      <div class="symbol symbol-75px symbol-circle flex-shrink-0 mb-xl-6">
        <span class="symbol-label bg-light-primary text-primary fw-bold fs-1">
          <%= professionalProfileSummary.initials %>
        </span>
      </div>

      <div class="flex-grow-1 min-w-0">
        <a
          href="/professional/profile?tab=overview"
          class="fs-4 fs-xl-3 text-gray-800 text-hover-primary
                 fw-bold mb-1 d-block text-break"
        >
          <%= professionalProfileSummary.professionalName %>
        </a>

        <div class="fs-6 fw-semibold text-gray-600 mb-1">
          <%= professionalProfileSummary.profession %>
        </div>

        <div class="fs-7 text-muted mb-3">
          <%= professionalProfileSummary.specialty %>
        </div>

        <div
          class="d-flex flex-wrap justify-content-start
                 justify-content-xl-center align-items-center gap-2"
        >
          <span
            class="badge <%= professionalProfileSummary.accountStatusBadgeClass %> fw-bold"
          >
            <%= professionalProfileSummary.accountStatusLabel %>
          </span>

          <span
            class="badge <%= professionalProfileSummary.availabilityStatusBadgeClass %> fw-bold"
          >
            <%= professionalProfileSummary.availabilityStatusLabel %>
          </span>
        </div>
      </div>
    </div>

    <!-- ───────────────────── PROFESSIONAL SUMMARY ───────────────────── -->

    <div class="d-none d-xl-flex flex-wrap flex-center mb-6">
      <div
        class="border border-gray-300 border-dashed rounded
               py-3 px-4 mx-2 mb-3"
      >
        <div class="fs-4 fw-bold text-gray-800 text-center">
          <%= professionalProfileSummary.totalShiftsCompleted %>
        </div>

        <div class="fw-semibold text-muted text-center fs-7">
          Completed Shifts
        </div>
      </div>

      <div
        class="border border-gray-300 border-dashed rounded
               py-3 px-4 mx-2 mb-3"
      >
        <div class="fs-4 fw-bold text-gray-800 text-center">
          <%= professionalProfileSummary.yearsOfExperience %>
        </div>

        <div class="fw-semibold text-muted text-center fs-7">
          Years' Experience
        </div>
      </div>
    </div>

    <div class="d-none d-xl-flex align-items-center justify-content-center gap-2 mb-6">
      <i class="ki-duotone ki-award fs-2 text-primary">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      <span class="fw-semibold text-gray-600 fs-7">
        <%= professionalProfileSummary.tierLabel %> Professional
      </span>
    </div>

    <div class="separator separator-dashed my-5"></div>

    <!-- ───────────────────── PROFILE NAVIGATION ───────────────────── -->

    <nav
      class="menu menu-rounded fw-semibold fs-6
             d-flex flex-row flex-xl-column flex-nowrap
             gap-2 overflow-auto pb-2 pb-xl-0"
      aria-label="Professional profile navigation"
    >
      <% profileNavigation.forEach(function (item) { %>

      <div class="menu-item flex-shrink-0">
        <a
          href="<%= item.href %>"
          class="menu-link px-4 py-3 <%= item.active ? 'active bg-light-primary' : '' %>"
          <% if (item.active) { %>aria-current="page"<% } %>
        >
          <span class="menu-icon">
            <i class="ki-duotone <%= item.icon %> fs-2">
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
              <span class="path4"></span>
              <span class="path5"></span>
            </i>
          </span>

          <span class="menu-title text-nowrap">
            <%= item.label %>
          </span>
        </a>
      </div>

      <% }) %>

      <!-- Account closure uses the shared account settings page. -->

      <div class="menu-item flex-shrink-0">
        <a
          href="/account/settings#accountClosure"
          class="menu-link px-4 py-3"
        >
          <span class="menu-icon">
            <i class="ki-outline ki-exit-right fs-2 text-danger"></i>
          </span>

          <span class="menu-title text-nowrap text-danger">
            Account Closure
          </span>
        </a>
      </div>
    </nav>

    <!-- ───────────────────── FOOTER ───────────────────── -->

    <div class="d-none d-xl-block">
      <div class="separator separator-dashed my-6"></div>

      <div class="d-flex align-items-start gap-3 px-2">
        <i class="ki-duotone ki-shield-tick fs-2 text-primary">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>

        <div class="text-muted fs-7">
          Identity evidence, professional licence verification
          and marketplace approval are reviewed separately.
        </div>
      </div>
    </div>

  </div>
</div>