<!-- views/professional/profile/partials/verification.ejs -->

<!-- ───────────────────── VERIFICATION STATUS ───────────────────── -->

<div class="card mb-5 mb-xl-8">
  <div class="card-header">
    <div class="card-title">
      <div class="d-flex align-items-center gap-3">
        <div class="symbol symbol-45px flex-shrink-0">
          <span class="symbol-label bg-light-primary">
            <i class="ki-duotone ki-shield-tick fs-2x text-primary">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>
          </span>
        </div>

        <div class="min-w-0">
          <h3 class="fw-bold text-gray-900 fs-5 mb-1">Professional Verification</h3>
          <div class="fs-7 text-muted">
            Your professional credentials, approval and marketplace status
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-body p-5 p-lg-8">
    <div
      class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-4 border border-dashed rounded p-4 p-lg-5 <%= verificationView.readinessNoticeClass %>"
      role="status"
    >
      <div class="d-flex align-items-start gap-4 min-w-0">
        <div class="symbol symbol-45px flex-shrink-0">
          <span class="symbol-label bg-light">
            <i
              class="ki-duotone <%= verificationView.readinessIcon %> fs-2x <%= verificationView.readinessIconClass %>"
            >
              <span class="path1"></span>
              <span class="path2"></span>
              <span class="path3"></span>
            </i>
          </span>
        </div>

        <div class="min-w-0">
          <div class="fw-bold text-gray-900 fs-5 mb-2"><%= verificationView.readinessLabel %></div>

          <div class="fw-semibold text-gray-600 fs-7"><%= verificationView.readinessMessage %></div>
        </div>
      </div>

      <span
        class="badge <%= verificationView.readinessBadgeClass %> fw-bold flex-shrink-0 px-4 py-3"
      >
        <%= verificationView.readinessLabel %>
      </span>
    </div>
  </div>
</div>

<!-- ───────────────────── VERIFICATION CARDS ───────────────────── -->

<div class="row g-5 g-xl-8 mb-5 mb-xl-8">
  <% verificationView.items.forEach(function (item) { %>

  <div class="col-12 col-lg-6">
    <div class="card card-flush h-100">
      <div class="card-body p-5 p-lg-7">
        <div
          class="d-flex flex-column flex-sm-row align-items-start justify-content-between gap-3 mb-5"
        >
          <div class="d-flex align-items-start gap-3 min-w-0">
            <div class="symbol symbol-45px flex-shrink-0">
              <span class="symbol-label bg-light-primary">
                <i class="ki-duotone ki-shield-tick fs-2x text-primary">
                  <span class="path1"></span>
                  <span class="path2"></span>
                </i>
              </span>
            </div>

            <div class="min-w-0">
              <h3 class="fw-bold text-gray-900 fs-6 mb-2"><%= item.title %></h3>

              <div class="text-gray-500 fs-7"><%= item.description %></div>
            </div>
          </div>

          <span class="badge <%= item.badgeClass %> fw-bold flex-shrink-0">
            <%= item.statusLabel %>
          </span>
        </div>

        <% if (item.details && item.details.length > 0) { %>

        <div class="separator separator-dashed my-5"></div>

        <div class="d-flex flex-column gap-4">
          <% item.details.forEach(function (detail) { %>

          <div
            class="d-flex flex-column flex-sm-row align-items-start justify-content-between gap-2"
          >
            <span class="fw-semibold text-gray-500 fs-7"> <%= detail.label %> </span>

            <div class="d-flex align-items-start align-items-sm-center gap-2 min-w-0">
              <span class="fw-bold text-gray-800 fs-7 text-break text-sm-end">
                <%= detail.value %>
              </span>

              <% if (detail.locked) { %>

              <i
                class="ki-duotone ki-lock fs-5 text-gray-500 flex-shrink-0"
                title="Protected information"
                aria-label="Protected information"
              >
                <span class="path1"></span>
                <span class="path2"></span>
                <span class="path3"></span>
              </i>

              <% } %>
            </div>
          </div>

          <% }) %>
        </div>

        <% } %> <% if (item.dateLabel) { %>

        <div class="separator separator-dashed my-5"></div>

        <div class="d-flex flex-wrap align-items-center gap-2">
          <i class="ki-duotone ki-calendar-tick fs-5 text-gray-500">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>

          <span class="fw-semibold text-gray-500 fs-7"> Recorded on: </span>

          <span class="fw-bold text-gray-700 fs-7"> <%= item.dateLabel %> </span>
        </div>

        <% } %>
      </div>
    </div>
  </div>

  <% }) %>
</div>

<!-- ───────────────────── LICENCE MANAGEMENT ───────────────────── -->

<div class="card mb-5 mb-xl-8">
  <div class="card-header">
    <div class="card-title">
      <div class="d-flex align-items-center gap-3">
        <div class="symbol symbol-45px flex-shrink-0">
          <span class="symbol-label bg-light-primary">
            <i class="ki-duotone ki-document fs-2x text-primary">
              <span class="path1"></span>
              <span class="path2"></span>
            </i>
          </span>
        </div>

        <div class="min-w-0">
          <h3 class="fw-bold text-gray-900 fs-5 mb-1">Practising Licence</h3>

          <div class="fs-7 text-muted">
            Submit your licence or renewal for administrative review
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-body p-5 p-lg-8">
    <!-- ───────────────────── CURRENT LICENCE STATUS ───────────────────── -->

    <div class="d-flex flex-wrap align-items-center gap-3 mb-5">
      <span class="fw-semibold text-gray-600 fs-7"> Current licence: </span>

      <span class="badge <%= verificationView.licence.statusBadgeClass %> fw-bold">
        <%= verificationView.licence.statusLabel %>
      </span>

      <% if (verificationView.licence.current && verificationView.licence.expiryLabel) { %>
      <span class="text-gray-600 fs-7">
        <% if (verificationView.licence.expiryLabel === "Lifetime") { %> Lifetime validity <% } else
        { %> Valid until <%= verificationView.licence.expiryLabel %> <% } %>
      </span>
      <% } %>
    </div>

    <!-- ───────────────────── PENDING SUBMISSION ───────────────────── -->

    <% if (verificationView.licence.hasPendingSubmission) { %>

    <div
      class="notice d-flex align-items-start bg-light-info border border-info border-dashed rounded p-4 mb-5"
    >
      <i class="ki-duotone ki-time fs-2 text-info me-3 flex-shrink-0">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      <div class="min-w-0">
        <div class="fw-bold text-gray-900 fs-7 mb-1">Licence submission awaiting review</div>

        <div class="fw-semibold text-gray-600 fs-7">
          Submitted: <%= verificationView.licence.pendingDateLabel || 'Recently' %>. <% if
          (verificationView.licence.current) { %> Your existing approved licence remains current
          until its expiry. <% } else { %> Submission does not authorise you to take on new work. <%
          } %>
        </div>
      </div>
    </div>

    <% } %>

    <!-- ───────────────────── UPCOMING APPROVED RENEWAL ───────────────────── -->

    <% if (verificationView.licence.hasApprovedUpcoming && verificationView.licence.upcoming) { %>

    <div
      class="notice d-flex align-items-start bg-light-success border border-success border-dashed rounded p-4 mb-5"
    >
      <i class="ki-duotone ki-calendar-tick fs-2 text-success me-3 flex-shrink-0">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      <div class="min-w-0">
        <div class="fw-bold text-gray-900 fs-7 mb-1">Approved renewal scheduled</div>

        <div class="fw-semibold text-gray-600 fs-7">
          Effective from <%= verificationView.licence.upcoming.startsOnLabel %>. The renewal does
          not authorise work before its effective date.
        </div>
      </div>
    </div>

    <% } %>

    <!-- ───────────────────── LICENCE UPLOAD FEEDBACK ───────────────────── -->

    <div
      id="professionalLicenceUploadFeedback"
      class="alert mb-5 d-none"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <!-- ───────────────────── LICENCE UPLOAD FORM ───────────────────── -->

    <% if (verificationView.licence.canSubmitDocument && verificationView.licence.uploadAction) { %>

    <form
      id="professionalLicenceUploadForm"
      action="<%= verificationView.licence.uploadAction %>"
      method="POST"
      enctype="multipart/form-data"
      data-max-bytes="<%= verificationView.licence.uploadMaxBytes %>"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="mb-5">
        <label for="professionalLicenceDocument" class="form-label fw-bold text-gray-900 fs-6 mb-3">
          Choose licence document
        </label>

        <input
          id="professionalLicenceDocument"
          type="file"
          class="form-control form-control-solid"
          name="<%= verificationView.licence.uploadFieldName %>"
          accept="<%= verificationView.licence.uploadAccept %>"
          aria-describedby="professionalLicenceUploadHelp"
          required
        />

        <div id="professionalLicenceUploadHelp" class="text-muted fw-semibold fs-7 mt-3">
          <%= verificationView.licence.uploadHelpMessage %>
        </div>
      </div>

      <button type="submit" id="professionalLicenceUploadButton" class="btn btn-primary">
        <span id="professionalLicenceUploadButtonLabel">
          <%= verificationView.licence.uploadButtonLabel %>
        </span>
      </button>
    </form>

    <% } else { %>

    <div class="text-gray-600 fw-semibold fs-7">
      <%= verificationView.licence.uploadHelpMessage %>
    </div>

    <% } %>
  </div>
</div>

<!-- ───────────────────── LICENCE VALIDITY AND RENEWAL ───────────────────── -->

<div class="card mb-5 mb-xl-8">
  <div class="card-body p-5 p-lg-7">
    <div class="d-flex align-items-start gap-4">
      <div class="symbol symbol-45px flex-shrink-0">
        <span class="symbol-label bg-light-primary">
          <i class="ki-duotone ki-information-5 fs-2x text-primary">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
          </i>
        </span>
      </div>

      <div class="flex-grow-1 min-w-0">
        <div class="fw-bold text-gray-900 fs-6 mb-2">Licence Validity and Renewal</div>

        <div class="fw-semibold text-gray-600 fs-7">
          <%= verificationView.licenceExpiryMessage %>
        </div>

        <% if (verificationView.licence.expired && verificationView.licence.withinGrace) { %>

        <div class="fw-bold text-danger fs-7 mt-3">
          The renewal grace period does not permit work with an expired licence.
        </div>

        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- ───────────────────── PROTECTED DETAILS ───────────────────── -->

<div class="card mb-5 mb-xl-8">
  <div class="card-body p-5 p-lg-7">
    <div class="d-flex align-items-start gap-4">
      <div
        class="notice d-flex align-items-start bg-light-info border border-info border-dashed rounded p-4 p-lg-5"
      >
        <i class="ki-duotone ki-lock fs-2x text-info me-4 flex-shrink-0">
          <span class="path1"></span>
          <span class="path2"></span>
          <span class="path3"></span>
        </i>

        <div class="flex-grow-1 min-w-0">
          <div class="fw-bold text-gray-900 fs-6 mb-2">Protected Identity and Licence Details</div>

          <div class="fw-semibold text-gray-600 fs-7"><%= verificationView.supportMessage %></div>
        </div>
      </div>
    </div>
  </div>
</div>
