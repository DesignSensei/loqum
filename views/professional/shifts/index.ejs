<!-- views/professional/shifts/index.ejs -->

<!-- ───────────────────── SEARCH FILTERS ───────────────────── -->

<div class="card card-flush mb-6 mb-xl-8">
  <div class="card-header">
    <div class="card-title">
      <i class="ki-duotone ki-filter fs-2 text-primary me-2">
        <span class="path1"></span>
        <span class="path2"></span>
      </i>

      <h2 class="fw-bold text-gray-900 fs-5 mb-0">Find Opportunities</h2>
    </div>
  </div>

  <div class="card-body pt-3">
    <form
      id="professionalShiftFiltersForm"
      action="<%= shiftsView.actions.shiftsUrl %>"
      method="GET"
    >
      <!-- Preserve existing advanced filters until their
           display controls are supported by the view model. -->

      <% if (shiftsView.filters.sortBy) { %>
      <input type="hidden" name="sortBy" value="<%= shiftsView.filters.sortBy %>" />
      <% } %> <% if (shiftsView.filters.minHourlyRateMinor !== undefined &&
      shiftsView.filters.minHourlyRateMinor !== null && shiftsView.filters.minHourlyRateMinor !==
      "") { %>
      <input
        type="hidden"
        name="minHourlyRateMinor"
        value="<%= shiftsView.filters.minHourlyRateMinor %>"
      />
      <% } %> <% if (shiftsView.filters.maxHourlyRateMinor !== undefined &&
      shiftsView.filters.maxHourlyRateMinor !== null && shiftsView.filters.maxHourlyRateMinor !==
      "") { %>
      <input
        type="hidden"
        name="maxHourlyRateMinor"
        value="<%= shiftsView.filters.maxHourlyRateMinor %>"
      />
      <% } %>

      <div class="row g-4">
        <!-- State -->

        <div class="col-12 col-md-6 col-xl-3">
          <label for="professionalShiftState" class="form-label fw-semibold text-gray-700">
            State
          </label>

          <input
            type="text"
            id="professionalShiftState"
            name="state"
            class="form-control form-control-solid"
            value="<%= shiftsView.filters.state || '' %>"
            placeholder="Enter state"
            autocomplete="address-level1"
          />
        </div>

        <!-- LGA -->

        <div class="col-12 col-md-6 col-xl-3">
          <label for="professionalShiftLga" class="form-label fw-semibold text-gray-700">
            Local Government Area
          </label>

          <input
            type="text"
            id="professionalShiftLga"
            name="lga"
            class="form-control form-control-solid"
            value="<%= shiftsView.filters.lga || '' %>"
            placeholder="Enter LGA"
            autocomplete="address-level2"
          />
        </div>

        <!-- Start date -->

        <div class="col-12 col-md-6 col-xl-3">
          <label for="professionalShiftDateFrom" class="form-label fw-semibold text-gray-700">
            From Date
          </label>

          <input
            type="date"
            id="professionalShiftDateFrom"
            name="dateFrom"
            class="form-control form-control-solid"
            value="<%= shiftsView.filters.dateFrom || '' %>"
          />
        </div>

        <!-- End date -->

        <div class="col-12 col-md-6 col-xl-3">
          <label for="professionalShiftDateTo" class="form-label fw-semibold text-gray-700">
            To Date
          </label>

          <input
            type="date"
            id="professionalShiftDateTo"
            name="dateTo"
            class="form-control form-control-solid"
            value="<%= shiftsView.filters.dateTo || '' %>"
          />
        </div>

        <!-- Distance filter -->

        <% if (shiftsView.distanceAvailable) { %>

        <div class="col-12 col-md-6 col-xl-3">
          <label for="professionalShiftMaxDistance" class="form-label fw-semibold text-gray-700">
            Maximum Distance (km)
          </label>

          <input
            type="number"
            id="professionalShiftMaxDistance"
            name="maxDistanceKm"
            class="form-control form-control-solid"
            value="<%= shiftsView.filters.maxDistanceKm ?? '' %>"
            min="0"
            step="1"
            placeholder="Any distance"
          />
        </div>

        <% } %>
      </div>

      <!-- Filter actions -->

      <div
        class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-end gap-3 mt-6"
      >
        <a href="<%= shiftsView.actions.shiftsUrl %>" class="btn btn-light w-100 w-sm-auto">
          Clear Filters
        </a>

        <button
          type="submit"
          id="professionalShiftFilterSubmit"
          class="btn btn-primary w-100 w-sm-auto"
        >
          <i class="ki-duotone ki-magnifier fs-3 me-1">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>

          Search Shifts
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ───────────────────── SEARCH RESULTS ───────────────────── -->

<div
  class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-5"
>
  <div>
    <h2 class="fw-bold text-gray-900 fs-4 mb-1">Available Opportunities</h2>

    <% if (shiftsView.pagination) { %>

    <div class="text-gray-500 fw-semibold fs-7">
      Showing <%= shiftsView.pagination.startItem %>–<%= shiftsView.pagination.endItem %> of <%=
      shiftsView.pagination.totalItems %> results
    </div>

    <% } %>
  </div>

  <span class="badge badge-light-primary fw-semibold"> Locum Shifts </span>
</div>

<!-- ───────────────────── SHIFT CARDS ───────────────────── -->

<% if (shiftsView.hasShifts) { %>

<div class="row g-5 g-xl-8">
  <% shiftsView.shifts.forEach(function (shift) { %>

  <div class="col-12 col-xl-6">
    <div class="card card-flush h-100">
      <div class="card-body p-5 p-lg-7">
        <!-- Shift heading -->

        <div
          class="d-flex flex-column flex-sm-row align-items-start justify-content-between gap-3 mb-5"
        >
          <div class="d-flex align-items-start gap-3 min-w-0">
            <div class="symbol symbol-45px flex-shrink-0">
              <span class="symbol-label bg-light-primary">
                <i class="ki-duotone ki-briefcase fs-2x text-primary">
                  <span class="path1"></span>
                  <span class="path2"></span>
                  <span class="path3"></span>
                </i>
              </span>
            </div>

            <div class="min-w-0">
              <a
                href="<%= shift.detailsUrl %>"
                class="fw-bold text-gray-900 text-hover-primary fs-5 d-block text-break mb-2"
              >
                <%= shift.roleTitle || shift.professionalTypeLabel %>
              </a>

              <div class="fw-semibold text-gray-500 fs-7"><%= shift.professionalTypeLabel %></div>

              <% if (shift.department) { %>

              <div class="text-gray-500 fs-7 mt-1"><%= shift.department %></div>

              <% } %>
            </div>
          </div>

          <% if (shift.statusView) { %>

          <span class="badge <%= shift.statusView.badgeClass %> fw-bold flex-shrink-0">
            <%= shift.statusView.label %>
          </span>

          <% } %>
        </div>

        <!-- Employer branch -->

        <% if (shift.branch) { %>

        <div class="d-flex align-items-start gap-3 mb-4">
          <i class="ki-duotone ki-geolocation fs-2 text-primary flex-shrink-0">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>

          <div class="min-w-0">
            <div class="fw-bold text-gray-800 fs-6 mb-1"><%= shift.branch.name %></div>

            <% if (shift.branch.locationLabel) { %>

            <div class="text-gray-500 fs-7 text-break"><%= shift.branch.locationLabel %></div>

            <% } %>
          </div>
        </div>

        <% } %>

        <!-- Shift schedule -->

        <div class="d-flex align-items-start gap-3 mb-4">
          <i class="ki-duotone ki-calendar-8 fs-2 text-primary flex-shrink-0">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>

          <div class="min-w-0">
            <div class="fw-semibold text-gray-500 fs-7 mb-1">Shift Schedule</div>

            <div class="fw-bold text-gray-800 fs-7"><%= shift.startTimeDisplay %></div>

            <div class="text-gray-500 fs-7">to <%= shift.endTimeDisplay %></div>
          </div>
        </div>

        <!-- Location distance -->

        <% if (shift.distanceKm !== null) { %>

        <div class="d-flex align-items-center gap-3 mb-4">
          <i class="ki-duotone ki-route fs-2 text-primary flex-shrink-0">
            <span class="path1"></span>
            <span class="path2"></span>
          </i>

          <span class="text-gray-600 fw-semibold fs-7"> <%= shift.distanceDisplay %> </span>
        </div>

        <% } %>

        <!-- Description -->

        <% if (shift.description) { %>

        <div
          class="text-gray-600 fs-7 mb-5"
          style="
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
          "
        >
          <%= shift.description %>
        </div>

        <% } %>

        <div class="separator separator-dashed my-5"></div>

        <!-- Pay and actions -->

        <div
          class="d-flex flex-column flex-sm-row align-items-start align-items-sm-end justify-content-between gap-4"
        >
          <div>
            <div class="text-gray-500 fw-semibold fs-7 mb-1">Hourly Rate</div>

            <div class="d-flex align-items-baseline gap-2">
              <span class="fs-3 fw-bold text-gray-900"> <%= shift.hourlyRateDisplay %> </span>

              <span class="text-muted fs-7"> / hour </span>
            </div>
          </div>

          <div
            class="d-flex flex-column align-items-stretch align-items-sm-end gap-2 w-100 w-sm-auto"
          >
            <% if (shift.hasApplications) { %>

            <span class="badge badge-light-info fw-semibold align-self-start align-self-sm-end">
              Application on Record
            </span>

            <% } %>

            <a href="<%= shift.detailsUrl %>" class="btn btn-primary w-100 w-sm-auto">
              View Shift Details

              <i class="ki-duotone ki-arrow-right fs-3 ms-2">
                <span class="path1"></span>
                <span class="path2"></span>
              </i>
            </a>
          </div>
        </div>
      </div>

      <!-- Shift reference -->

      <% if (shift.referenceCode) { %>

      <div class="card-footer border-0 pt-0">
        <div class="text-gray-400 fw-semibold fs-8">Reference: <%= shift.referenceCode %></div>
      </div>

      <% } %>
    </div>
  </div>

  <% }) %>
</div>

<% } else { %>

<!-- ───────────────────── EMPTY RESULTS ───────────────────── -->

<div class="card card-flush">
  <div class="card-body d-flex flex-column align-items-center text-center py-15 px-5">
    <div class="symbol symbol-90px mb-6">
      <span class="symbol-label bg-light-primary">
        <i class="ki-duotone ki-magnifier fs-4x text-primary">
          <span class="path1"></span>
          <span class="path2"></span>
        </i>
      </span>
    </div>

    <h3 class="fw-bold text-gray-900 fs-4 mb-3">No Shifts Found</h3>

    <p class="text-gray-500 fw-semibold fs-6 mb-6"><%= shiftsView.emptyState.message %></p>

    <a href="<%= shiftsView.actions.shiftsUrl %>" class="btn btn-light-primary"> Clear Filters </a>
  </div>
</div>

<% } %>

<!-- ───────────────────── PAGINATION ───────────────────── -->

<% if (shiftsView.pagination && shiftsView.pagination.hasPagination) { %>

<div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 mt-7">
  <div class="text-gray-500 fw-semibold fs-7">
    Page <%= shiftsView.pagination.currentPage %> of <%= shiftsView.pagination.totalPages %>
  </div>

  <nav aria-label="Shift search results pages">
    <ul
      class="pagination pagination-circle pagination-outline mb-0 flex-wrap justify-content-center"
    >
      <!-- Previous -->

      <li class="page-item previous <%= shiftsView.pagination.hasPreviousPage ? '' : 'disabled' %>">
        <% if (shiftsView.pagination.hasPreviousPage) { %>

        <a
          class="page-link"
          href="<%= shiftsView.pagination.previousPageUrl %>"
          aria-label="Previous page"
        >
          <i class="previous"></i>
        </a>

        <% } else { %>

        <span class="page-link" aria-disabled="true">
          <i class="previous"></i>
        </span>

        <% } %>
      </li>

      <!-- Page numbers -->

      <% shiftsView.pagination.pages.forEach(function (page) { %>

      <li class="page-item <%= page.isActive ? 'active' : '' %>">
        <% if (page.isActive) { %>

        <span class="page-link" aria-current="page"> <%= page.page %> </span>

        <% } else { %>

        <a class="page-link" href="<%= page.url %>"> <%= page.page %> </a>

        <% } %>
      </li>

      <% }) %>

      <!-- Next -->

      <li class="page-item next <%= shiftsView.pagination.hasNextPage ? '' : 'disabled' %>">
        <% if (shiftsView.pagination.hasNextPage) { %>

        <a class="page-link" href="<%= shiftsView.pagination.nextPageUrl %>" aria-label="Next page">
          <i class="next"></i>
        </a>

        <% } else { %>

        <span class="page-link" aria-disabled="true">
          <i class="next"></i>
        </span>

        <% } %>
      </li>
    </ul>
  </nav>
</div>

<% } %>
